+  {"id":"12-18m-mencuci-tangan","title":"Mencuci Tangan Bersama","summary":"Anak mengikuti urutan sederhana mencuci tangan sebelum dan sesudah kegiatan.","ageBands":["12-18m"],"areas":["self-care","practical-life"],"skills":["rutinitas", "menggosok", "kebersihan"],"objectives":["Mengenalkan urutan mencuci tangan", "Membangun kebiasaan perawatan diri"],"materials":[{"name":"bangku stabil dan wastafel", "fromHome":true, "optional":false},{"name":"sabun cair lembut", "fromHome":true, "optional":false},{"name":"handuk kecil", "fromHome":true, "optional":false}],"prepMinutes":3,"durationMinutes":7,"prepLevel":"tinggi","presentation":[{"step":1,"text":"Bantu anak mencapai air dengan aman."},{"step":2,"text":"Tunjukkan membasahi, memakai sabun, dan menggosok."},{"step":3,"text":"Bilas lalu keringkan tangan bersama."}],"controlOfError":"Tangan terasa bersih dan kering setelah urutan selesai.","variations":["Gunakan lagu pendek sebagai pengingat urutan."],"readySigns":["Anak mengulurkan tangan saat rutinitas dimulai."],"struggleSigns":["Anak takut air atau sabun."],"safetyNotes":["Dampingi di bangku stabil dan pastikan air hangat tidak panas."],"references":[{"title":"WHO Hand Hygiene","url":"https://www.who.int/teams/integrated-health-services/infection-prevention-control/hand-hygiene"}]},
