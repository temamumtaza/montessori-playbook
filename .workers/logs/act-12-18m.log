    32	  {"id":"12-18m-membuka-kotak-flap","title":"Membuka Kotak Berpenutup","summary":"Anak membuka penutup kotak sederhana untuk menemukan benda yang terlihat sebagian.","ageBands":["12-18m"],"areas":["sensory","practical-life"],"skills":["membuka", "pemecahan masalah", "keingintahuan"],"objectives":["Melatih menarik dan mengangkat penutup", "Mendukung pemecahan masalah awal"],"materials":[{"name":"kotak kokoh dengan penutup engsel besar", "fromHome":true, "optional":false},{"name":"bola kain besar", "fromHome":true, "optional":false}],"prepMinutes":3,"durationMinutes":9,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan bola terlihat sebagian dari kotak."},{"step":2,"text":"Angkat penutup perlahan untuk membukanya."},{"step":3,"text":"Tutup kembali dan beri giliran anak."}],"controlOfError":"Penutup terbuka dan benda terlihat saat berhasil.","variations":["Mulai dengan penutup yang hanya menutupi sebagian kotak."],"readySigns":["Anak mencoba menarik atau mengangkat penutup."],"struggleSigns":["Anak membanting penutup atau frustrasi."],"safetyNotes":["Gunakan kotak tanpa jepitan, engsel tajam, atau penutup yang dapat menjepit jari."],"references":[{"title":"HealthyChildren.org","url":"https://www.healthychildren.org/English/ages-stages/toddler/Pages/default.aspx"}]},
    33	  {"id":"12-18m-memilih-camilan","title":"Memilih Buah untuk Camilan","summary":"Anak memilih satu dari dua potongan buah sesuai rutinitas makan yang aman.","ageBands":["12-18m"],"areas":["self-care","language"],"skills":["memilih", "komunikasi", "rutinitas makan"],"objectives":["Mendorong anak menyampaikan pilihan", "Mengenalkan nama makanan"],"materials":[{"name":"dua pilihan buah lunak sesuai kebiasaan anak", "fromHome":true, "optional":false},{"name":"piring kecil", "fromHome":true, "optional":false}],"prepMinutes":5,"durationMinutes":8,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan dua pilihan di piring terpisah."},{"step":2,"text":"Sebut nama masing-masing dengan jelas."},{"step":3,"text":"Tunggu anak menunjuk atau mengambil pilihan."}],"controlOfError":"Pilihan anak tampak dari buah yang disentuh atau dipilih.","variations":["Tawarkan pilihan sebelum duduk makan bersama."],"readySigns":["Anak menunjuk, meraih, atau menolak dengan jelas."],"struggleSigns":["Anak belum dapat mengunyah tekstur yang ditawarkan."],"safetyNotes":["Potong sesuai ukuran aman, dudukkan anak tegak, dan awasi setiap suapan."],"references":[{"title":"NHS Start for Life","url":"https://www.nhs.uk/start-for-life/baby/weaning/"}]},
    34	  {"id":"12-18m-menyeka-wajah","title":"Menyeka Wajah Setelah Makan","summary":"Anak berlatih memegang kain dan menyeka mulut dengan bantuan orang dewasa.","ageBands":["12-18m"],"areas":["self-care","practical-life"],"skills":["menyeka", "kesadaran diri", "kemandirian"],"objectives":["Mengenalkan perawatan diri setelah makan", "Melatih gerakan terarah ke mulut"],"materials":[{"name":"kain lembut kecil", "fromHome":true, "optional":false}],"prepMinutes":1,"durationMinutes":4,"prepLevel":"rendah","presentation":[{"step":1,"text":"Berikan kain setelah kegiatan makan."},{"step":2,"text":"Tunjukkan menyeka sudut mulut perlahan."},{"step":3,"text":"Bantu tangan anak bila diperlukan."}],"controlOfError":"Sisa makanan terlihat berkurang setelah diseka.","variations":["Letakkan kain di tempat tetap agar mudah diambil."],"readySigns":["Anak mencoba meniru gerakan menyeka wajah."],"struggleSigns":["Anak meremas atau memasukkan kain ke mulut."],"safetyNotes":["Gunakan kain bersih dan awasi agar tidak menutupi hidung atau mulut."],"references":[{"title":"HealthyChildren.org","url":"https://www.healthychildren.org/English/ages-stages/toddler/Pages/default.aspx"}]},
