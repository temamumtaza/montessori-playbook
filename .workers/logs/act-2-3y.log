  {"id":"2-3y-melipat-serbet","title":"Melipat Serbet Sederhana","summary":"Anak melipat serbet menjadi dua dan menaruhnya di tempat makan.","ageBands":["2-3y"],"areas":["practical-life","grace-courtesy"],"skills":["melipat","kemandirian","persiapan makan"],"objectives":["Menyelaraskan dua sisi kain","Membantu menata tempat makan"],"materials":[{"name":"serbet kain kecil","fromHome":true,"optional":false},{"name":"meja rendah","fromHome":true,"optional":false}],"prepMinutes":2,"durationMinutes":8,"prepLevel":"rendah","presentation":[{"step":1,"text":"Ratakan serbet di atas meja."},{"step":2,"text":"Pertemukan dua sisi dan tekan lipatan."},{"step":3,"text":"Letakkan serbet di samping piring."}],"controlOfError":"Sisi serbet yang tidak bertemu terlihat saat dilipat.","variations":["Lipat kain lap menjadi dua sebelum makan."],"readySigns":["Anak mau meratakan kain dan mengikuti contoh."],"struggleSigns":["Anak meremas kain atau kehilangan minat setelah satu lipatan."],"safetyNotes":["Gunakan serbet bersih dan meja yang kokoh."],"references":[{"title":"HealthyChildren.org","url":"https://www.healthychildren.org/English/ages-stages/toddler/Pages/default.aspx"}]},
