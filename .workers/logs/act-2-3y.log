import json
p='content/parts/act-2-3y.json'; d=json.load(open(p))
allowed={'practical-life','sensorial','language','math','culture','movement','grace-courtesy','self-care','art-music','outdoor'}
required=['id','title','summary','ageBands','areas','skills','objectives','materials','prepMinutes','durationMinutes','prepLevel','presentation','controlOfError','variations','readySigns','struggleSigns','safetyNotes','references']
assert len(d)==34 and len({x['id'] for x in d})==34
for x in d:
    assert list(x)==required
    assert x['id'].startswith('2-3y-') and x['ageBands']==['2-3y']
    assert len(x['title'])>=5 and len(x['summary'])>=30
    assert 1<=len(x['areas'])<=3 and set(x['areas'])<=allowed
    assert 0<=x['prepMinutes']<=30 and 3<=x['durationMinutes']<=60
    assert x['prepLevel'] in {'rendah','sedang','tinggi'}
    assert len(x['presentation'])>=2 and all(isinstance(s['step'],int) and len(s['text'])>=15 for s in x['presentation'])
    assert len(x['safetyNotes'])>=1
    assert all(set(m)=={'name','fromHome','optional'} for m in x['materials'])
print('SCHEMA OK')
PY" in /home/temamumtaza/Documents/dev/montessori-playbook
