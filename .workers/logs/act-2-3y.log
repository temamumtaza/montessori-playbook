+  {"id":"2-3y-menunggu-giliran","title":"Menunggu Giliran Bermain","summary":"Anak belajar bergiliran dengan permainan singkat dan jelas.","ageBands":["2-3y"],"areas":["grace-courtesy","movement"],"skills":["menunggu","berbagi ruang","komunikasi"],"objectives":["Mengenali giliran diri dan orang lain","Menunggu dalam waktu singkat"],"materials":[{"name":"bola besar atau alat dorong","fromHome":true,"optional":false}],"prepMinutes":2,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Tunjukkan kartu atau kata giliran saya."},{"step":2,"text":"Ambil satu giliran singkat lalu serahkan benda."},{"step":3,"text":"Sebut giliran anak dan tunggu responsnya."}],"controlOfError":"Urutan giliran terlihat dari siapa yang memegang benda.","variations":["Gunakan timer visual yang sangat singkat."],"readySigns":["Anak dapat menunggu beberapa detik dengan bantuan."],"struggleSigns":["Anak menangis atau merebut benda saat menunggu."],"safetyNotes":["Pilih benda aman dan dampingi agar tidak ada dorongan antar-anak."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
