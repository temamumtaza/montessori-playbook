+  {"id":"3-4y-membuat-pola-kancing","title":"Membuat pola dengan kancing","summary":"Anak menyusun kancing besar dalam pola warna atau bentuk lalu melanjutkannya.","ageBands":["3-4y"],"areas":["math","art-music"],"skills":["pola","pengamatan","kreativitas"],"objectives":["Mengenali pola berulang sederhana.","Melanjutkan pola dengan bahan konkret."],"materials":[{"name":"kancing besar berbagai warna","fromHome":true,"optional":false},{"name":"alas berpola garis","fromHome":true,"optional":true}],"prepMinutes":5,"durationMinutes":12,"prepLevel":"rendah","presentation":[{"step":1,"text":"Susun pola merah-biru-merah-biru."},{"step":2,"text":"Tutup bagian akhir dengan tangan."},{"step":3,"text":"Tanyakan warna berikutnya."},{"step":4,"text":"Biarkan anak melanjutkan pola."}],"controlOfError":"Pola yang terputus tampak saat dibaca dari kiri.","variations":["Buat pola besar-kecil menggunakan tutup botol."],"readySigns":["Anak dapat menjelaskan bagian yang berulang."],"struggleSigns":["Anak mengacak bahan tanpa melihat urutan."],"safetyNotes":["Gunakan kancing berukuran besar dan awasi agar tidak dimasukkan ke mulut."],"references":[{"title":"HealthyChildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
