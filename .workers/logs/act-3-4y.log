7:  {"id":"3-4y-mencocokkan-tekstur","title":"Mencocokkan kartu tekstur","summary":"Anak meraba pasangan bahan dengan tekstur sama dan menjelaskan perbedaannya.","ageBands":["3-4y"],"areas":["sensorial","language"],"skills":["diskriminasi taktil","kosakata","ingatan"],"objectives":["Membedakan halus, kasar, lembut, dan bertekstur.","Menggunakan kata untuk menggambarkan sensasi."],"materials":[{"name":"kartu kain berpasangan","fromHome":true,"optional":false},{"name":"kain penutup","fromHome":true,"optional":true}],"prepMinutes":10,"durationMinutes":15,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan semua kartu berjajar."},{"step":2,"text":"Raba satu kartu dengan ujung jari."},{"step":3,"text":"Cari kartu yang terasa sama."},{"step":4,"text":"Sebutkan tekstur pasangan itu."}],"controlOfError":"Pasangan yang tidak sama terasa berbeda saat diraba.","variations":["Mainkan dengan mata tertutup setelah anak siap."],"readySigns":["Anak membandingkan dua kartu sebelum memilih."],"struggleSigns":["Anak memilih hanya berdasarkan warna."],"safetyNotes":["Gunakan bahan bersih, tidak berbulu lepas, dan tidak mudah tertelan."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
8:  {"id":"3-4y-menyusun-menara-balok","title":"Menyusun menara berpola","summary":"Anak menyusun balok dari besar ke kecil sambil mengamati keseimbangan dan pola.","ageBands":["3-4y"],"areas":["sensorial","movement"],"skills":["ukuran","keseimbangan","perencanaan"],"objectives":["Membandingkan besar dan kecil.","Menyusun benda secara teratur."],"materials":[{"name":"balok kayu berbagai ukuran","fromHome":true,"optional":false}],"prepMinutes":2,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan balok acak di atas karpet."},{"step":2,"text":"Pilih balok terbesar untuk dasar."},{"step":3,"text":"Tambahkan balok lebih kecil."},{"step":4,"text":"Amati menara dari jarak aman."}],"controlOfError":"Menara jatuh bila dasar atau urutan kurang stabil.","variations":["Susun pola warna bergantian."],"readySigns":["Anak mencari balok yang tepat sebelum menaruhnya."],"struggleSigns":["Anak menumpuk terlalu banyak tanpa memperhatikan dasar."],"safetyNotes":["Pilih balok tanpa sudut tajam dan beri ruang agar menara tidak mengenai wajah."],"references":[{"title":"HealthyChildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
9:  {"id":"3-4y-mengurutkan-panjang","title":"Mengurutkan pita dari pendek","summary":"Anak membandingkan pita dan menyusunnya dari yang paling pendek ke paling panjang.","ageBands":["3-4y"],"areas":["sensorial","math"],"skills":["perbandingan panjang","pengurutan","bahasa matematika"],"objectives":["Mengurutkan lima benda berdasarkan panjang.","Menggunakan kata pendek dan panjang."],"materials":[{"name":"lima pita berbeda panjang","fromHome":true,"optional":false},{"name":"alas kerja","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":12,"prepLevel":"rendah","presentation":[{"step":1,"text":"Bentangkan pita sejajar di alas."},{"step":2,"text":"Cari pita yang paling pendek."},{"step":3,"text":"Letakkan pita berikutnya di sampingnya."},{"step":4,"text":"Periksa urutan sampai paling panjang."}],"controlOfError":"Ujung pita yang tidak sejajar memperlihatkan urutan keliru.","variations":["Gunakan tali dengan warna serupa agar fokus pada panjang."],"readySigns":["Anak membandingkan ujung pita dengan teliti."],"struggleSigns":["Anak memilih berdasarkan warna saja."],"safetyNotes":["Hindari tali panjang yang dapat melilit leher atau kaki."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
10:  {"id":"3-4y-mengelompokkan-benda","title":"Mengelompokkan benda rumah","summary":"Anak mengelompokkan benda berdasarkan fungsi, bahan, atau warna dan menjelaskan pilihannya.","ageBands":["3-4y"],"areas":["sensorial","math","language"],"skills":["klasifikasi","alasan sederhana","kosakata"],"objectives":["Menemukan persamaan dan perbedaan.","Menjelaskan dasar pengelompokan."],"materials":[{"name":"benda rumah yang aman","fromHome":true,"optional":false},{"name":"tiga mangkuk","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":15,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan benda campur di karpet."},{"step":2,"text":"Pilih satu benda sebagai contoh."},{"step":3,"text":"Cari benda yang sekelompok."},{"step":4,"text":"Ceritakan alasan pengelompokan."}],"controlOfError":"Anak dapat memeriksa apakah aturan kelompoknya konsisten.","variations":["Kelompokkan berdasarkan bahan kayu, logam, dan kain."],"readySigns":["Anak bisa mengubah aturan kelompok dengan sengaja."],"struggleSigns":["Anak memindahkan benda tanpa aturan yang jelas."],"safetyNotes":["Pilih benda besar, bersih, dan bebas bagian kecil yang mudah tertelan."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
11:  {"id":"3-4y-menghitung-benda","title":"Menghitung benda satu-satu","summary":"Anak menghitung benda konkret dengan menyentuh satu benda untuk setiap angka yang diucapkan.","ageBands":["3-4y"],"areas":["math","language"],"skills":["korespondensi satu-satu","urutan angka","fokus"],"objectives":["Menghubungkan jumlah dengan benda nyata.","Menghitung kumpulan kecil secara teratur."],"materials":[{"name":"sepuluh tutup botol besar","fromHome":true,"optional":false},{"name":"karpet kecil","fromHome":true,"optional":true}],"prepMinutes":2,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Susun benda dalam satu baris."},{"step":2,"text":"Sentuh benda pertama sambil berkata satu."},{"step":3,"text":"Lanjutkan satu angka untuk satu benda."},{"step":4,"text":"Sebutkan jumlah terakhir sebagai total."}],"controlOfError":"Benda yang terlewat membuat jumlah tidak cocok.","variations":["Minta anak mengambil jumlah tertentu sampai lima."],"readySigns":["Anak tidak menghitung benda yang sama dua kali."],"struggleSigns":["Anak mengucapkan angka tanpa menyentuh benda."],"safetyNotes":["Gunakan benda yang terlalu besar untuk tertelan dan tetap dampingi."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
12:  {"id":"3-4y-mencari-huruf-nama","title":"Mencari huruf dalam nama","summary":"Anak mengenali beberapa huruf namanya melalui kartu dan mencocokkannya dengan label sederhana.","ageBands":["3-4y"],"areas":["language"],"skills":["kesadaran huruf","pengenalan nama","memori visual"],"objectives":["Mengenali huruf yang sering dilihat.","Menghubungkan simbol dengan nama sendiri."],"materials":[{"name":"kartu huruf besar","fromHome":true,"optional":false},{"name":"kartu nama anak","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan kartu nama di depan anak."},{"step":2,"text":"Tunjukkan huruf pertama namanya."},{"step":3,"text":"Cari kartu dengan bentuk sama."},{"step":4,"text":"Susun huruf mengikuti contoh nama."}],"controlOfError":"Bentuk huruf pada kartu tidak cocok dengan contoh.","variations":["Cari huruf yang sama pada buku bergambar."],"readySigns":["Anak bertanya tentang bunyi huruf dengan minat."],"struggleSigns":["Anak frustrasi saat diminta mengingat semua huruf."],"safetyNotes":["Gunakan kartu besar tanpa sudut tajam dan ikuti minat anak."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
13:  {"id":"3-4y-meronce-pasta","title":"Meronce pasta berwarna","summary":"Anak memasukkan pasta besar ke tali kaku untuk membuat rangkaian pola sederhana.","ageBands":["3-4y"],"areas":["art-music","movement"],"skills":["motorik halus","pola","konsentrasi"],"objectives":["Melatih koordinasi kedua tangan.","Membuat pola warna berulang."],"materials":[{"name":"pasta berongga besar","fromHome":true,"optional":false},{"name":"tali ujung kaku","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":15,"prepLevel":"sedang","presentation":[{"step":1,"text":"Ikat simpul pada salah satu ujung tali."},{"step":2,"text":"Pegang tali dengan satu tangan."},{"step":3,"text":"Masukkan pasta dengan tangan lain."},{"step":4,"text":"Susun warna lalu ikat hasilnya."}],"controlOfError":"Pasta yang terlepas menunjukkan ujung tali belum diamankan.","variations":["Gunakan sedotan besar yang dipotong pendek."],"readySigns":["Anak memegang tali dekat lubang pasta."],"struggleSigns":["Anak memasukkan pasta ke mulut atau melempar bahan."],"safetyNotes":["Aktivitas harus diawasi dekat karena pasta dapat menjadi bahaya tersedak."],"references":[{"title":"HealthyChildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
14:  {"id":"3-4y-menyimak-suara","title":"Menyimak suara di sekitar","summary":"Anak berhenti sejenak, mendengarkan suara sekitar, lalu menyebutkan atau menggambarnya.","ageBands":["3-4y"],"areas":["sensorial","language","outdoor"],"skills":["pendengaran","perhatian","kosakata"],"objectives":["Membedakan suara dekat dan jauh.","Menggambarkan sumber suara dengan kata."],"materials":[{"name":"selimut duduk","fromHome":true,"optional":true},{"name":"kertas dan krayon","fromHome":true,"optional":true}],"prepMinutes":3,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Duduk tenang bersama anak."},{"step":2,"text":"Tutup mata selama beberapa detik."},{"step":3,"text":"Sebutkan suara yang terdengar."},{"step":4,"text":"Gambar satu sumber suara."}],"controlOfError":"Anak dapat membandingkan jawabannya saat suara muncul lagi.","variations":["Buat peta suara sederhana di halaman."],"readySigns":["Anak dapat menunggu tanpa menyela suara."],"struggleSigns":["Anak tampak tidak nyaman dengan lingkungan bising."],"safetyNotes":["Pilih tempat aman dan hindari suara keras atau mendadak."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
15:  {"id":"3-4y-menuang-beras","title":"Menuang beras dengan corong","summary":"Anak memindahkan beras kering menggunakan corong sambil menjaga meja tetap rapi.","ageBands":["3-4y"],"areas":["practical-life","sensorial"],"skills":["koordinasi","kontrol gerak","kemandirian"],"objectives":["Mengontrol aliran bahan kering.","Membersihkan area setelah bekerja."],"materials":[{"name":"beras kering","fromHome":true,"optional":false},{"name":"corong besar","fromHome":true,"optional":false},{"name":"dua botol lebar","fromHome":true,"optional":false},{"name":"sapu meja kecil","fromHome":true,"optional":true}],"prepMinutes":5,"durationMinutes":12,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan corong pada botol kosong."},{"step":2,"text":"Ambil beras dengan cangkir kecil."},{"step":3,"text":"Tuang perlahan melalui corong."},{"step":4,"text":"Sapu beras yang tercecer."}],"controlOfError":"Beras yang tercecer terlihat di atas alas.","variations":["Gunakan biji-bijian lebih besar dan sedikit."],"readySigns":["Anak memegang botol agar tidak bergeser."],"struggleSigns":["Anak menuang penuh sampai corong tersumbat."],"safetyNotes":["Jauhkan beras dari mulut, hidung, dan area bermain adik kecil."],"references":[{"title":"NHS Start for Life","url":"https://www.nhs.uk/start-for-life/toddler/"}]},
16:  {"id":"3-4y-mengupas-pisang","title":"Mengupas pisang sendiri","summary":"Anak membuka kulit pisang, membuang kulitnya, dan menaruh buah pada piring dengan tertib.","ageBands":["3-4y"],"areas":["practical-life","self-care"],"skills":["kemandirian makan","urutan langkah","kebersihan"],"objectives":["Menyelesaikan persiapan camilan sederhana.","Membuang sampah pada tempatnya."],"materials":[{"name":"pisang matang","fromHome":true,"optional":false},{"name":"piring kecil","fromHome":true,"optional":false},{"name":"wadah kulit","fromHome":true,"optional":false}],"prepMinutes":2,"durationMinutes":8,"prepLevel":"rendah","presentation":[{"step":1,"text":"Cuci tangan sebelum mulai."},{"step":2,"text":"Tekan ujung pisang perlahan."},{"step":3,"text":"Tarik kulit ke bawah."},{"step":4,"text":"Letakkan kulit dan pisang pada tempatnya."}],"controlOfError":"Kulit yang tersisa terlihat pada pisang.","variations":["Potong pisang dengan alat pemotong anak bersama orang dewasa."],"readySigns":["Anak mengingat mencuci tangan tanpa diingatkan."],"struggleSigns":["Anak menggigit kulit atau melemparkannya."],"safetyNotes":["Periksa alergi makanan dan dampingi saat anak makan."],"references":[{"title":"WHO Food Safety","url":"https://www.who.int/news-room/fact-sheets/detail/food-safety"}]},
17:  {"id":"3-4y-menyapu-remah","title":"Menyapu remah ke pengki","summary":"Anak menyapu remah kecil ke satu titik lalu memindahkannya ke tempat sampah.","ageBands":["3-4y"],"areas":["practical-life","movement"],"skills":["koordinasi tubuh","tanggung jawab","perawatan lingkungan"],"objectives":["Menggunakan alat kebersihan sederhana.","Mengembalikan area agar siap digunakan."],"materials":[{"name":"sapu tangan kecil","fromHome":true,"optional":false},{"name":"pengki anak","fromHome":true,"optional":false},{"name":"remah besar yang aman","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":8,"prepLevel":"rendah","presentation":[{"step":1,"text":"Taburkan sedikit remah di alas."},{"step":2,"text":"Pegang sapu dengan dua tangan."},{"step":3,"text":"Dorong remah menuju pengki."},{"step":4,"text":"Buang dan kembalikan alat."}],"controlOfError":"Remah yang tersisa terlihat di lantai.","variations":["Beri garis batas area yang perlu disapu."],"readySigns":["Anak melihat lantai setelah menyapu."],"struggleSigns":["Anak mengayun sapu ke arah orang lain."],"safetyNotes":["Gunakan bahan bersih dan jauhkan sapu dari wajah."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
18:  {"id":"3-4y-memakai-resleting","title":"Menaikkan resleting jaket","summary":"Anak berlatih memasukkan kepala resleting dan menaikkannya pada jaket dengan bantuan seperlunya.","ageBands":["3-4y"],"areas":["self-care","practical-life"],"skills":["kemandirian berpakaian","koordinasi jari","pemecahan masalah"],"objectives":["Mengikuti urutan memakai resleting.","Meminta bantuan dengan cara yang jelas."],"materials":[{"name":"jaket dengan resleting besar","fromHome":true,"optional":false}],"prepMinutes":2,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan jaket terbuka di depan anak."},{"step":2,"text":"Masukkan ujung resleting ke kepala."},{"step":3,"text":"Tahan bagian bawah dengan satu tangan."},{"step":4,"text":"Tarik kepala resleting ke atas."}],"controlOfError":"Resleting tidak bergerak bila ujung belum masuk tepat.","variations":["Latihan di jaket yang dilepas sebelum dipakai."],"readySigns":["Anak mencoba menyelaraskan ujung sendiri."],"struggleSigns":["Anak menarik kepala resleting dengan paksa."],"safetyNotes":["Pastikan tidak ada kulit atau kain yang terjepit."],"references":[{"title":"NHS Start for Life","url":"https://www.nhs.uk/start-for-life/toddler/"}]},
19:  {"id":"3-4y-mencocokkan-bayangan","title":"Mencocokkan benda dan bayangan","summary":"Anak mencocokkan benda rumah dengan gambar siluetnya sambil menyebutkan nama benda.","ageBands":["3-4y"],"areas":["sensorial","language"],"skills":["persepsi visual","kosakata","pencocokan"],"objectives":["Mengenali bentuk benda dari siluet.","Mengucapkan nama benda dengan jelas."],"materials":[{"name":"kartu siluet benda","fromHome":true,"optional":false},{"name":"benda rumah berukuran besar","fromHome":true,"optional":false}],"prepMinutes":8,"durationMinutes":12,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan tiga kartu siluet berjajar."},{"step":2,"text":"Ambil satu benda dari keranjang."},{"step":3,"text":"Cari siluet yang bentuknya cocok."},{"step":4,"text":"Sebutkan nama benda tersebut."}],"controlOfError":"Benda tidak menutupi siluet yang berbeda.","variations":["Gunakan benda dari dapur yang aman dan tidak tajam."],"readySigns":["Anak memutar benda untuk mencari kecocokan."],"struggleSigns":["Anak menebak tanpa melihat bentuk."],"safetyNotes":["Jangan gunakan benda tajam, pecah belah, atau kecil."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
20:  {"id":"3-4y-mengukur-dengan-balok","title":"Mengukur meja dengan balok","summary":"Anak mengukur panjang meja menggunakan balok yang sama ukuran dan menghitung jumlahnya.","ageBands":["3-4y"],"areas":["math","movement"],"skills":["pengukuran awal","menghitung","ketelitian"],"objectives":["Memahami bahwa satuan perlu berulang dan rapat.","Membandingkan hasil pengukuran sederhana."],"materials":[{"name":"balok berukuran sama","fromHome":true,"optional":false},{"name":"meja rendah","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":15,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan balok tepat dari tepi meja."},{"step":2,"text":"Susun balok tanpa celah."},{"step":3,"text":"Hitung balok sampai ujung."},{"step":4,"text":"Bandingkan dengan sisi lain."}],"controlOfError":"Celah atau balok bertumpuk membuat hasil berbeda.","variations":["Ukur rak buku atau karpet dengan balok sama."],"readySigns":["Anak memperhatikan agar balok tidak tumpang tindih."],"struggleSigns":["Anak memakai balok berbeda ukuran tanpa menyadarinya."],"safetyNotes":["Pastikan meja stabil dan balok tidak mudah jatuh ke kaki."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
21:  {"id":"3-4y-membuat-pola-kancing","title":"Membuat pola dengan kancing","summary":"Anak menyusun kancing besar dalam pola warna atau bentuk lalu melanjutkannya.","ageBands":["3-4y"],"areas":["math","art-music"],"skills":["pola","pengamatan","kreativitas"],"objectives":["Mengenali pola berulang sederhana.","Melanjutkan pola dengan bahan konkret."],"materials":[{"name":"kancing besar berbagai warna","fromHome":true,"optional":false},{"name":"alas berpola garis","fromHome":true,"optional":true}],"prepMinutes":5,"durationMinutes":12,"prepLevel":"rendah","presentation":[{"step":1,"text":"Susun pola merah-biru-merah-biru."},{"step":2,"text":"Tutup bagian akhir dengan tangan."},{"step":3,"text":"Tanyakan warna berikutnya."},{"step":4,"text":"Biarkan anak melanjutkan pola."}],"controlOfError":"Pola yang terputus tampak saat dibaca dari kiri.","variations":["Buat pola besar-kecil menggunakan tutup botol."],"readySigns":["Anak dapat menjelaskan bagian yang berulang."],"struggleSigns":["Anak mengacak bahan tanpa melihat urutan."],"safetyNotes":["Gunakan kancing berukuran besar dan awasi agar tidak dimasukkan ke mulut."],"references":[{"title":"HealthyChildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
22:  {"id":"3-4y-menyusun-cerita-gambar","title":"Menyusun urutan cerita gambar","summary":"Anak menata tiga sampai empat gambar sesuai urutan kejadian dan menceritakannya.","ageBands":["3-4y"],"areas":["language","culture"],"skills":["urutan waktu","bercerita","sebab akibat"],"objectives":["Menata kejadian dari awal hingga akhir.","Menceritakan gagasan dengan kalimat sederhana."],"materials":[{"name":"kartu gambar berurutan","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":15,"prepLevel":"sedang","presentation":[{"step":1,"text":"Campur tiga kartu cerita."},{"step":2,"text":"Cari gambar yang terjadi lebih dulu."},{"step":3,"text":"Susun gambar sampai selesai."},{"step":4,"text":"Ceritakan urutannya bersama."}],"controlOfError":"Cerita terasa tidak masuk akal bila gambar tertukar.","variations":["Minta anak menggambar satu akhir cerita."],"readySigns":["Anak memakai kata lalu, setelah itu, dan akhirnya."],"struggleSigns":["Anak hanya menyebut nama benda tanpa urutan."],"safetyNotes":["Pilih cerita netral yang tidak menakutkan bagi anak."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
23:  {"id":"3-4y-mengikuti-resep-sederhana","title":"Membuat salad buah sederhana","summary":"Anak mengikuti gambar resep, memasukkan potongan buah, dan mengaduk camilan bersama orang dewasa.","ageBands":["3-4y"],"areas":["practical-life","language","self-care"],"skills":["mengikuti instruksi","kebersihan","kerja sama"],"objectives":["Mengikuti dua sampai tiga instruksi berurutan.","Berpartisipasi dalam menyiapkan makanan."],"materials":[{"name":"buah yang sudah dipotong orang dewasa","fromHome":true,"optional":false},{"name":"mangkuk besar","fromHome":true,"optional":false},{"name":"sendok saji","fromHome":true,"optional":false}],"prepMinutes":10,"durationMinutes":20,"prepLevel":"tinggi","presentation":[{"step":1,"text":"Cuci tangan dan lihat kartu resep."},{"step":2,"text":"Masukkan buah sesuai gambar."},{"step":3,"text":"Aduk perlahan dari bawah."},{"step":4,"text":"Sajikan porsi kecil."}],"controlOfError":"Bahan yang belum masuk terlihat pada meja persiapan.","variations":["Gunakan yogurt tawar dengan bantuan orang dewasa."],"readySigns":["Anak menunggu giliran memakai alat."],"struggleSigns":["Anak mengambil bahan terlalu banyak sekaligus."],"safetyNotes":["Orang dewasa memotong buah, memeriksa alergi, dan mengawasi seluruh proses."],"references":[{"title":"WHO Food Safety","url":"https://www.who.int/news-room/fact-sheets/detail/food-safety"}]},
24:  {"id":"3-4y-menata-meja","title":"Menata tempat makan","summary":"Anak menyiapkan piring, gelas, sendok, dan serbet sesuai contoh tempat makan sederhana.","ageBands":["3-4y"],"areas":["grace-courtesy","practical-life"],"skills":["urutan kerja","tanggung jawab","tata krama"],"objectives":["Menata beberapa benda sesuai fungsi.","Berpartisipasi dalam rutinitas keluarga."],"materials":[{"name":"piring plastik","fromHome":true,"optional":false},{"name":"gelas plastik","fromHome":true,"optional":false},{"name":"sendok dan serbet","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Tunjukkan contoh satu tempat makan."},{"step":2,"text":"Letakkan piring di depan kursi."},{"step":3,"text":"Taruh sendok di samping piring."},{"step":4,"text":"Letakkan gelas dan serbet."}],"controlOfError":"Benda yang belum tersedia terlihat dari contoh.","variations":["Minta anak menata satu tempat untuk boneka."],"readySigns":["Anak membawa satu benda dengan dua tangan."],"struggleSigns":["Anak menaruh alat terlalu dekat tepi meja."],"safetyNotes":["Gunakan perlengkapan tidak pecah dan pastikan meja stabil."],"references":[{"title":"HealthyChildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
25:  {"id":"3-4y-berjalan-di-garis","title":"Berjalan mengikuti garis","summary":"Anak berjalan perlahan mengikuti garis di lantai sambil menjaga tubuh tetap seimbang.","ageBands":["3-4y"],"areas":["movement","grace-courtesy"],"skills":["keseimbangan","kontrol tubuh","kesadaran ruang"],"objectives":["Mengatur langkah pada jalur tertentu.","Berhenti dan mulai dengan kendali."],"materials":[{"name":"selotip kertas","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Buat garis melengkung di lantai."},{"step":2,"text":"Berdiri di awal garis."},{"step":3,"text":"Langkahkan kaki mengikuti garis."},{"step":4,"text":"Berhenti di ujung dengan tenang."}],"controlOfError":"Kaki keluar dari garis menunjukkan jalur perlu diperhatikan.","variations":["Bawa benda ringan di atas telapak tangan."],"readySigns":["Anak memperlambat langkah saat garis berbelok."],"struggleSigns":["Anak berlari atau mendorong teman."],"safetyNotes":["Tempel garis pada lantai yang kering dan kosong dari benda tersandung."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
26:  {"id":"3-4y-mengikuti-irama","title":"Meniru irama tepukan","summary":"Anak mendengarkan pola tepukan singkat lalu mencoba mengulanginya dengan tangan atau alat aman.","ageBands":["3-4y"],"areas":["art-music","movement"],"skills":["pendengaran","ingatan kerja","ritme"],"objectives":["Meniru pola bunyi pendek.","Menunggu giliran dan memulai saat siap."],"materials":[{"name":"dua stik kayu pendek","fromHome":true,"optional":true}],"prepMinutes":2,"durationMinutes":8,"prepLevel":"rendah","presentation":[{"step":1,"text":"Duduk berhadapan dengan anak."},{"step":2,"text":"Tepuk pola dua atau tiga bunyi."},{"step":3,"text":"Tunggu anak mengulanginya."},{"step":4,"text":"Berikan giliran anak memimpin."}],"controlOfError":"Pola terdengar berbeda saat jumlah atau jedanya berubah.","variations":["Gunakan ketukan pelan dan cepat secara bergantian."],"readySigns":["Anak menunggu seluruh pola sebelum menjawab."],"struggleSigns":["Anak tampak terganggu oleh bunyi keras."],"safetyNotes":["Gunakan volume lembut dan stik tanpa ujung tajam."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
27:  {"id":"3-4y-menggambar-peta-rumah","title":"Menggambar peta rumah","summary":"Anak menggambar tempat yang dikenalnya dan menambahkan simbol sederhana untuk pintu atau meja.","ageBands":["3-4y"],"areas":["culture","art-music"],"skills":["representasi ruang","menggambar","kosakata tempat"],"objectives":["Menghubungkan gambar dengan lingkungan nyata.","Menyebutkan posisi dekat, jauh, dan di samping."],"materials":[{"name":"kertas besar","fromHome":true,"optional":false},{"name":"krayon","fromHome":true,"optional":false},{"name":"stiker bentuk","fromHome":true,"optional":true}],"prepMinutes":5,"durationMinutes":20,"prepLevel":"sedang","presentation":[{"step":1,"text":"Amati satu ruang bersama anak."},{"step":2,"text":"Gambar bentuk ruang secara sederhana."},{"step":3,"text":"Tambahkan benda yang dikenal."},{"step":4,"text":"Ceritakan letak setiap benda."}],"controlOfError":"Anak dapat memeriksa gambar dengan melihat ruang sebenarnya.","variations":["Buat peta jalan pendek menuju kamar."],"readySigns":["Anak memberi tanda untuk beberapa tempat penting."],"struggleSigns":["Anak merasa harus menggambar dengan sempurna."],"safetyNotes":["Gunakan krayon tidak beracun dan beri ruang kerja yang aman."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
28:  {"id":"3-4y-mengenal-bagian-tanaman","title":"Mengamati bagian tanaman","summary":"Anak mengamati akar, batang, daun, dan bunga pada tanaman lalu mencocokkannya dengan kartu nama.","ageBands":["3-4y"],"areas":["culture","language","outdoor"],"skills":["observasi alam","kosakata sains","perawatan"],"objectives":["Mengenali beberapa bagian tanaman.","Menggunakan kata untuk menggambarkan perubahan."],"materials":[{"name":"tanaman hidup yang aman","fromHome":true,"optional":false},{"name":"kartu gambar bagian tanaman","fromHome":true,"optional":false},{"name":"kaca pembesar anak","fromHome":true,"optional":true}],"prepMinutes":5,"durationMinutes":15,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan tanaman pada meja."},{"step":2,"text":"Amati akar, batang, daun, dan bunga."},{"step":3,"text":"Cocokkan kartu dengan bagian tanaman."},{"step":4,"text":"Siram secukupnya bersama."}],"controlOfError":"Kartu tidak cocok dengan bentuk bagian tanaman.","variations":["Cari bagian serupa pada tanaman di halaman."],"readySigns":["Anak menyentuh dengan lembut dan mengamati detail."],"struggleSigns":["Anak menarik atau merusak daun."],"safetyNotes":["Pilih tanaman yang tidak beracun dan cuci tangan setelah kegiatan."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
29:  {"id":"3-4y-mengklasifikasi-daun","title":"Mengklasifikasi daun","summary":"Anak mengumpulkan daun yang sudah jatuh dan mengelompokkannya berdasarkan ukuran, bentuk, atau warna.","ageBands":["3-4y"],"areas":["outdoor","sensorial","culture"],"skills":["pengamatan alam","klasifikasi","perbandingan"],"objectives":["Membandingkan ciri benda alam.","Mengelompokkan berdasarkan satu aturan."],"materials":[{"name":"daun yang sudah jatuh","fromHome":false,"optional":false},{"name":"keranjang kecil","fromHome":true,"optional":false},{"name":"alas kertas","fromHome":true,"optional":true}],"prepMinutes":5,"durationMinutes":20,"prepLevel":"sedang","presentation":[{"step":1,"text":"Pilih daun yang kering dan utuh."},{"step":2,"text":"Letakkan daun di atas alas."},{"step":3,"text":"Bandingkan warna dan ukurannya."},{"step":4,"text":"Buat kelompok dengan aturan pilihan."}],"controlOfError":"Daun yang tidak sesuai aturan tampak di kelompok lain.","variations":["Jiplak bentuk daun dengan krayon."],"readySigns":["Anak menjelaskan mengapa daun berada di kelompok tertentu."],"struggleSigns":["Anak mengambil daun hidup atau daun kotor."],"safetyNotes":["Cuci tangan setelah kegiatan dan hindari tanaman berduri atau bergetah."],"references":[{"title":"WHO Environmental Health","url":"https://www.who.int/health-topics/children"}]},
30:  {"id":"3-4y-membuat-kolase-alam","title":"Membuat kolase bahan alam","summary":"Anak menempel daun kering dan ranting kecil menjadi gambar bebas dengan pilihan bahan terbatas.","ageBands":["3-4y"],"areas":["art-music","outdoor"],"skills":["kreativitas","motorik halus","perencanaan"],"objectives":["Memilih dan menata bahan untuk karya.","Menggunakan lem secukupnya."],"materials":[{"name":"daun kering dan biji besar","fromHome":false,"optional":false},{"name":"kertas tebal","fromHome":true,"optional":false},{"name":"lem tidak beracun","fromHome":true,"optional":false}],"prepMinutes":10,"durationMinutes":25,"prepLevel":"tinggi","presentation":[{"step":1,"text":"Pilih beberapa bahan di atas nampan."},{"step":2,"text":"Susun bahan tanpa lem dahulu."},{"step":3,"text":"Oleskan lem sedikit demi sedikit."},{"step":4,"text":"Tekan bahan lalu biarkan kering."}],"controlOfError":"Bahan mudah lepas bila lem terlalu sedikit atau belum kering.","variations":["Buat bentuk hewan dari susunan daun."],"readySigns":["Anak merencanakan susunan sebelum menempel."],"struggleSigns":["Anak mengoleskan lem ke tangan atau meja."],"safetyNotes":["Gunakan bahan besar, lem tidak beracun, dan awasi agar tidak masuk mulut."],"references":[{"title":"HealthyChildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
31:  {"id":"3-4y-menolong-menata-buku","title":"Menata buku di rak","summary":"Anak mengembalikan buku ke rak dengan posisi rapi dan memilih tempat yang sesuai ukurannya.","ageBands":["3-4y"],"areas":["grace-courtesy","practical-life","language"],"skills":["merawat barang","klasifikasi ukuran","tanggung jawab"],"objectives":["Mengembalikan barang ke tempatnya.","Menjaga buku agar tidak rusak."],"materials":[{"name":"rak rendah","fromHome":true,"optional":false},{"name":"buku anak berukuran besar","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Ambil satu buku dengan dua tangan."},{"step":2,"text":"Bawa buku dekat dada."},{"step":3,"text":"Letakkan tegak atau mendatar."},{"step":4,"text":"Pastikan rak tetap mudah digunakan."}],"controlOfError":"Buku yang miring atau menonjol terlihat saat rak diperiksa.","variations":["Kelompokkan buku berdasarkan tema atau ukuran."],"readySigns":["Anak mengembalikan buku setelah selesai membaca."],"struggleSigns":["Anak menarik buku lain saat mengambil satu buku."],"safetyNotes":["Gunakan rak kokoh yang terpasang aman dan tidak terlalu tinggi."],"references":[{"title":"NHS Start for Life","url":"https://www.nhs.uk/start-for-life/toddler/"}]},
32:  {"id":"3-4y-berlatih-meminta-tolong","title":"Berlatih meminta bantuan","summary":"Anak bermain peran menggunakan kalimat sopan saat membutuhkan bantuan dari orang lain.","ageBands":["3-4y"],"areas":["grace-courtesy","language"],"skills":["komunikasi","menunggu giliran","kesopanan"],"objectives":["Mengungkapkan kebutuhan dengan kata-kata.","Menunggu respons tanpa merebut."],"materials":[{"name":"benda yang sulit dibuka ringan","fromHome":true,"optional":false},{"name":"boneka atau pasangan bermain","fromHome":true,"optional":true}],"prepMinutes":3,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Tunjukkan benda yang belum bisa dibuka."},{"step":2,"text":"Ucapkan, Tolong bantu saya."},{"step":3,"text":"Tunggu jawaban dengan tenang."},{"step":4,"text":"Ucapkan terima kasih setelah dibantu."}],"controlOfError":"Orang lain memahami permintaan atau meminta anak mengulanginya.","variations":["Berlatih meminta giliran memakai mainan."],"readySigns":["Anak mencoba meminta dengan kalimat bukan menangis saja."],"struggleSigns":["Anak merebut benda sebelum meminta."],"safetyNotes":["Gunakan benda yang aman dan jangan membuat anak merasa dipermalukan saat belum lancar."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
33:  {"id":"3-4y-menggambar-perasaan","title":"Menggambar perasaan hari ini","summary":"Anak memilih warna dan bentuk untuk menggambarkan perasaan, lalu bercerita bila ingin.","ageBands":["3-4y"],"areas":["art-music","language","self-care"],"skills":["mengenali emosi","ekspresi diri","kosakata"],"objectives":["Menyebutkan atau menunjuk perasaan.","Menemukan cara aman untuk mengekspresikan diri."],"materials":[{"name":"kertas","fromHome":true,"optional":false},{"name":"krayon warna","fromHome":true,"optional":false}],"prepMinutes":2,"durationMinutes":15,"prepLevel":"rendah","presentation":[{"step":1,"text":"Sediakan kertas dan beberapa krayon."},{"step":2,"text":"Tanyakan perasaan anak tanpa memaksa."},{"step":3,"text":"Biarkan anak memilih warna dan bentuk."},{"step":4,"text":"Dengarkan cerita anak dengan tenang."}],"controlOfError":"Tidak ada jawaban gambar yang benar atau salah.","variations":["Gunakan wajah sederhana untuk menamai senang, sedih, dan marah."],"readySigns":["Anak mau menunjuk atau memberi nama perasaan."],"struggleSigns":["Anak tidak ingin berbicara tentang gambar."],"safetyNotes":["Hormati pilihan anak untuk tidak bercerita dan gunakan bahan seni tidak beracun."],"references":[{"title":"HealthyChildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
34:  {"id":"3-4y-mencari-bentuk-di-luar","title":"Berburu bentuk di halaman","summary":"Anak mencari lingkaran, persegi, dan segitiga pada benda di sekitar dengan berjalan bersama orang dewasa.","ageBands":["3-4y"],"areas":["outdoor","math","movement"],"skills":["bentuk geometri","observasi","kosakata ruang"],"objectives":["Mengenali bentuk pada benda nyata.","Menghubungkan simbol bentuk dengan lingkungan."],"materials":[{"name":"kartu bentuk besar","fromHome":true,"optional":false},{"name":"keranjang kecil","fromHome":true,"optional":true}],"prepMinutes":5,"durationMinutes":20,"prepLevel":"sedang","presentation":[{"step":1,"text":"Tunjukkan satu kartu bentuk."},{"step":2,"text":"Cari benda yang bentuknya mirip."},{"step":3,"text":"Sebutkan nama bentuk bersama."},{"step":4,"text":"Kembalikan benda yang dipindah."}],"controlOfError":"Bentuk benda dapat dibandingkan langsung dengan kartu.","variations":["Cari bentuk yang sama di dalam rumah."],"readySigns":["Anak membedakan bentuk berdasarkan sisi dan sudut."],"struggleSigns":["Anak berlari menjauh dari area kegiatan."],"safetyNotes":["Tetapkan batas area dan dampingi dekat jalan, tangga, atau tanaman berbahaya."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
35:  {"id":"3-4y-mengamati-cuaca","title":"Mencatat cuaca harian","summary":"Anak mengamati langit, angin, dan suhu yang terasa lalu memilih simbol cuaca untuk kalender.","ageBands":["3-4y"],"areas":["culture","language","outdoor"],"skills":["observasi","konsep waktu","kosakata alam"],"objectives":["Mengamati perubahan cuaca dari hari ke hari.","Menghubungkan pengalaman dengan simbol sederhana."],"materials":[{"name":"kalender mingguan","fromHome":true,"optional":false},{"name":"kartu simbol cuaca","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":8,"prepLevel":"rendah","presentation":[{"step":1,"text":"Amati langit dari tempat teduh."},{"step":2,"text":"Rasakan apakah udara hangat atau sejuk."},{"step":3,"text":"Pilih kartu yang sesuai."},{"step":4,"text":"Tempel kartu pada hari ini."}],"controlOfError":"Pengamatan dapat dibandingkan dengan keadaan langit saat itu.","variations":["Buat catatan perubahan selama satu minggu."],"readySigns":["Anak menyebut ciri cuaca tanpa hanya meniru."],"struggleSigns":["Anak ingin berada di luar saat hujan deras atau panas menyengat."],"safetyNotes":["Amati dari tempat teduh dan hindari petir, panas berlebih, atau udara buruk."],"references":[{"title":"WHO Children and Environment","url":"https://www.who.int/health-topics/children"}]},
36:  {"id":"3-4y-mengurutkan-kegiatan","title":"Mengurutkan rutinitas pagi","summary":"Anak menyusun gambar rutinitas pagi agar memahami urutan kegiatan yang biasa dilakukan.","ageBands":["3-4y"],"areas":["self-care","language","math"],"skills":["urutan waktu","kemandirian","komunikasi"],"objectives":["Mengenali awal, tengah, dan akhir kegiatan.","Mengikuti rutinitas dengan lebih mandiri."],"materials":[{"name":"kartu gambar rutinitas","fromHome":true,"optional":false},{"name":"papan kecil","fromHome":true,"optional":true}],"prepMinutes":5,"durationMinutes":12,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan kartu kegiatan secara acak."},{"step":2,"text":"Cari kegiatan yang dilakukan pertama."},{"step":3,"text":"Susun kartu berikutnya bersama."},{"step":4,"text":"Ceritakan urutan dari awal."}],"controlOfError":"Urutan dapat dibandingkan dengan pengalaman pagi anak.","variations":["Gunakan foto benda nyata di rumah."],"readySigns":["Anak mengantisipasi langkah berikutnya."],"struggleSigns":["Anak merasa tertekan bila urutan rutinitas berubah."],"safetyNotes":["Gunakan sebagai panduan fleksibel, bukan tuntutan yang membuat anak cemas."],"references":[{"title":"NHS Start for Life","url":"https://www.nhs.uk/start-for-life/toddler/"}]},
37:  {"id":"3-4y-menggunting-garis","title":"Menggunting garis tebal","summary":"Anak memotong mengikuti garis lurus dan melengkung pendek dengan gunting anak yang aman.","ageBands":["3-4y"],"areas":["art-music","movement"],"skills":["motorik halus","koordinasi mata tangan","ketelitian"],"objectives":["Membuka dan menutup gunting dengan terarah.","Mengikuti garis sederhana."],"materials":[{"name":"gunting anak berujung tumpul","fromHome":true,"optional":false},{"name":"kertas bergaris tebal","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":15,"prepLevel":"tinggi","presentation":[{"step":1,"text":"Pegang kertas dengan tangan membantu."},{"step":2,"text":"Masukkan jari ke lubang gunting."},{"step":3,"text":"Buka tutup sambil maju perlahan."},{"step":4,"text":"Letakkan gunting setelah selesai."}],"controlOfError":"Potongan yang keluar garis terlihat pada kertas.","variations":["Potong garis pendek sebelum mencoba lengkung."],"readySigns":["Anak memindahkan kertas saat arah berubah."],"struggleSigns":["Anak membawa gunting sambil berjalan atau mengarahkannya ke orang."],"safetyNotes":["Selalu dampingi, gunakan gunting anak, dan simpan setelah selesai."],"references":[{"title":"HealthyChildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
38:  {"id":"3-4y-membuat-cap-sayur","title":"Membuat cap dari sayur","summary":"Anak mencelup potongan sayur ke cat lalu membuat pola cap pada kertas.","ageBands":["3-4y"],"areas":["art-music","sensorial"],"skills":["eksplorasi bentuk","kontrol tangan","kreativitas"],"objectives":["Mengamati hubungan bentuk dan hasil cap.","Menggunakan alat seni dengan tertib."],"materials":[{"name":"potongan sayur besar","fromHome":true,"optional":false},{"name":"cat tidak beracun","fromHome":true,"optional":false},{"name":"kertas dan celemek","fromHome":true,"optional":false}],"prepMinutes":10,"durationMinutes":20,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan sedikit cat pada wadah."},{"step":2,"text":"Tekan sayur ke permukaan cat."},{"step":3,"text":"Capkan sekali pada kertas."},{"step":4,"text":"Bersihkan alat setelah selesai."}],"controlOfError":"Cap terlalu basah atau terlalu tipis terlihat pada hasilnya.","variations":["Gunakan warna berbeda untuk membuat pola berulang."],"readySigns":["Anak menekan dengan cukup, tidak menggeser cap."],"struggleSigns":["Anak menyentuh cat lalu menggosokkannya ke wajah."],"safetyNotes":["Gunakan cat tidak beracun, jauhkan dari mulut, dan cuci tangan setelah kegiatan."],"references":[{"title":"HealthyChildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
39:  {"id":"3-4y-membuat-es-batu-warna","title":"Mengamati es batu mencair","summary":"Anak mengamati es batu berwarna mencair dan membicarakan perubahan yang dilihatnya.","ageBands":["3-4y"],"areas":["culture","sensorial","art-music"],"skills":["pengamatan perubahan","sebab akibat","kosakata"],"objectives":["Mengamati padat berubah menjadi cair.","Menceritakan urutan perubahan sederhana."],"materials":[{"name":"es batu berwarna dari pewarna makanan","fromHome":true,"optional":false},{"name":"nampan","fromHome":true,"optional":false},{"name":"kertas gambar","fromHome":true,"optional":true}],"prepMinutes":10,"durationMinutes":20,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan es di atas nampan."},{"step":2,"text":"Amati bentuk dan warnanya."},{"step":3,"text":"Tunggu sambil melihat perubahan."},{"step":4,"text":"Gambar jejak warna di kertas."}],"controlOfError":"Perubahan dapat dilihat dari es utuh menjadi air.","variations":["Bandingkan es di tempat teduh dan tempat hangat dengan bantuan orang dewasa."],"readySigns":["Anak menunggu dan memperhatikan tanpa memegang terus-menerus."],"struggleSigns":["Anak memasukkan es atau pewarna ke mulut."],"safetyNotes":["Jangan diminum, gunakan pewarna makanan secukupnya, dan lap lantai agar tidak licin."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
40:  {"id":"3-4y-bermain-pasar-sederhana","title":"Bermain pasar sederhana","summary":"Anak bermain peran sebagai pembeli dan penjual dengan menghitung barang serta memakai kalimat sopan.","ageBands":["3-4y"],"areas":["math","grace-courtesy","language"],"skills":["bermain peran","menghitung","komunikasi sosial"],"objectives":["Menggunakan bahasa untuk bergiliran.","Menghitung jumlah kecil dalam situasi bermain."],"materials":[{"name":"benda makanan mainan besar","fromHome":true,"optional":false},{"name":"keranjang","fromHome":true,"optional":false},{"name":"uang mainan besar","fromHome":true,"optional":true}],"prepMinutes":8,"durationMinutes":25,"prepLevel":"tinggi","presentation":[{"step":1,"text":"Susun benda sebagai kios kecil."},{"step":2,"text":"Contohkan menyapa dan memilih barang."},{"step":3,"text":"Hitung satu sampai lima benda."},{"step":4,"text":"Tukar peran dengan anak."}],"controlOfError":"Jumlah barang dapat dihitung ulang bersama.","variations":["Gunakan kartu daftar belanja dengan gambar."],"readySigns":["Anak menunggu giliran dan memakai kalimat pendek."],"struggleSigns":["Anak memperebutkan peran atau mengambil semua barang."],"safetyNotes":["Gunakan benda besar yang aman dan jangan memakai koin kecil sungguhan."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]}

