+  {"id":"3-4y-menuang-air","title":"Menuang air dengan kendi","summary":"Anak berlatih menuang air perlahan dari kendi kecil ke gelas tanpa terburu-buru.","ageBands":["3-4y"],"areas":["practical-life","movement"],"skills":["koordinasi tangan","konsentrasi","kontrol gerak"],"objectives":["Menguatkan koordinasi mata dan tangan.","Mengatur gerakan agar air tidak tumpah."],"materials":[{"name":"kendi kecil","fromHome":true,"optional":false},{"name":"dua gelas plastik","fromHome":true,"optional":false},{"name":"nampan dan kain lap","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan kendi dan dua gelas di atas nampan."},{"step":2,"text":"Pegang gagang kendi dengan dua tangan."},{"step":3,"text":"Tuang sampai batas yang terlihat."},{"step":4,"text":"Kembalikan kendi lalu lap tumpahan."}],"controlOfError":"Air yang tumpah terlihat dan dapat dilap.","variations":["Gunakan kacang besar kering sebelum mencoba air."],"readySigns":["Anak dapat membawa nampan dengan tenang."],"struggleSigns":["Anak menuang terlalu cepat atau menggenggam gelas erat."],"safetyNotes":["Gunakan air sedikit dan awasi agar lantai tidak licin."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"3-4y-memindahkan-kacang","title":"Memindahkan kacang dengan sendok","summary":"Anak memindahkan kacang besar dari satu mangkuk ke mangkuk lain dengan sendok.","ageBands":["3-4y"],"areas":["practical-life","self-care"],"skills":["ketepatan","kekuatan jari","kemandirian"],"objectives":["Melatih genggaman sendok.","Menyelesaikan urutan kerja sederhana."],"materials":[{"name":"dua mangkuk","fromHome":true,"optional":false},{"name":"kacang besar atau pompom","fromHome":true,"optional":false},{"name":"sendok makan","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":8,"prepLevel":"rendah","presentation":[{"step":1,"text":"Isi satu mangkuk dengan kacang besar."},{"step":2,"text":"Ambil satu kacang memakai sendok."},{"step":3,"text":"Pindahkan ke mangkuk kosong."},{"step":4,"text":"Ulangi sampai mangkuk pertama kosong."}],"controlOfError":"Kacang yang tersisa menunjukkan pekerjaan belum selesai.","variations":["Ganti sendok dengan penjepit dapur kecil."],"readySigns":["Anak menjaga bahan tetap di atas nampan."],"struggleSigns":["Anak memakai seluruh tangan untuk mengambil bahan."],"safetyNotes":["Pilih bahan yang terlalu besar untuk tertelan dan dampingi anak."],"references":[{"title":"HealthyChildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
+  {"id":"3-4y-mengancing-baju","title":"Latihan mengancing baju","summary":"Anak membuka dan memasang kancing besar pada kain untuk mendukung kemandirian berpakaian.","ageBands":["3-4y"],"areas":["self-care","practical-life"],"skills":["koordinasi jari","kemandirian berpakaian","kesabaran"],"objectives":["Mengikuti urutan membuka dan memasang kancing.","Menguatkan gerak jari kecil."],"materials":[{"name":"baju berkancing besar","fromHome":true,"optional":false}],"prepMinutes":2,"durationMinutes":12,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan baju dengan kancing menghadap anak."},{"step":2,"text":"Tunjukkan cara memasukkan kancing perlahan."},{"step":3,"text":"Tarik kain sampai kancing rata."},{"step":4,"text":"Buka kembali satu kancing."}],"controlOfError":"Kancing yang miring atau terbuka menjadi petunjuk.","variations":["Mulai dari satu kancing besar lalu tambah bertahap."],"readySigns":["Anak mencoba kembali setelah kancing terlepas."],"struggleSigns":["Anak menarik kain dengan tenaga berlebihan."],"safetyNotes":["Gunakan kancing besar yang terpasang kuat dan jangan biarkan masuk mulut."],"references":[{"title":"NHS Start for Life","url":"https://www.nhs.uk/start-for-life/toddler/"}]},
+  {"id":"3-4y-melipat-serbet","title":"Melipat serbet menjadi persegi","summary":"Anak mengikuti garis lipatan serbet sederhana dan merapikan hasilnya di meja.","ageBands":["3-4y"],"areas":["practical-life","grace-courtesy"],"skills":["urutan langkah","ketelitian","kesiapan makan"],"objectives":["Mengikuti dua sampai tiga lipatan.","Menyiapkan tempat makan dengan rapi."],"materials":[{"name":"serbet kain","fromHome":true,"optional":false},{"name":"keranjang kecil","fromHome":true,"optional":true}],"prepMinutes":2,"durationMinutes":7,"prepLevel":"rendah","presentation":[{"step":1,"text":"Bentangkan serbet di atas meja."},{"step":2,"text":"Temukan dua sudut yang berhadapan."},{"step":3,"text":"Pertemukan sudut lalu tekan garisnya."},{"step":4,"text":"Simpan serbet di keranjang."}],"controlOfError":"Sudut yang tidak bertemu menunjukkan lipatan belum tepat.","variations":["Gunakan serbet dengan garis warna sebagai petunjuk."],"readySigns":["Anak meratakan serbet sebelum melipat."],"struggleSigns":["Anak melipat sambil mengacak kain."],"safetyNotes":["Pastikan meja stabil dan kain bersih."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"3-4y-mencuci-buah","title":"Mencuci buah untuk camilan","summary":"Anak mencuci buah dengan air mengalir, mengeringkannya, lalu menyiapkan camilan sederhana.","ageBands":["3-4y"],"areas":["practical-life","self-care"],"skills":["kebersihan","urutan kerja","tanggung jawab"],"objectives":["Mengenali langkah mencuci makanan.","Mengikuti kebiasaan bersih sebelum makan."],"materials":[{"name":"buah berukuran besar","fromHome":true,"optional":false},{"name":"baskom kecil","fromHome":true,"optional":false},{"name":"handuk bersih","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":10,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan buah di dalam baskom."},{"step":2,"text":"Basahi dan gosok permukaannya."},{"step":3,"text":"Bilas dengan air bersih."},{"step":4,"text":"Keringkan lalu sajikan."}],"controlOfError":"Kotoran yang tersisa terlihat pada permukaan buah.","variations":["Cuci sayur berdaun besar dengan bantuan orang dewasa."],"readySigns":["Anak menggosok seluruh permukaan buah."],"struggleSigns":["Anak membawa buah basah tanpa alas."],"safetyNotes":["Orang dewasa menangani pisau dan memastikan buah sesuai untuk anak."],"references":[{"title":"WHO Food Safety","url":"https://www.who.int/news-room/fact-sheets/detail/food-safety"}]},
+  {"id":"3-4y-mencocokkan-tekstur","title":"Mencocokkan kartu tekstur","summary":"Anak meraba pasangan bahan dengan tekstur sama dan menjelaskan perbedaannya.","ageBands":["3-4y"],"areas":["sensorial","language"],"skills":["diskriminasi taktil","kosakata","ingatan"],"objectives":["Membedakan halus, kasar, lembut, dan bertekstur.","Menggunakan kata untuk menggambarkan sensasi."],"materials":[{"name":"kartu kain berpasangan","fromHome":true,"optional":false},{"name":"kain penutup","fromHome":true,"optional":true}],"prepMinutes":10,"durationMinutes":15,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan semua kartu berjajar."},{"step":2,"text":"Raba satu kartu dengan ujung jari."},{"step":3,"text":"Cari kartu yang terasa sama."},{"step":4,"text":"Sebutkan tekstur pasangan itu."}],"controlOfError":"Pasangan yang tidak sama terasa berbeda saat diraba.","variations":["Mainkan dengan mata tertutup setelah anak siap."],"readySigns":["Anak membandingkan dua kartu sebelum memilih."],"struggleSigns":["Anak memilih hanya berdasarkan warna."],"safetyNotes":["Gunakan bahan bersih, tidak berbulu lepas, dan tidak mudah tertelan."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"3-4y-menyusun-menara-balok","title":"Menyusun menara berpola","summary":"Anak menyusun balok dari besar ke kecil sambil mengamati keseimbangan dan pola.","ageBands":["3-4y"],"areas":["sensorial","movement"],"skills":["ukuran","keseimbangan","perencanaan"],"objectives":["Membandingkan besar dan kecil.","Menyusun benda secara teratur."],"materials":[{"name":"balok kayu berbagai ukuran","fromHome":true,"optional":false}],"prepMinutes":2,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan balok acak di atas karpet."},{"step":2,"text":"Pilih balok terbesar untuk dasar."},{"step":3,"text":"Tambahkan balok lebih kecil."},{"step":4,"text":"Amati menara dari jarak aman."}],"controlOfError":"Menara jatuh bila dasar atau urutan kurang stabil.","variations":["Susun pola warna bergantian."],"readySigns":["Anak mencari balok yang tepat sebelum menaruhnya."],"struggleSigns":["Anak menumpuk terlalu banyak tanpa memperhatikan dasar."],"safetyNotes":["Pilih balok tanpa sudut tajam dan beri ruang agar menara tidak mengenai wajah."],"references":[{"title":"HealthyChildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
+  {"id":"3-4y-mengurutkan-panjang","title":"Mengurutkan pita dari pendek","summary":"Anak membandingkan pita dan menyusunnya dari yang paling pendek ke paling panjang.","ageBands":["3-4y"],"areas":["sensorial","math"],"skills":["perbandingan panjang","pengurutan","bahasa matematika"],"objectives":["Mengurutkan lima benda berdasarkan panjang.","Menggunakan kata pendek dan panjang."],"materials":[{"name":"lima pita berbeda panjang","fromHome":true,"optional":false},{"name":"alas kerja","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":12,"prepLevel":"rendah","presentation":[{"step":1,"text":"Bentangkan pita sejajar di alas."},{"step":2,"text":"Cari pita yang paling pendek."},{"step":3,"text":"Letakkan pita berikutnya di sampingnya."},{"step":4,"text":"Periksa urutan sampai paling panjang."}],"controlOfError":"Ujung pita yang tidak sejajar memperlihatkan urutan keliru.","variations":["Gunakan tali dengan warna serupa agar fokus pada panjang."],"readySigns":["Anak membandingkan ujung pita dengan teliti."],"struggleSigns":["Anak memilih berdasarkan warna saja."],"safetyNotes":["Hindari tali panjang yang dapat melilit leher atau kaki."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"3-4y-mengelompokkan-benda","title":"Mengelompokkan benda rumah","summary":"Anak mengelompokkan benda berdasarkan fungsi, bahan, atau warna dan menjelaskan pilihannya.","ageBands":["3-4y"],"areas":["sensorial","math","language"],"skills":["klasifikasi","alasan sederhana","kosakata"],"objectives":["Menemukan persamaan dan perbedaan.","Menjelaskan dasar pengelompokan."],"materials":[{"name":"benda rumah yang aman","fromHome":true,"optional":false},{"name":"tiga mangkuk","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":15,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan benda campur di karpet."},{"step":2,"text":"Pilih satu benda sebagai contoh."},{"step":3,"text":"Cari benda yang sekelompok."},{"step":4,"text":"Ceritakan alasan pengelompokan."}],"controlOfError":"Anak dapat memeriksa apakah aturan kelompoknya konsisten.","variations":["Kelompokkan berdasarkan bahan kayu, logam, dan kain."],"readySigns":["Anak bisa mengubah aturan kelompok dengan sengaja."],"struggleSigns":["Anak memindahkan benda tanpa aturan yang jelas."],"safetyNotes":["Pilih benda besar, bersih, dan bebas bagian kecil yang mudah tertelan."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"3-4y-menghitung-benda","title":"Menghitung benda satu-satu","summary":"Anak menghitung benda konkret dengan menyentuh satu benda untuk setiap angka yang diucapkan.","ageBands":["3-4y"],"areas":["math","language"],"skills":["korespondensi satu-satu","urutan angka","fokus"],"objectives":["Menghubungkan jumlah dengan benda nyata.","Menghitung kumpulan kecil secara teratur."],"materials":[{"name":"sepuluh tutup botol besar","fromHome":true,"optional":false},{"name":"karpet kecil","fromHome":true,"optional":true}],"prepMinutes":2,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Susun benda dalam satu baris."},{"step":2,"text":"Sentuh benda pertama sambil berkata satu."},{"step":3,"text":"Lanjutkan satu angka untuk satu benda."},{"step":4,"text":"Sebutkan jumlah terakhir sebagai total."}],"controlOfError":"Benda yang terlewat membuat jumlah tidak cocok.","variations":["Minta anak mengambil jumlah tertentu sampai lima."],"readySigns":["Anak tidak menghitung benda yang sama dua kali."],"struggleSigns":["Anak mengucapkan angka tanpa menyentuh benda."],"safetyNotes":["Gunakan benda yang terlalu besar untuk tertelan dan tetap dampingi."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"3-4y-mencari-huruf-nama","title":"Mencari huruf dalam nama","summary":"Anak mengenali beberapa huruf namanya melalui kartu dan mencocokkannya dengan label sederhana.","ageBands":["3-4y"],"areas":["language"],"skills":["kesadaran huruf","pengenalan nama","memori visual"],"objectives":["Mengenali huruf yang sering dilihat.","Menghubungkan simbol dengan nama sendiri."],"materials":[{"name":"kartu huruf besar","fromHome":true,"optional":false},{"name":"kartu nama anak","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan kartu nama di depan anak."},{"step":2,"text":"Tunjukkan huruf pertama namanya."},{"step":3,"text":"Cari kartu dengan bentuk sama."},{"step":4,"text":"Susun huruf mengikuti contoh nama."}],"controlOfError":"Bentuk huruf pada kartu tidak cocok dengan contoh.","variations":["Cari huruf yang sama pada buku bergambar."],"readySigns":["Anak bertanya tentang bunyi huruf dengan minat."],"struggleSigns":["Anak frustrasi saat diminta mengingat semua huruf."],"safetyNotes":["Gunakan kartu besar tanpa sudut tajam dan ikuti minat anak."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
