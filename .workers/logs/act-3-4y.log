+  {"id":"3-4y-mencocokkan-bayangan","title":"Mencocokkan benda dan bayangan","summary":"Anak mencocokkan benda rumah dengan gambar siluetnya sambil menyebutkan nama benda.","ageBands":["3-4y"],"areas":["sensorial","language"],"skills":["persepsi visual","kosakata","pencocokan"],"objectives":["Mengenali bentuk benda dari siluet.","Mengucapkan nama benda dengan jelas."],"materials":[{"name":"kartu siluet benda","fromHome":true,"optional":false},{"name":"benda rumah berukuran besar","fromHome":true,"optional":false}],"prepMinutes":8,"durationMinutes":12,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan tiga kartu siluet berjajar."},{"step":2,"text":"Ambil satu benda dari keranjang."},{"step":3,"text":"Cari siluet yang bentuknya cocok."},{"step":4,"text":"Sebutkan nama benda tersebut."}],"controlOfError":"Benda tidak menutupi siluet yang berbeda.","variations":["Gunakan benda dari dapur yang aman dan tidak tajam."],"readySigns":["Anak memutar benda untuk mencari kecocokan."],"struggleSigns":["Anak menebak tanpa melihat bentuk."],"safetyNotes":["Jangan gunakan benda tajam, pecah belah, atau kecil."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
