+  {"id":"3-4y-menuang-air","title":"Menuang air dengan kendi","summary":"Anak berlatih menuang air perlahan dari kendi kecil ke gelas tanpa terburu-buru.","ageBands":["3-4y"],"areas":["practical-life","movement"],"skills":["koordinasi tangan","konsentrasi","kontrol gerak"],"objectives":["Menguatkan koordinasi mata dan tangan.","Mengatur gerakan agar air tidak tumpah."],"materials":[{"name":"kendi kecil","fromHome":true,"optional":false},{"name":"dua gelas plastik","fromHome":true,"optional":false},{"name":"nampan dan kain lap","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan kendi dan dua gelas di atas nampan."},{"step":2,"text":"Pegang gagang kendi dengan dua tangan."},{"step":3,"text":"Tuang sampai batas yang terlihat."},{"step":4,"text":"Kembalikan kendi lalu lap tumpahan."}],"controlOfError":"Air yang tumpah terlihat dan dapat dilap.","variations":["Gunakan kacang besar kering sebelum mencoba air."],"readySigns":["Anak dapat membawa nampan dengan tenang."],"struggleSigns":["Anak menuang terlalu cepat atau menggenggam gelas erat."],"safetyNotes":["Gunakan air sedikit dan awasi agar lantai tidak licin."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"3-4y-memindahkan-kacang","title":"Memindahkan kacang dengan sendok","summary":"Anak memindahkan kacang besar dari satu mangkuk ke mangkuk lain dengan sendok.","ageBands":["3-4y"],"areas":["practical-life","self-care"],"skills":["ketepatan","kekuatan jari","kemandirian"],"objectives":["Melatih genggaman sendok.","Menyelesaikan urutan kerja sederhana."],"materials":[{"name":"dua mangkuk","fromHome":true,"optional":false},{"name":"kacang besar atau pompom","fromHome":true,"optional":false},{"name":"sendok makan","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":8,"prepLevel":"rendah","presentation":[{"step":1,"text":"Isi satu mangkuk dengan kacang besar."},{"step":2,"text":"Ambil satu kacang memakai sendok."},{"step":3,"text":"Pindahkan ke mangkuk kosong."},{"step":4,"text":"Ulangi sampai mangkuk pertama kosong."}],"controlOfError":"Kacang yang tersisa menunjukkan pekerjaan belum selesai.","variations":["Ganti sendok dengan penjepit dapur kecil."],"readySigns":["Anak menjaga bahan tetap di atas nampan."],"struggleSigns":["Anak memakai seluruh tangan untuk mengambil bahan."],"safetyNotes":["Pilih bahan yang terlalu besar untuk tertelan dan dampingi anak."],"references":[{"title":"HealthyChildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
+  {"id":"3-4y-mengancing-baju","title":"Latihan mengancing baju","summary":"Anak membuka dan memasang kancing besar pada kain untuk mendukung kemandirian berpakaian.","ageBands":["3-4y"],"areas":["self-care","practical-life"],"skills":["koordinasi jari","kemandirian berpakaian","kesabaran"],"objectives":["Mengikuti urutan membuka dan memasang kancing.","Menguatkan gerak jari kecil."],"materials":[{"name":"baju berkancing besar","fromHome":true,"optional":false}],"prepMinutes":2,"durationMinutes":12,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan baju dengan kancing menghadap anak."},{"step":2,"text":"Tunjukkan cara memasukkan kancing perlahan."},{"step":3,"text":"Tarik kain sampai kancing rata."},{"step":4,"text":"Buka kembali satu kancing."}],"controlOfError":"Kancing yang miring atau terbuka menjadi petunjuk.","variations":["Mulai dari satu kancing besar lalu tambah bertahap."],"readySigns":["Anak mencoba kembali setelah kancing terlepas."],"struggleSigns":["Anak menarik kain dengan tenaga berlebihan."],"safetyNotes":["Gunakan kancing besar yang terpasang kuat dan jangan biarkan masuk mulut."],"references":[{"title":"NHS Start for Life","url":"https://www.nhs.uk/start-for-life/toddler/"}]},
+  {"id":"3-4y-melipat-serbet","title":"Melipat serbet menjadi persegi","summary":"Anak mengikuti garis lipatan serbet sederhana dan merapikan hasilnya di meja.","ageBands":["3-4y"],"areas":["practical-life","grace-courtesy"],"skills":["urutan langkah","ketelitian","kesiapan makan"],"objectives":["Mengikuti dua sampai tiga lipatan.","Menyiapkan tempat makan dengan rapi."],"materials":[{"name":"serbet kain","fromHome":true,"optional":false},{"name":"keranjang kecil","fromHome":true,"optional":true}],"prepMinutes":2,"durationMinutes":7,"prepLevel":"rendah","presentation":[{"step":1,"text":"Bentangkan serbet di atas meja."},{"step":2,"text":"Temukan dua sudut yang berhadapan."},{"step":3,"text":"Pertemukan sudut lalu tekan garisnya."},{"step":4,"text":"Simpan serbet di keranjang."}],"controlOfError":"Sudut yang tidak bertemu menunjukkan lipatan belum tepat.","variations":["Gunakan serbet dengan garis warna sebagai petunjuk."],"readySigns":["Anak meratakan serbet sebelum melipat."],"struggleSigns":["Anak melipat sambil mengacak kain."],"safetyNotes":["Pastikan meja stabil dan kain bersih."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"3-4y-mencuci-buah","title":"Mencuci buah untuk camilan","summary":"Anak mencuci buah dengan air mengalir, mengeringkannya, lalu menyiapkan camilan sederhana.","ageBands":["3-4y"],"areas":["practical-life","self-care"],"skills":["kebersihan","urutan kerja","tanggung jawab"],"objectives":["Mengenali langkah mencuci makanan.","Mengikuti kebiasaan bersih sebelum makan."],"materials":[{"name":"buah berukuran besar","fromHome":true,"optional":false},{"name":"baskom kecil","fromHome":true,"optional":false},{"name":"handuk bersih","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":10,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan buah di dalam baskom."},{"step":2,"text":"Basahi dan gosok permukaannya."},{"step":3,"text":"Bilas dengan air bersih."},{"step":4,"text":"Keringkan lalu sajikan."}],"controlOfError":"Kotoran yang tersisa terlihat pada permukaan buah.","variations":["Cuci sayur berdaun besar dengan bantuan orang dewasa."],"readySigns":["Anak menggosok seluruh permukaan buah."],"struggleSigns":["Anak membawa buah basah tanpa alas."],"safetyNotes":["Orang dewasa menangani pisau dan memastikan buah sesuai untuk anak."],"references":[{"title":"WHO Food Safety","url":"https://www.who.int/news-room/fact-sheets/detail/food-safety"}]},
