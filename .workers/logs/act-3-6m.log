 "safetyNotes":["Pastikan kotak tidak memiliki staples atau tepi tajam.","Gunakan kain besar yang tidak bisa tertelan dan tidak ada tali.","Awasi anak agar kain tidak melilit leher atau menutupi wajah."],
 "references":[{"title":"Montessori Global","url":"https://montessoriglobal.com/"},{"title":"Zero to Three - Resources","url":"https://www.zerotothree.org/resources/"}]
},
{
 "id":"36m-menirukan-bunyi-bayi",
 "title":"Menirukan Bunyi Bayi",
 "summary":"Tirukan bunyi yang dibuat anak lalu tambahkan satu bunyi baru, mendorong anak bereksperimen dengan suaranya.",
 "ageBands":["3-6m"],
 "areas":["language"],
 "skills":["eksplorasi suara","giliran bicara","pendengaran"],
 "objectives":["Merangsang variasi celotehan","Melatih anak mendengar dan meniru"],
 "materials":[{"name":"suara orang tua","fromHome":True,"optional":False}],
 "prepMinutes":0,
 "durationMinutes":4,
 "prepLevel":"rendah",
 "presentation":[{"step":1,"text":"Duduk dekat anak dengan wajah sejajar."},{"step":2,"text":"Tirukan bunyi yang baru saja ia keluarkan."},{"step":3,"text":"Tambahkan satu bunyi baru yang mudah, lalu berhenti."},{"step":4,"text":"Tunggu anak mencoba menirukan bunyi tersebut."}],
 "controlOfError":"Bila orang tua terus berbicara, anak kehilangan giliran; beri jeda setelah setiap bunyi.",
 "variations":["Gunakan bunyi hewan sederhana","Lakukan sambil bercermin agar anak melihat mulut"],
 "readySigns":["Anak sering mengeluarkan bunyi berulang","Anak menatap mulut orang tua"],
 "struggleSigns":["Anak jarang bersuara","Anak tidak menoleh saat diajak bicara"],
 "safetyNotes":["Lakukan saat anak bangun dan tenang, bukan saat mengantuk.","Jaga jarak wajah agar anak tidak merasa tertekan.","Awasi anak selama sesi."],
 "references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"},{"title":"NHS - Baby and toddler health","url":"https://www.nhs.uk/baby/"}]
},
{
 "id":"36m-tengkurap-di-dada-orang-tua",
 "title":"Tengkurap di Dada Orang Tua",
 "summary":"Baringkan anak tengkurap di dada orang tua yang bersandar agar ia berlatih mengangkat kepala dalam posisi nyaman dan dekat.",
 "ageBands":["3-6m"],
 "areas":["movement","grace-courtesy"],
 "skills":["kontrol kepala","kedekatan","kekuatan leher"],
 "objectives":["Melatih tengkurap dengan rasa aman","Memperkuat ikatan lewat kontak tubuh"],
 "materials":[{"name":"dada orang tua","fromHome":True,"optional":False},{"name":"selimut tipis","fromHome":True,"optional":True}],
 "prepMinutes":0,
 "durationMinutes":5,
 "prepLevel":"rendah",
 "presentation":[{"step":1,"text":"Bersandarlah nyaman di kursi atau bantal."},{"step":2,"text":"Letakkan anak tengkurap di dada Anda, kepalanya di dekat bahu."},{"step":3,"text":"Ajak bicara agar anak mengangkat kepala mencari wajah Anda."},{"step":4,"text":"Berhenti saat anak mulai lelah atau mengantuk."}],
 "controlOfError":"Anak akan menurunkan kepala atau merengek saat lelah; itu tanda untuk berhenti.",
 "variations":["Lakukan sambil bersandar di sofa","Tambahkan lagu pelan saat anak tengkurap"],
