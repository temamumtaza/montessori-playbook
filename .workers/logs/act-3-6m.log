 "id":"36m-memindahkan-benda-antar-tangan",
 "title":"Memindahkan Benda Antar Tangan",
 "summary":"Berikan benda ringan yang mudah digenggam agar anak berlatih memindahkannya dari satu tangan ke tangan lain.",
 "ageBands":["3-6m"],
 "areas":["movement","sensorial"],
 "skills":["koordinasi dua tangan","kontrol genggaman","perhatian"],
 "objectives":["Melatih perpindahan benda antar tangan","Memperkuat jari dan pergelangan"],
 "materials":[{"name":"mainan genggam ringan tanpa bagian kecil","fromHome":True,"optional":False},{"name":"keranjang kecil","fromHome":True,"optional":True}],
 "prepMinutes":1,
 "durationMinutes":6,
 "prepLevel":"rendah",
 "presentation":[{"step":1,"text":"Letakkan mainan di tangan kanan anak."},{"step":2,"text":"Tunggu sampai ia menggenggam dengan kuat."},{"step":3,"text":"Sentuhkan tangan kirinya ke mainan itu."},{"step":4,"text":"Biarkan anak menemukan cara memindahkannya sendiri."}],
 "controlOfError":"Benda akan jatuh bila perpindahan belum lancar; anak dapat mencoba lagi tanpa dikoreksi.",
 "variations":["Gunakan dua benda identik untuk saling ditukar","Lakukan sambil bernyanyi agar lebih menyenangkan"],
 "readySigns":["Anak bisa menggenggam benda sebentar","Anak membawa tangan ke tengah tubuh"],
 "struggleSigns":["Satu tangan selalu mengepal","Anak melepas benda dengan cepat"],
 "safetyNotes":["Pastikan benda lebih besar dari mulut anak dan tidak punya bagian kecil.","Awasi anak karena benda akan sering dibawa ke mulut.","Hindari benda dengan tali, pita, atau lonceng kecil."],
 "references":[{"title":"Zero to Three - Resources","url":"https://www.zerotothree.org/resources/"},{"title":"Montessori Global","url":"https://montessoriglobal.com/"}]
},
{
 "id":"36m-berjemur-pagi-di-teduh",
 "title":"Berjemur Pagi di Tempat Teduh",
 "summary":"Ajak anak keluar rumah pada pagi hari untuk merasakan udara segar dan cahaya alami tanpa paparan matahari langsung.",
 "ageBands":["3-6m"],
 "areas":["outdoor","self-care"],
 "skills":["adaptasi lingkungan","pengalaman sensorik","ritme harian"],
 "objectives":["Mengenalkan anak pada lingkungan luar rumah","Membantu membangun ritme siang dan malam"],
 "materials":[{"name":"matras luar","fromHome":True,"optional":False},{"name":"topi lebar","fromHome":True,"optional":False},{"name":"selimut tipis","fromHome":True,"optional":True}],
 "prepMinutes":5,
 "durationMinutes":15,
 "prepLevel":"rendah",
 "presentation":[{"step":1,"text":"Pilih waktu pagi saat matahari belum terlalu terik."},{"step":2,"text":"Cari area teduh dan jauh dari angin kencang."},{"step":3,"text":"Baringkan anak di matras dengan pakaian nyaman."},{"step":4,"text":"Amati bersama daun dan awan, lalu kembali bila anak rewel."}],
 "controlOfError":"Anak akan rewel bila kepanasan atau silau; tanda untuk segera pindah ke tempat sejuk.",
 "variations":["Ajak anak mengamati pohon dari gendongan","Lakukan di teras rumah saat teduh"],
 "readySigns":["Anak terbiasa dibawa keluar rumah","Anak tenang saat berada di tempat baru"],
 "struggleSigns":["Anak menangis saat diajak keluar","Anak kepanasan atau kedinginan"],
 "safetyNotes":["Hindari sinar matahari langsung; gunakan tempat teduh dan topi lebar.","Jangan tinggalkan anak sendirian di luar rumah.","Periksa suhu kulit anak dan segera masuk bila terlalu panas atau dingin."],
 "references":[{"title":"WHO - Child health","url":"https://www.who.int/health-topics/child-health"},{"title":"NHS - Baby and toddler health","url":"https://www.nhs.uk/baby/"}]
},
{
 "id":"36m-mendengar-suara-rumah",
 "title":"Mendengar Suara-Suara Rumah",
 "summary":"Ajak anak berhenti sejenak untuk mendengarkan suara sekitar, lalu ceritakan sumber bunyi dengan kata-kata sederhana.",
 "ageBands":["3-6m"],
 "areas":["language","sensorial"],
 "skills":["kesadaran bunyi","mendengar","kosakata"],
 "objectives":["Melatih kepekaan terhadap bunyi","Mengenalkan kata untuk suara sehari-hari"],
 "materials":[{"name":"lingkungan rumah","fromHome":True,"optional":False}],
 "prepMinutes":0,
 "durationMinutes":5,
 "prepLevel":"rendah",
 "presentation":[{"step":1,"text":"Duduk bersama anak di ruangan yang tenang."},{"step":2,"text":"Diam sejenak dan dengarkan suara di sekitar."},{"step":3,"text":"Tunjuk arah suara dan sebutkan sumbernya."},{"step":4,"text":"Ajak anak tersenyum saat suara baru terdengar."}],
 "controlOfError":"Bila ruangan terlalu bising, anak sulit membedakan bunyi; pilih waktu yang lebih tenang.",
 "variations":["Dengarkan suara hujan dari dekat jendela","Gunakan mainan berbunyi halus sebagai pembanding"],
 "readySigns":["Anak menoleh ke arah suara","Anak terdiam saat mendengar bunyi baru"],
 "struggleSigns":["Anak tidak bereaksi pada suara keras","Anak menangis karena suara tertentu"],
 "safetyNotes":["Jauhkan anak dari suara yang terlalu keras atau tiba-tiba.","Jangan meletakkan sumber bunyi dekat telinga anak.","Awasi anak selama sesi mendengarkan."],
 "references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"},{"title":"Zero to Three - Resources","url":"https://www.zerotothree.org/resources/"}]
},
{
 "id":"36m-menoleh-ke-arah-bunyi",
 "title":"Menoleh ke Arah Bunyi",
 "summary":"Bunyikan mainan lembut di sisi kanan dan kiri kepala anak agar ia berlatih mencari sumber suara dengan menoleh.",
 "ageBands":["3-6m"],
 "areas":["language","sensorial"],
 "skills":["lokalisasi suara","kontrol leher","perhatian"],
 "objectives":["Melatih anak mencari sumber bunyi","Memperkuat otot leher untuk menoleh"],
 "materials":[{"name":"mainan kerincing lembut","fromHome":True,"optional":False}],
 "prepMinutes":1,
 "durationMinutes":5,
 "prepLevel":"rendah",
 "presentation":[{"step":1,"text":"Baringkan anak telentang dengan nyaman."},{"step":2,"text":"Bunyikan mainan pelan di sisi kanan kepalanya."},{"step":3,"text":"Tunggu anak menoleh sebelum memindahkan bunyi."},{"step":4,"text":"Ulangi di sisi kiri dengan lembut."}],
 "controlOfError":"Bunyi yang terlalu keras membuat anak kaget; gunakan bunyi pelan dan beri jeda.",
 "variations":["Gunakan suara orang tua dari sisi berbeda","Bunyikan benda sehari-hari seperti sendok kayu"],
 "readySigns":["Anak menoleh ke arah suara","Anak mengikuti wajah orang tua dengan mata"],
 "struggleSigns":["Anak tidak menoleh pada suara","Anak kaget dan menangis setiap kali mendengar bunyi"],
 "safetyNotes":["Jauhkan mainan dari telinga dan wajah anak.","Gunakan bunyi lembut, jangan mengagetkan anak.","Awasi anak sepanjang sesi."],
 "references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"},{"title":"HealthyChildren.org - Baby Development","url":"https://www.healthychildren.org/English/ages-stages/baby/Pages/default.aspx"}]
},
{
 "id":"36m-bermain-air-saat-mandi",
 "title":"Bermain Air Saat Mandi",
 "summary":"Manfaatkan waktu mandi untuk mengajak anak merasakan air, menepuk permukaan, dan mendengar suara cipratan.",
 "ageBands":["3-6m"],
 "areas":["self-care","sensorial"],
 "skills":["sensasi air","gerak tangan","kebiasaan mandi"],
 "objectives":["Membuat waktu mandi terasa menyenangkan","Mengenalkan sensasi air pada tangan dan kaki"],
 "materials":[{"name":"bak mandi bayi","fromHome":True,"optional":False},{"name":"waslap lembut","fromHome":True,"optional":False},{"name":"mainan mandi besar","fromHome":True,"optional":True}],
 "prepMinutes":5,
 "durationMinutes":10,
 "prepLevel":"sedang",
 "presentation":[{"step":1,"text":"Siapkan air hangat suam-suam kuku dan semua perlengkapan mandi."},{"step":2,"text":"Masukkan anak perlahan sambil menopang kepala dan tubuhnya."},{"step":3,"text":"Tepuk permukaan air dengan tangan anak dengan lembut."},{"step":4,"text":"Biarkan anak merasakan air, lalu selesaikan mandi dengan cepat."}],
 "controlOfError":"Anak akan merenggang atau menangis bila air terlalu dingin atau panas; periksa suhu sebelum masuk.",
 "variations":["Gunakan cangkir kecil untuk menuang air perlahan","Lakukan di bak mandi bayi dengan waslap berbeda tekstur"],
 "readySigns":["Anak tenang saat mandi","Anak menikmati sentuhan air"],
 "struggleSigns":["Anak menangis setiap kali mandi","Anak kedinginan atau menggigil"],
 "safetyNotes":["Jangan pernah meninggalkan anak di air, bahkan sebentar; awasi terus.","Isi air setinggi beberapa sentimeter saja dan periksa suhunya dengan siku.","Pegang anak dengan aman agar tidak tergelincir."],
 "references":[{"title":"NHS - Baby and toddler health","url":"https://www.nhs.uk/baby/"},{"title":"HealthyChildren.org - Baby Development","url":"https://www.healthychildren.org/English/ages-stages/baby/Pages/default.aspx"}]
},
{
 "id":"36m-pijat-lembut-kaki-dan-tangan",
 "title":"Pijat Lembut Kaki dan Tangan",
 "summary":"Pijat ringan pada kaki dan tangan anak setelah mandi untuk memberi rasa nyaman dan mengenalkan sentuhan teratur.",
 "ageBands":["3-6m"],
 "areas":["self-care","sensorial"],
 "skills":["relaksasi","kesadaran tubuh","ikatan sosial"],
 "objectives":["Memberi pengalaman sentuhan yang menenangkan","Membantu anak mengenal bagian tubuhnya"],
 "materials":[{"name":"minyak bayi tanpa pewangi","fromHome":True,"optional":True},{"name":"handuk lembut","fromHome":True,"optional":False}],
 "prepMinutes":3,
 "durationMinutes":8,
 "prepLevel":"rendah",
 "presentation":[{"step":1,"text":"Pastikan ruangan hangat dan tangan orang tua bersih."},{"step":2,"text":"Letakkan anak di handuk setelah mandi."},{"step":3,"text":"Usap kaki dan tangan dengan gerakan lembut dari pangkal ke ujung."},{"step":4,"text":"Beri jeda dan hentikan bila anak mulai gelisah."}],
 "controlOfError":"Anak akan menarik kaki atau menangis bila sentuhan terlalu kuat; kurangi tekanan.",
 "variations":["Lakukan tanpa minyak bila kulit anak sensitif","Tambahkan lagu pelan saat memijat"],
 "readySigns":["Anak tenang saat disentuh","Anak menikmati waktu setelah mandi"],
 "struggleSigns":["Anak menangis saat kaki disentuh","Kulit anak memerah atau gatal"],
 "safetyNotes":["Hindari minyak bila ada luka atau ruam kulit; konsultasikan ke dokter bila kulit bermasalah.","Jangan memijat dengan tekanan kuat atau menarik sendi.","Awasi anak dan hentikan bila ia tampak tidak nyaman."],
 "references":[{"title":"NHS - Baby and toddler health","url":"https://www.nhs.uk/baby/"},{"title":"Zero to Three - Resources","url":"https://www.zerotothree.org/resources/"}]
},
{
 "id":"36m-bergoyang-sambil-bernyanyi",
 "title":"Bergoyang Lembut Sambil Bernyanyi",
 "summary":"Gendong anak dengan aman dan bergoyang pelan mengikuti lagu, memberi rasa ritme serta kedekatan yang menenangkan.",
 "ageBands":["3-6m"],
 "areas":["movement","art-music"],
 "skills":["keseimbangan","irama","rasa aman"],
 "objectives":["Mengenalkan gerakan berirama","Memperkuat rasa aman lewat dekapan"],
 "materials":[{"name":"gendongan atau pelukan orang tua","fromHome":True,"optional":False}],
 "prepMinutes":0,
 "durationMinutes":5,
 "prepLevel":"rendah",
 "presentation":[{"step":1,"text":"Gendong anak dengan kepala dan leher tertopang."},{"step":2,"text":"Nyanyikan lagu pelan sambil bergoyang lembut."},{"step":3,"text":"Gerakkan tubuh ke kiri dan kanan dengan ritme stabil."},{"step":4,"text":"Berhenti dan peluk anak, lalu ulangi bila ia senang."}],
 "controlOfError":"Bila goyangan terlalu cepat, anak akan gelisah; perlambat dan jaga gerakan stabil.",
 "variations":["Bergoyang sambil berjalan pelan di ruangan","Gunakan selendang gendong yang aman"],
 "readySigns":["Anak tenang saat digendong","Anak menikmati suara dan gerakan berulang"],
 "struggleSigns":["Anak menangis saat digoyang","Anak kaku atau tampak pusing"],
 "safetyNotes":["Topang kepala dan leher anak selama bergoyang.","Jangan mengguncang anak dengan keras atau melemparnya.","Jangan berjalan di lantai licin atau dekat tangga."],
 "references":[{"title":"NHS - Baby and toddler health","url":"https://www.nhs.uk/baby/"},{"title":"HealthyChildren.org - Baby Development","url":"https://www.healthychildren.org/English/ages-stages/baby/Pages/default.aspx"}]
},
{
 "id":"36m-melihat-buku-kontras-tinggi",
 "title":"Melihat Buku Kontras Tinggi",
 "summary":"Buka buku bergambar hitam-putih di depan anak dan ceritakan gambarnya, melatih fokus serta minat pada buku.",
 "ageBands":["3-6m"],
 "areas":["language","sensorial"],
 "skills":["fokus visual","kosakata","minat buku"],
 "objectives":["Melatih mata memfokuskan gambar","Membangun kebiasaan membaca bersama"],
 "materials":[{"name":"buku kain atau buku karton kontras tinggi","fromHome":False,"optional":False}],
 "prepMinutes":1,
 "durationMinutes":5,
 "prepLevel":"rendah",
 "presentation":[{"step":1,"text":"Duduk dengan anak di pangkuan, buku di depannya."},{"step":2,"text":"Buka satu halaman dan tunjuk gambar sederhana."},{"step":3,"text":"Sebutkan nama gambar dengan suara hangat."},{"step":4,"text":"Beri waktu anak mengamati sebelum membuka halaman berikutnya."}],
 "controlOfError":"Anak akan menoleh atau rewel bila halaman terlalu cepat berganti; perlambat ritme.",
 "variations":["Gunakan buku kain yang bisa dipegang","Ceritakan gambar dengan suara berbeda"],
 "readySigns":["Anak menatap gambar dengan fokus","Anak tenang saat dibacakan"],
 "struggleSigns":["Anak tidak tertarik pada buku","Anak menangis saat dibacakan"],
 "safetyNotes":["Pilih buku kain atau karton tebal tanpa bagian kecil yang bisa lepas.","Awasi anak karena buku akan dimasukkan ke mulut.","Jangan menggunakan buku dengan staples atau ujung tajam."],
 "references":[{"title":"Zero to Three - Resources","url":"https://www.zerotothree.org/resources/"},{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]
},
{
 "id":"36m-meraih-kaus-kaki-lunak",
 "title":"Meraih Kaus Kaki Lunak",
 "summary":"Gunakan kaus kaki bersih yang digulung sebagai bola ringan agar anak berlatih meraih dan menggenggam benda di dekatnya.",
 "ageBands":["3-6m"],
 "areas":["movement","sensorial"],
 "skills":["meraih","menggenggam","koordinasi tangan"],
 "objectives":["Melatih tangan meraih ke arah benda","Mengenalkan benda ringan yang mudah digenggam"],
 "materials":[{"name":"kaus kaki katun bersih","fromHome":True,"optional":False},{"name":"matras","fromHome":True,"optional":False}],
 "prepMinutes":2,
 "durationMinutes":6,
 "prepLevel":"rendah",
 "presentation":[{"step":1,"text":"Gulung kaus kaki menjadi bola ringan."},{"step":2,"text":"Letakkan di dada anak dalam jangkauan tangannya."},{"step":3,"text":"Biarkan anak meraih dan menggenggam sendiri."},{"step":4,"text":"Bila jatuh, letakkan kembali tanpa mengoreksi caranya."}],
 "controlOfError":"Bola akan menggelinding saat disentuh; anak belajar menyesuaikan gerakan tangannya.",
 "variations":["Gunakan dua bola kaus kaki untuk latihan memilih","Lakukan sambil berbaring tengkurap"],
 "readySigns":["Anak mulai mengarahkan tangan ke benda","Anak memegang benda sebentar"],
 "struggleSigns":["Tangan belum terarah ke benda","Anak melepas benda terlalu cepat"],
 "safetyNotes":["Gunakan kaus kaki bersih tanpa kancing atau hiasan lepas.","Jangan menggunakan benda kecil atau isian yang bisa keluar.","Awasi anak karena benda akan dibawa ke mulut."],
 "references":[{"title":"Zero to Three - Resources","url":"https://www.zerotothree.org/resources/"},{"title":"Montessori Global","url":"https://montessoriglobal.com/"}]
},
{
 "id":"36m-latihan-berguling-balik",
 "title":"Latihan Berguling Balik",
 "summary":"Ajak anak berlatih berguling dari telentang ke tengkurap dan sebaliknya dengan mainan sebagai pemancing di sisi tubuh.",
 "ageBands":["3-6m"],
 "areas":["movement"],
 "skills":["berguling","kekuatan otot","kesadaran posisi"],
 "objectives":["Melatih peralihan posisi tubuh","Menguatkan otot leher, punggung, dan perut"],
 "materials":[{"name":"matras empuk","fromHome":True,"optional":False},{"name":"mainan menarik","fromHome":True,"optional":True}],
 "prepMinutes":2,
 "durationMinutes":6,
 "prepLevel":"rendah",
 "presentation":[{"step":1,"text":"Baringkan anak telentang di matras."},{"step":2,"text":"Letakkan mainan di samping agar anak menoleh."},{"step":3,"text":"Bantu pinggulnya berputar sedikit bila ia sudah mencoba."},{"step":4,"text":"Beri pujian dan biarkan anak beristirahat."}],
 "controlOfError":"Anak akan berhenti bila lelah atau posisinya tidak nyaman; jangan meneruskan latihan.",
 "variations":["Lakukan setelah bangun tidur saat anak segar","Gunakan cermin di sisi sebagai pemancing"],
 "readySigns":["Anak bisa mengangkat kepala saat tengkurap","Anak mulai memiringkan badan sendiri"],
 "struggleSigns":["Tubuh anak kaku saat diputar","Anak menangis setiap kali diletakkan tengkurap"],
 "safetyNotes":["Lakukan hanya di lantai beralas matras dan awasi anak terus-menerus.","Jangan memutar leher atau lengan anak dengan paksa.","Hentikan bila anak tampak kesakitan atau sangat rewel."],
 "references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"},{"title":"HealthyChildren.org - Baby Development","url":"https://www.healthychildren.org/English/ages-stages/baby/Pages/default.aspx"}]
},
{
 "id":"36m-menarik-kain-dari-kotak",
 "title":"Menarik Kain dari Kotak Kosong",
 "summary":"Isi kotak tisu kosong dengan kain lembut yang ujungnya menonjol agar anak berlatih menarik dan mengeluarkan benda.",
 "ageBands":["3-6m"],
 "areas":["sensorial","movement"],
 "skills":["menarik","koordinasi tangan","sebab-akibat"],
 "objectives":["Melatih gerakan menarik dengan tangan","Mengenalkan hubungan tarikan dan hasil"],
 "materials":[{"name":"kotak tisu kosong","fromHome":True,"optional":False},{"name":"kain lembut besar","fromHome":True,"optional":False}],
 "prepMinutes":5,
 "durationMinutes":8,
 "prepLevel":"sedang",
 "presentation":[{"step":1,"text":"Masukkan kain lembut ke dalam kotak hingga ujungnya menonjol."},{"step":2,"text":"Tunjukkan ujung kain dan biarkan anak meraihnya."},{"step":3,"text":"Bantu anak menarik kain keluar perlahan."},{"step":4,"text":"Masukkan kembali dan ulangi bila anak masih tertarik."}],
 "controlOfError":"Bila kain tersangkut, anak akan berhenti menarik; gunakan kain yang cukup besar dan longgar.",
 "variations":["Gunakan beberapa kain berbeda warna","Ganti kotak dengan wadah plastik berlubang lebar"],
 "readySigns":["Anak bisa menggenggam kain","Anak tertarik menarik benda ke arahnya"],
