assert len(acts) == 30, len(acts)
ids = [a["id"] for a in acts]
assert len(set(ids)) == 30
titles = [a["title"] for a in acts]
assert len(set(titles)) == 30
allowed = {"practical-life","sensorial","language","math","culture","movement","grace-courtesy","self-care","art-music","outdoor"}
for a in acts:
    assert a["id"].startswith("36m-")
    assert len(a["title"]) >= 5
    assert len(a["summary"]) >= 30
    assert a["ageBands"] == ["3-6m"]
    assert 1 <= len(a["areas"]) <= 3 and set(a["areas"]) <= allowed
    assert a["skills"] and a["objectives"] and a["materials"]
    assert 0 <= a["prepMinutes"] <= 30
    assert 3 <= a["durationMinutes"] <= 60
    assert a["prepLevel"] in {"rendah","sedang","tinggi"}
    assert len(a["presentation"]) >= 2
    for i, p in enumerate(a["presentation"], 1):
        assert p["step"] == i
        assert len(p["text"]) >= 15
    assert a["controlOfError"]
    assert a["variations"] and a["readySigns"] and a["struggleSigns"]
    assert a["safetyNotes"] and all(len(s) > 0 for s in a["safetyNotes"])
    assert a["references"] and all(r.get("title") and r.get("url","").startswith("https://") for r in a["references"])

os.makedirs("content/parts", exist_ok=True)
with open("content/parts/act-3-6m.json","w",encoding="utf-8") as f:
    json.dump(acts, f, ensure_ascii=False, indent=2)
print("written", len(acts))
