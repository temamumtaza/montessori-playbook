+  {"id":"4-5y-mengamati-cuaca","title":"Mencatat Perubahan Cuaca","summary":"Anak mengamati langit, angin, dan suhu yang terasa lalu menandai catatan cuaca harian.","ageBands":["4-5y"],"areas":["culture","outdoor","language"],"skills":["pengamatan","kosakata alam","mencatat"],"objectives":["Membedakan beberapa kondisi cuaca","Menghubungkan pengamatan dengan simbol"],"materials":[{"name":"kartu cuaca bergambar","fromHome":true,"optional":false},{"name":"papan catatan dan krayon","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":8,"prepLevel":"rendah","presentation":[{"step":1,"text":"Ajak anak melihat langit dari tempat aman."},{"step":2,"text":"Tanyakan apakah terasa cerah, berawan, atau hujan."},{"step":3,"text":"Pilih simbol yang paling sesuai."},{"step":4,"text":"Catat pengamatan bersama."}],"controlOfError":"Anak dapat melihat kondisi langit untuk mengecek simbol.","variations":["Bandingkan catatan cuaca selama beberapa hari."],"readySigns":["Menyebut pengamatan tanpa mengarang detail."],"struggleSigns":["Menganggap cuaca hanya berdasarkan suasana hati."],"safetyNotes":["Amati dari tempat teduh; hindari berada di luar saat petir, panas terik, atau hujan deras."],"references":[{"title":"WHO Climate Change and Health","url":"https://www.who.int/news-room/fact-sheets/detail/climate-change-and-health"}]},
+  {"id":"4-5y-mengikuti-resep-sederhana","title":"Mengikuti Resep Tanpa Memasak","summary":"Anak mengurutkan gambar langkah membuat campuran sederhana dan mengukur bahan dengan bantuan orang dewasa.","ageBands":["4-5y"],"areas":["practical-life","math","language"],"skills":["mengikuti instruksi","urutan","pengukuran"],"objectives":["Mengikuti tiga sampai empat langkah","Mengenali takaran sederhana"],"materials":[{"name":"kartu resep bergambar","fromHome":true,"optional":false},{"name":"mangkuk dan sendok ukur","fromHome":true,"optional":false},{"name":"bahan aman siap makan","fromHome":true,"optional":false}],"prepMinutes":8,"durationMinutes":25,"prepLevel":"tinggi","presentation":[{"step":1,"text":"Susun kartu resep dari awal."},{"step":2,"text":"Ambil bahan sesuai gambar."},{"step":3,"text":"Ukur dan masukkan bahan satu per satu."},{"step":4,"text":"Aduk dengan gerakan perlahan."}],"controlOfError":"Kartu langkah dan sisa bahan membantu mengecek urutan.","variations":["Gunakan resep campuran buah atau yogurt tanpa kompor."],"readySigns":["Menunggu instruksi berikutnya dan mengukur dengan bantuan."],"struggleSigns":["Memasukkan semua bahan sekaligus atau mengabaikan kartu."],"safetyNotes":["Orang dewasa menangani pisau, panas, dan bahan yang berisiko alergi; cuci tangan sebelum mulai."],"references":[{"title":"WHO Five Keys to Safer Food","url":"https://www.who.int/teams/nutrition-and-food-safety/food-safety-and-zoonoses/five-keys-to-safer-food"}]},
+  {"id":"4-5y-puzzle-peta-tubuh","title":"Puzzle Bagian Tubuh","summary":"Anak menyusun gambar tubuh sederhana dan menyebut bagian yang terlihat dengan bahasa sehari-hari.","ageBands":["4-5y"],"areas":["culture","self-care","language"],"skills":["kosakata tubuh","kesadaran diri","pemecahan masalah"],"objectives":["Mengenali bagian tubuh utama","Menyusun gambar berdasarkan hubungan bagian"],"materials":[{"name":"puzzle tubuh dengan bagian besar","fromHome":true,"optional":false},{"name":"alas kerja","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":15,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan kepingan puzzle menghadap atas."},{"step":2,"text":"Cari kepingan bagian kepala dan badan."},{"step":3,"text":"Sambungkan bagian sesuai bentuknya."},{"step":4,"text":"Sebutkan bagian tubuh utama."}],"controlOfError":"Bentuk potongan tidak cocok jika posisinya keliru.","variations":["Gunakan gambar diri untuk membahas cara merawat tubuh."],"readySigns":["Mau bertanya tentang tubuh dengan nyaman dan tepat."],"struggleSigns":["Memaksa kepingan atau menyebut bagian tanpa melihat gambar."],"safetyNotes":["Gunakan puzzle berukuran besar tanpa potongan kecil dan ajarkan bahwa tubuh pribadi perlu dihormati."],"references":[{"title":"healthychildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
+  {"id":"4-5y-membuat-buku-mini","title":"Membuat Buku Mini","summary":"Anak melipat beberapa halaman, menggambar cerita, dan mendiktekan kalimat untuk buku mini miliknya.","ageBands":["4-5y"],"areas":["language","art-music"],"skills":["literasi awal","urutan cerita","motorik halus"],"objectives":["Menghubungkan gambar dan cerita","Mengenali awal, tengah, dan akhir"],"materials":[{"name":"empat lembar kertas dan sampul karton","fromHome":true,"optional":false},{"name":"krayon dan stapler","fromHome":true,"optional":false}],"prepMinutes":10,"durationMinutes":35,"prepLevel":"tinggi","presentation":[{"step":1,"text":"Lipat kertas dan satukan dengan bantuan dewasa."},{"step":2,"text":"Gambar kejadian pertama di halaman awal."},{"step":3,"text":"Tambahkan kejadian berikutnya hingga akhir."},{"step":4,"text":"Ceritakan isi buku dan beri judul."}],"controlOfError":"Urutan halaman dan cerita dapat dibaca ulang.","variations":["Orang dewasa menuliskan kalimat yang didiktekan anak."],"readySigns":["Mampu mempertahankan satu ide cerita beberapa halaman."],"struggleSigns":["Menggambar tanpa urutan atau kecewa pada tulisan yang belum rapi."],"safetyNotes":["Orang dewasa menangani stapler dan memastikan tidak ada ujung kawat terbuka."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"4-5y-mengatur-meja","title":"Mengatur Meja Makan","summary":"Anak menata alas, piring, gelas, dan sendok sesuai contoh sebelum waktu makan bersama.","ageBands":["4-5y"],"areas":["practical-life","grace-courtesy","self-care"],"skills":["urutan kerja","kemandirian","kepedulian bersama"],"objectives":["Menata perlengkapan sesuai tempatnya","Membawa benda dengan aman"],"materials":[{"name":"alas makan","fromHome":true,"optional":false},{"name":"piring dan gelas plastik","fromHome":true,"optional":false},{"name":"sendok dan serbet","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Bawa satu benda dengan dua tangan."},{"step":2,"text":"Letakkan alas di depan kursi."},{"step":3,"text":"Susun piring, sendok, gelas, dan serbet."},{"step":4,"text":"Periksa tempat makan sebelum memanggil keluarga."}],"controlOfError":"Contoh alas menunjukkan posisi setiap benda.","variations":["Minta anak menata satu tempat lalu dua tempat."],"readySigns":["Mengikuti urutan tanpa memindahkan benda sembarangan."],"struggleSigns":["Membawa terlalu banyak benda sekaligus atau menaruh gelas di tepi meja."],"safetyNotes":["Gunakan perlengkapan tidak mudah pecah dan jauhkan anak dari benda panas atau tajam."],"references":[{"title":"healthychildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]}
