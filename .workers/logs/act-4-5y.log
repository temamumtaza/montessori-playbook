+  {"id":"4-5y-mengikuti-ritme","title":"Meniru Pola Tepuk","summary":"Anak mendengarkan pola tepuk sederhana lalu menirukannya untuk melatih ritme dan perhatian.","ageBands":["4-5y"],"areas":["art-music","movement"],"skills":["ritme","pendengaran","ingatan"],"objectives":["Mendengar pola bunyi","Meniru urutan dengan jeda"],"materials":[{"name":"ruang tenang","fromHome":true,"optional":false},{"name":"drum atau wadah terbalik","fromHome":true,"optional":true}],"prepMinutes":2,"durationMinutes":8,"prepLevel":"rendah","presentation":[{"step":1,"text":"Minta anak duduk nyaman dan mendengar."},{"step":2,"text":"Tepuk pola dua atau tiga bunyi."},{"step":3,"text":"Beri jeda untuk anak menirukan."},{"step":4,"text":"Tambah satu bunyi jika sudah siap."}],"controlOfError":"Perbedaan pola dapat didengar bersama.","variations":["Gunakan tepuk-paha-tepuk atau alat musik sederhana."],"readySigns":["Menunggu pola selesai sebelum menirukan."],"struggleSigns":["Tepuk terus tanpa mendengarkan atau kehilangan urutan."],"safetyNotes":["Jaga volume tetap nyaman dan hindari alat musik yang terlalu keras."],"references":[{"title":"healthychildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
