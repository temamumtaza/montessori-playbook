+[
+  {"id":"4-5y-menuang-air","title":"Menuang Air Tepat Sasaran","summary":"Anak berlatih menuang air dengan tenang dari satu wadah ke wadah lain.","ageBands":["4-5y"],"areas":["practical-life","movement"],"skills":["koordinasi tangan","konsentrasi","kemandirian"],"objectives":["Mengontrol gerakan menuang","Menjaga meja tetap rapi"],"materials":[{"name":"teko kecil","fromHome":true,"optional":false},{"name":"dua gelas dan nampan","fromHome":true,"optional":false},{"name":"kain lap","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan dua gelas dan teko di atas nampan."},{"step":2,"text":"Pegang gagang teko dengan dua tangan."},{"step":3,"text":"Tuang perlahan sampai batas yang ditentukan."},{"step":4,"text":"Kembalikan teko dan lap tetesan air."}],"controlOfError":"Air yang tumpah terlihat di nampan.","variations":["Gunakan corong atau gelas berukuran berbeda."],"readySigns":["Mampu membawa nampan dengan hati-hati."],"struggleSigns":["Menuang terlalu cepat atau menggenggam wadah terlalu kuat."],"safetyNotes":["Gunakan air suhu ruang dan wadah yang tidak mudah pecah."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"4-5y-menjepit-pom-pom","title":"Memindahkan Pom-Pom dengan Jepit","summary":"Anak memindahkan benda kecil memakai jepit untuk melatih ketelitian dan kendali tangan.","ageBands":["4-5y"],"areas":["practical-life","movement"],"skills":["kekuatan jari","koordinasi mata-tangan","ketelitian"],"objectives":["Menguatkan gerak menjepit","Memindahkan benda tanpa menjatuhkannya"],"materials":[{"name":"jepit dapur kecil","fromHome":true,"optional":false},{"name":"pom-pom besar","fromHome":true,"optional":false},{"name":"dua mangkuk","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":8,"prepLevel":"rendah","presentation":[{"step":1,"text":"Isi satu mangkuk dengan pom-pom besar."},{"step":2,"text":"Tekan jepit dengan ibu jari dan jari."},{"step":3,"text":"Angkat satu pom-pom lalu pindahkan."}],"controlOfError":"Pom-pom yang jatuh mudah terlihat.","variations":["Pindahkan berdasarkan warna atau hitung jumlahnya."],"readySigns":["Membuka dan menutup jepit dengan terarah."],"struggleSigns":["Jari cepat lelah atau benda sering terlepas."],"safetyNotes":["Selalu dampingi dan pilih pom-pom yang cukup besar agar tidak mudah tertelan."],"references":[{"title":"healthychildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
+  {"id":"4-5y-melipat-serbet","title":"Melipat Serbet Menjadi Bentuk","summary":"Anak mengikuti garis lipatan sederhana sambil merawat serbet untuk digunakan bersama.","ageBands":["4-5y"],"areas":["practical-life","grace-courtesy"],"skills":["urutan langkah","koordinasi tangan","merawat lingkungan"],"objectives":["Mengikuti garis dan sudut","Menyiapkan serbet dengan rapi"],"materials":[{"name":"serbet kain","fromHome":true,"optional":false},{"name":"keranjang kecil","fromHome":true,"optional":false}],"prepMinutes":2,"durationMinutes":7,"prepLevel":"rendah","presentation":[{"step":1,"text":"Bentangkan serbet di atas meja."},{"step":2,"text":"Satukan dua sudut yang berhadapan."},{"step":3,"text":"Ratakan lipatan dengan telapak tangan."},{"step":4,"text":"Simpan serbet di keranjang."}],"controlOfError":"Sudut tidak bertemu atau lipatan tampak miring.","variations":["Coba lipatan segitiga lalu lipatan persegi."],"readySigns":["Dapat mengikuti contoh tanpa terburu-buru."],"struggleSigns":["Kesulitan menyelaraskan sudut serbet."],"safetyNotes":["Gunakan meja datar dan serbet bersih tanpa aksesori kecil."],"references":[{"title":"NHS Child Development","url":"https://www.nhs.uk/conditions/baby/babys-development/play-and-learning/"}]},
+  {"id":"4-5y-mengancing-boneka","title":"Membuka dan Mengancing Baju Boneka","summary":"Anak melatih kemandirian berpakaian melalui kegiatan mengancing dengan tempo yang nyaman.","ageBands":["4-5y"],"areas":["self-care","practical-life"],"skills":["kemandirian berpakaian","koordinasi jari","ketekunan"],"objectives":["Memasukkan kancing ke lubang","Mengenali urutan membuka dan menutup"],"materials":[{"name":"boneka berbaju kancing besar","fromHome":true,"optional":false}],"prepMinutes":2,"durationMinutes":12,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan boneka menghadap anak."},{"step":2,"text":"Pegang kancing dengan dua jari."},{"step":3,"text":"Masukkan kancing melalui lubang perlahan."},{"step":4,"text":"Tarik kain hingga kancing rata."}],"controlOfError":"Kancing tetap terbuka jika belum masuk sempurna.","variations":["Mulai dengan satu kancing lalu tambah jumlahnya."],"readySigns":["Mencoba lagi setelah kancing terlepas."],"struggleSigns":["Menarik kain terlalu keras atau meminta bantuan segera."],"safetyNotes":["Pilih kancing besar yang terpasang kuat dan selalu awasi."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"4-5y-mengurutkan-panjang","title":"Mengurutkan Pita dari Pendek ke Panjang","summary":"Anak membandingkan panjang beberapa pita dan menyusunnya dari yang terpendek.","ageBands":["4-5y"],"areas":["sensorial","math"],"skills":["perbandingan panjang","pengamatan","urutan"],"objectives":["Membedakan panjang benda","Menyusun urutan dari pendek ke panjang"],"materials":[{"name":"lima pita dengan panjang berbeda","fromHome":true,"optional":false},{"name":"alas kerja","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":15,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan semua pita secara acak."},{"step":2,"text":"Cari pita yang paling pendek."},{"step":3,"text":"Susun pita berikutnya di sampingnya."},{"step":4,"text":"Periksa urutan sampai pita terpanjang."}],"controlOfError":"Ujung pita dapat disejajarkan untuk memeriksa urutan.","variations":["Urutkan dari terpanjang ke terpendek."],"readySigns":["Mengecek pita dengan menyamakan salah satu ujung."],"struggleSigns":["Membandingkan hanya dari warna atau mengganti urutan tanpa memeriksa."],"safetyNotes":["Gunakan pita pendek dan simpan gunting jauh dari jangkauan saat kegiatan."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"4-5y-mencari-benda-berat","title":"Membandingkan Berat Benda","summary":"Anak merasakan perbedaan berat benda sehari-hari lalu mengelompokkannya secara sederhana.","ageBands":["4-5y"],"areas":["sensorial","math"],"skills":["berat-ringan","pengamatan","bahasa perbandingan"],"objectives":["Membandingkan berat dengan tangan","Menggunakan kata lebih berat dan lebih ringan"],"materials":[{"name":"enam benda aman berukuran serupa","fromHome":true,"optional":false},{"name":"dua keranjang","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":12,"prepLevel":"sedang","presentation":[{"step":1,"text":"Pilih dua benda yang aman diangkat."},{"step":2,"text":"Angkat bergantian dengan dua tangan."},{"step":3,"text":"Ucapkan benda lebih berat atau ringan."},{"step":4,"text":"Kelompokkan benda berdasarkan hasilnya."}],"controlOfError":"Timbangan sederhana dapat dipakai untuk mengecek.","variations":["Gunakan neraca gantung untuk membandingkan dua benda."],"readySigns":["Mengangkat benda dengan kedua tangan dan mengamati perbedaannya."],"struggleSigns":["Mengira benda lebih besar selalu lebih berat."],"safetyNotes":["Hindari benda tajam, panas, berat, atau mudah pecah."],"references":[{"title":"NHS Child Development","url":"https://www.nhs.uk/conditions/baby/babys-development/play-and-learning/"}]},
+  {"id":"4-5y-mencocokkan-suara","title":"Mencocokkan Pasangan Suara","summary":"Anak mendengarkan bunyi dari wadah tertutup dan mencari dua wadah yang bersuara sama.","ageBands":["4-5y"],"areas":["sensorial","music"],"skills":["pendengaran","ingatan kerja","pencocokan"],"objectives":["Membedakan intensitas bunyi","Mencari pasangan berdasarkan suara"],"materials":[{"name":"enam wadah tertutup berpasangan","fromHome":true,"optional":false},{"name":"isi beras, pasta, dan kancing besar","fromHome":true,"optional":false}],"prepMinutes":10,"durationMinutes":15,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan wadah tertutup dalam satu baris."},{"step":2,"text":"Kocok satu wadah dekat telinga."},{"step":3,"text":"Cari wadah lain dengan bunyi serupa."},{"step":4,"text":"Ulangi sampai semua berpasangan."}],"controlOfError":"Pasangan diberi tanda kecil di bagian bawah.","variations":["Gunakan tiga tingkat bunyi dari pelan ke keras."],"readySigns":["Mendengarkan sebelum memilih pasangan."],"struggleSigns":["Mengandalkan warna atau menebak tanpa menggoyang."],"safetyNotes":["Rekatkan tutup kuat-kuat dan gunakan isi yang tidak mudah tertelan."],"references":[{"title":"healthychildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
+  {"id":"4-5y-meronce-pola","title":"Meronce Manik dengan Pola","summary":"Anak meronce manik besar mengikuti pola warna sambil melatih fokus dan koordinasi.","ageBands":["4-5y"],"areas":["sensorial","art-music","math"],"skills":["pola","koordinasi mata-tangan","konsentrasi"],"objectives":["Meniru pola berulang","Menguatkan koordinasi kedua tangan"],"materials":[{"name":"manik-manik besar","fromHome":true,"optional":false},{"name":"tali ujung kaku","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":20,"prepLevel":"sedang","presentation":[{"step":1,"text":"Buat contoh pola dua warna."},{"step":2,"text":"Pilih manik sesuai urutan pola."},{"step":3,"text":"Masukkan manik satu per satu."},{"step":4,"text":"Sebutkan pola setelah selesai."}],"controlOfError":"Pola contoh menjadi pembanding visual.","variations":["Buat pola AAB atau ABC dengan tiga warna."],"readySigns":["Dapat mengulang pola tanpa terus melihat contoh."],"struggleSigns":["Melewati urutan atau memasukkan manik terlalu cepat."],"safetyNotes":["Gunakan manik besar dan dampingi agar tidak dimasukkan ke mulut."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"4-5y-menggambar-bentuk","title":"Menjiplak dan Menggambar Bentuk","summary":"Anak mengamati bentuk dasar lalu menjiplak dan menggambarnya dengan garis sendiri.","ageBands":["4-5y"],"areas":["sensorial","art-music"],"skills":["bentuk geometri","kontrol pensil","pengamatan"],"objectives":["Mengenali lingkaran, persegi, dan segitiga","Menggambar mengikuti batas sederhana"],"materials":[{"name":"kartu bentuk","fromHome":true,"optional":false},{"name":"kertas dan krayon","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":15,"prepLevel":"rendah","presentation":[{"step":1,"text":"Pilih satu kartu bentuk untuk diamati."},{"step":2,"text":"Telusuri tepinya dengan jari."},{"step":3,"text":"Jiplak bentuk memakai krayon."},{"step":4,"text":"Gambar bentuk tanpa kartu."}],"controlOfError":"Bentuk contoh membantu anak membandingkan gambar.","variations":["Gabungkan bentuk menjadi rumah atau kendaraan."],"readySigns":["Memegang krayon dengan cukup stabil."],"struggleSigns":["Menekan terlalu kuat atau cepat kehilangan minat."],"safetyNotes":["Gunakan krayon tidak beracun dan area yang mudah dibersihkan."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"4-5y-mengurutkan-kartu-cerita","title":"Mengurutkan Kartu Cerita","summary":"Anak menyusun gambar kejadian dari awal sampai akhir lalu menceritakan urutannya.","ageBands":["4-5y"],"areas":["language","culture"],"skills":["urutan cerita","kosakata","bercerita"],"objectives":["Memahami awal-tengah-akhir","Menceritakan hubungan antarperistiwa"],"materials":[{"name":"empat kartu gambar berurutan","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":12,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan kartu secara acak."},{"step":2,"text":"Cari gambar yang terjadi pertama."},{"step":3,"text":"Susun kartu hingga kejadian terakhir."},{"step":4,"text":"Ceritakan urutan dengan kalimat sendiri."}],"controlOfError":"Alur gambar memberikan petunjuk urutan.","variations":["Minta anak menggambar satu kartu akhir baru."],"readySigns":["Menggunakan kata lalu, setelah itu, dan akhirnya."],"struggleSigns":["Menyebut gambar tanpa menghubungkan peristiwa."],"safetyNotes":["Pastikan kartu tidak memiliki sudut tajam atau bagian kecil yang mudah lepas."],"references":[{"title":"NHS Child Development","url":"https://www.nhs.uk/conditions/baby/babys-development/play-and-learning/"}]},
+  {"id":"4-5y-menghubungkan-huruf-bunyi","title":"Mencari Benda Awal Bunyi","summary":"Anak mendengar bunyi awal sebuah kata lalu memasangkan benda dengan kartu hurufnya.","ageBands":["4-5y"],"areas":["language"],"skills":["kesadaran bunyi","kosakata","pencocokan huruf"],"objectives":["Mengenali bunyi awal kata","Menghubungkan bunyi dengan simbol huruf"],"materials":[{"name":"benda mini atau gambar sederhana","fromHome":true,"optional":false},{"name":"kartu huruf","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":15,"prepLevel":"sedang","presentation":[{"step":1,"text":"Pilih benda dan ucapkan namanya perlahan."},{"step":2,"text":"Tekankan bunyi awal kata tersebut."},{"step":3,"text":"Cari kartu huruf yang sesuai."},{"step":4,"text":"Ulangi dengan dua benda lain."}],"controlOfError":"Kartu gambar dan bunyi awal menjadi petunjuk.","variations":["Mulai dengan dua bunyi yang sangat berbeda."],"readySigns":["Mampu mengulang bunyi awal tanpa menyebut seluruh kata."],"struggleSigns":["Mengandalkan nama huruf saja tanpa mendengar bunyi."],"safetyNotes":["Pilih benda berukuran cukup besar dan hindari benda kecil yang mudah tertelan."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"4-5y-menulis-nama","title":"Menulis Nama dengan Kartu Panduan","summary":"Anak mengenali huruf dalam namanya dan mencoba menuliskannya dengan dukungan kartu.","ageBands":["4-5y"],"areas":["language","self-care"],"skills":["pengenalan huruf","menulis awal","kepercayaan diri"],"objectives":["Mengenali urutan huruf nama","Menyalin nama secara bertahap"],"materials":[{"name":"kartu nama anak","fromHome":true,"optional":false},{"name":"papan tulis kecil dan spidol","fromHome":true,"optional":false}],"prepMinutes":2,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan kartu nama di dekat papan."},{"step":2,"text":"Telusuri satu huruf dari atas ke bawah."},{"step":3,"text":"Salin huruf berikutnya dengan perlahan."},{"step":4,"text":"Baca nama bersama-sama."}],"controlOfError":"Kartu nama menjadi contoh visual yang dapat dicek.","variations":["Tulis nama dengan huruf magnet atau pasir."],"readySigns":["Mencari huruf yang sama pada kartu dan tulisannya."],"struggleSigns":["Menghapus berulang kali karena mengejar bentuk sempurna."],"safetyNotes":["Gunakan spidol tidak beracun dan sediakan permukaan yang mudah dibersihkan."],"references":[{"title":"healthychildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
