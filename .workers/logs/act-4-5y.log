+  {"id":"4-5y-memindahkan-bola-sendok","title":"Membawa Bola dengan Sendok","summary":"Anak berjalan pelan sambil menjaga bola tetap di atas sendok untuk melatih keseimbangan tubuh.","ageBands":["4-5y"],"areas":["movement","grace-courtesy"],"skills":["keseimbangan","kontrol gerak","ketekunan"],"objectives":["Mengatur kecepatan berjalan","Menjaga benda tetap stabil"],"materials":[{"name":"sendok besar","fromHome":true,"optional":false},{"name":"bola kain atau pom-pom besar","fromHome":true,"optional":false},{"name":"dua penanda lantai","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan bola di atas sendok."},{"step":2,"text":"Pegang sendok dengan satu tangan."},{"step":3,"text":"Berjalan pelan menuju penanda."},{"step":4,"text":"Berbalik dan kembali tanpa berlari."}],"controlOfError":"Bola jatuh jika gerakan terlalu cepat atau tidak seimbang.","variations":["Buat jalur berbelok atau gunakan dua tangan untuk pemula."],"readySigns":["Memperlambat langkah saat bola bergoyang."],"struggleSigns":["Berlari atau sering melihat kaki sehingga menabrak."],"safetyNotes":["Gunakan bola ringan dan lakukan di lantai bebas hambatan."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"4-5y-lompat-pola","title":"Melompat Mengikuti Pola","summary":"Anak mengikuti pola lompatan di lantai sambil mengingat arah dan giliran geraknya.","ageBands":["4-5y"],"areas":["movement"],"skills":["keseimbangan","memori gerak","koordinasi"],"objectives":["Mengikuti urutan gerakan","Mendarat dengan kontrol"],"materials":[{"name":"pita kertas untuk pola lantai","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":12,"prepLevel":"sedang","presentation":[{"step":1,"text":"Buat pola kotak atau garis di lantai."},{"step":2,"text":"Tunjukkan lompatan satu kaki dan dua kaki."},{"step":3,"text":"Ikuti pola dari awal sampai akhir."},{"step":4,"text":"Berhenti setelah melewati garis akhir."}],"controlOfError":"Garis lantai menunjukkan urutan dan tempat mendarat.","variations":["Tambahkan tepuk tangan pada kotak tertentu."],"readySigns":["Mendarat dengan lutut rileks dan tetap seimbang."],"struggleSigns":["Mendarat terlalu keras atau melompati urutan."],"safetyNotes":["Gunakan permukaan tidak licin dan beri ruang bebas di sekitarnya."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"4-5y-berjalan-garis","title":"Berjalan di Atas Garis","summary":"Anak berjalan perlahan mengikuti garis lurus, melatih keseimbangan dan kesadaran ruang.","ageBands":["4-5y"],"areas":["movement","grace-courtesy"],"skills":["keseimbangan","kontrol tubuh","kesadaran ruang"],"objectives":["Menjaga langkah pada jalur","Berhenti dan mulai dengan tenang"],"materials":[{"name":"pita lantai atau kapur","fromHome":true,"optional":false},{"name":"benda kecil sebagai titik berhenti","fromHome":true,"optional":true}],"prepMinutes":3,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Buat garis lurus yang cukup panjang."},{"step":2,"text":"Letakkan satu kaki di depan kaki lain."},{"step":3,"text":"Berjalan mengikuti garis perlahan."},{"step":4,"text":"Berhenti di titik akhir dengan tenang."}],"controlOfError":"Kaki yang keluar garis mudah terlihat.","variations":["Bawa bendera kecil atau berjalan mengikuti garis melengkung."],"readySigns":["Melihat ke depan sambil menjaga langkah."],"struggleSigns":["Berjalan terlalu cepat atau keluar jalur berulang kali."],"safetyNotes":["Pastikan pita tidak membuat lantai licin dan singkirkan penghalang."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
