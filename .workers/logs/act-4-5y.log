+  {"id":"4-5y-menanam-biji","title":"Menanam Biji dalam Pot","summary":"Anak menyiapkan tanah, menanam biji, dan merawatnya dengan pengamatan singkat setiap hari.","ageBands":["4-5y"],"areas":["culture","outdoor","practical-life"],"skills":["merawat tanaman","urutan kerja","pengamatan"],"objectives":["Mengikuti langkah menanam","Mengamati perubahan makhluk hidup"],"materials":[{"name":"pot kecil berlubang","fromHome":true,"optional":false},{"name":"tanah dan biji kacang","fromHome":true,"optional":false},{"name":"sendok dan air","fromHome":true,"optional":false}],"prepMinutes":10,"durationMinutes":30,"prepLevel":"sedang","presentation":[{"step":1,"text":"Isi pot dengan tanah secukupnya."},{"step":2,"text":"Buat lubang kecil dengan jari."},{"step":3,"text":"Masukkan biji dan tutup tipis."},{"step":4,"text":"Siram sedikit lalu letakkan di tempat terang."}],"controlOfError":"Tanah terlalu kering atau terlalu basah tampak saat diamati.","variations":["Buat jurnal gambar pertumbuhan tanaman."],"readySigns":["Mengingat menyiram dengan jumlah sedikit."],"struggleSigns":["Menggali biji terus-menerus atau menyiram terlalu banyak."],"safetyNotes":["Cuci tangan setelah menyentuh tanah dan jangan gunakan biji beracun."],"references":[{"title":"WHO Five Keys to Safer Food","url":"https://www.who.int/teams/nutrition-and-food-safety/food-safety-and-zoonoses/five-keys-to-safer-food"}]},
