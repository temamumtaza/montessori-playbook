+  {"id":"4-5y-membuat-boneka-kertas","title":"Membuat Boneka Kertas Sederhana","summary":"Anak menggambar wajah, menghias, dan menggerakkan boneka kertas untuk bercerita singkat.","ageBands":["4-5y"],"areas":["art-music","language"],"skills":["imajinasi","motorik halus","bercerita"],"objectives":["Mengikuti urutan membuat karya","Menggunakan karya untuk menyampaikan cerita"],"materials":[{"name":"kantong kertas atau karton","fromHome":true,"optional":false},{"name":"krayon dan lem","fromHome":true,"optional":false},{"name":"potongan kertas besar","fromHome":true,"optional":true}],"prepMinutes":8,"durationMinutes":30,"prepLevel":"sedang","presentation":[{"step":1,"text":"Pilih tokoh untuk boneka kertas."},{"step":2,"text":"Gambar mata, mulut, dan rambut."},{"step":3,"text":"Tempel hiasan dengan lem secukupnya."},{"step":4,"text":"Gerakkan boneka sambil bercerita."}],"controlOfError":"Bagian karya dapat diperiksa sebelum lem mengering.","variations":["Buat dua tokoh lalu lakukan percakapan."],"readySigns":["Mampu menjelaskan tokoh yang dibuat."],"struggleSigns":["Menempel tanpa rencana atau sulit memulai cerita."],"safetyNotes":["Orang dewasa membantu memotong bahan; gunakan lem dan spidol tidak beracun."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"4-5y-mengupas-telur-rebus","title":"Mengupas Telur Rebus","summary":"Anak mengupas telur rebus dengan perlahan lalu membersihkan kulitnya untuk melatih kemandirian makan.","ageBands":["4-5y"],"areas":["practical-life","self-care"],"skills":["kemandirian makan","koordinasi jari","kebersihan"],"objectives":["Mengupas dengan gerakan terarah","Membuang sisa pada tempatnya"],"materials":[{"name":"telur rebus yang sudah dingin","fromHome":true,"optional":false},{"name":"mangkuk dan alas","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Cuci tangan sebelum mulai bekerja."},{"step":2,"text":"Ketukkan telur perlahan hingga retak."},{"step":3,"text":"Kelupas kulit sedikit demi sedikit."},{"step":4,"text":"Letakkan kulit pada mangkuk sisa."}],"controlOfError":"Kulit yang tersisa terlihat pada permukaan telur.","variations":["Potong telur dengan alat yang aman bersama orang dewasa."],"readySigns":["Bekerja perlahan tanpa meremas telur."],"struggleSigns":["Mengupas terlalu kuat atau mencampur kulit dengan makanan."],"safetyNotes":["Gunakan telur yang disimpan dengan aman dan pastikan anak duduk saat makan."],"references":[{"title":"WHO Five Keys to Safer Food","url":"https://www.who.int/teams/nutrition-and-food-safety/food-safety-and-zoonoses/five-keys-to-safer-food"}]},
+  {"id":"4-5y-menyiapkan-camilan","title":"Menyiapkan Camilan Buah","summary":"Anak mencuci buah, menyusun potongan yang sudah disiapkan, lalu membereskan area makan.","ageBands":["4-5y"],"areas":["practical-life","self-care"],"skills":["kebersihan diri","urutan kerja","kemandirian"],"objectives":["Mengikuti langkah menyiapkan makanan","Menata dan membereskan tempat makan"],"materials":[{"name":"buah yang sudah dipotong orang dewasa","fromHome":true,"optional":false},{"name":"piring dan penjepit makanan besar","fromHome":true,"optional":false},{"name":"serbet","fromHome":true,"optional":false}],"prepMinutes":8,"durationMinutes":15,"prepLevel":"sedang","presentation":[{"step":1,"text":"Cuci tangan dan siapkan piring."},{"step":2,"text":"Ambil potongan buah dengan penjepit."},{"step":3,"text":"Susun buah di piring dengan rapi."},{"step":4,"text":"Bawa piring dan lap meja setelah makan."}],"controlOfError":"Buah yang jatuh atau meja basah terlihat dan dapat dibereskan.","variations":["Buat pola warna sederhana di piring."],"readySigns":["Mengingat cuci tangan sebelum dan sesudah kegiatan."],"struggleSigns":["Mengambil terlalu banyak atau membawa piring sambil berlari."],"safetyNotes":["Orang dewasa mencuci dan memotong buah; hindari potongan bulat keras yang mudah tersedak."],"references":[{"title":"WHO Five Keys to Safer Food","url":"https://www.who.int/teams/nutrition-and-food-safety/food-safety-and-zoonoses/five-keys-to-safer-food"}]},
+  {"id":"4-5y-memilah-sampah","title":"Memilah Sampah Rumah Tangga","summary":"Anak memilah contoh sampah bersih ke tempat kertas, plastik, dan sisa makanan dengan bimbingan.","ageBands":["4-5y"],"areas":["culture","practical-life"],"skills":["kepedulian lingkungan","klasifikasi","tanggung jawab"],"objectives":["Mengenali beberapa jenis sampah","Membuang benda pada tempat yang sesuai"],"materials":[{"name":"tiga wadah berlabel gambar","fromHome":true,"optional":false},{"name":"contoh sampah bersih dan aman","fromHome":true,"optional":false}],"prepMinutes":8,"durationMinutes":15,"prepLevel":"sedang","presentation":[{"step":1,"text":"Tunjukkan label pada setiap wadah."},{"step":2,"text":"Ambil satu contoh sampah bersih."},{"step":3,"text":"Pilih wadah berdasarkan bahannya."},{"step":4,"text":"Cuci tangan setelah semua selesai."}],"controlOfError":"Label gambar membantu anak mengecek pilihannya.","variations":["Tambahkan kegiatan memakai ulang kardus untuk karya."],"readySigns":["Menyebut alasan memilih wadah tertentu."],"struggleSigns":["Memasukkan benda tanpa melihat label atau menyentuh sampah kotor."],"safetyNotes":["Hanya gunakan sampah bersih; hindari kaca, logam tajam, baterai, dan bahan kimia."],"references":[{"title":"WHO Five Keys to Safer Food","url":"https://www.who.int/teams/nutrition-and-food-safety/food-safety-and-zoonoses/five-keys-to-safer-food"}]},
+  {"id":"4-5y-latihan-menyapa","title":"Latihan Menyapa dan Meminta Tolong","summary":"Anak bermain peran menyapa, meminta bantuan, dan mengucapkan terima kasih dalam situasi sehari-hari.","ageBands":["4-5y"],"areas":["grace-courtesy","language"],"skills":["sopan santun","komunikasi","bergiliran"],"objectives":["Menggunakan kalimat sopan","Mendengarkan dan merespons lawan bicara"],"materials":[{"name":"dua kursi","fromHome":true,"optional":false},{"name":"benda peran seperti tas atau buku","fromHome":true,"optional":true}],"prepMinutes":3,"durationMinutes":12,"prepLevel":"rendah","presentation":[{"step":1,"text":"Tunjukkan cara menatap dan menyapa."},{"step":2,"text":"Peragakan meminta bantuan dengan kalimat jelas."},{"step":3,"text":"Tunggu jawaban tanpa memotong."},{"step":4,"text":"Ucapkan terima kasih lalu bertukar peran."}],"controlOfError":"Lawan bicara dapat mengulang jika pesan belum jelas.","variations":["Latih meminta izin meminjam benda atau bergabung bermain."],"readySigns":["Mau mencoba kalimat sopan tanpa dipaksa."],"struggleSigns":["Menirukan kata tanpa memahami giliran percakapan."],"safetyNotes":["Jelaskan bahwa anak boleh berkata tidak dan mencari orang dewasa jika merasa tidak aman."],"references":[{"title":"healthychildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]}
