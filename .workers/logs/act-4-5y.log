+  {"id":"4-5y-membandingkan-jumlah","title":"Membandingkan Dua Kelompok","summary":"Anak memasangkan benda dari dua kelompok untuk melihat mana yang lebih banyak atau sama.","ageBands":["4-5y"],"areas":["math","sensorial"],"skills":["lebih banyak","lebih sedikit","sama banyak"],"objectives":["Membandingkan jumlah secara visual","Menggunakan bahasa kuantitas"],"materials":[{"name":"dua jenis benda penghitung besar","fromHome":true,"optional":false},{"name":"dua alas","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Buat dua baris benda."},{"step":2,"text":"Pasangkan benda dari kiri ke kanan."},{"step":3,"text":"Amati baris yang tersisa."},{"step":4,"text":"Ucapkan mana lebih banyak atau sama."}],"controlOfError":"Benda yang tidak memiliki pasangan terlihat jelas.","variations":["Minta anak membuat dua kelompok yang sama banyak."],"readySigns":["Menggunakan pasangan, bukan hanya ukuran barisan."],"struggleSigns":["Mengira baris lebih panjang selalu lebih banyak."],"safetyNotes":["Pilih benda cukup besar dan pastikan lantai bebas dari benda yang dapat membuat tersandung."],"references":[{"title":"NHS Child Development","url":"https://www.nhs.uk/conditions/baby/babys-development/play-and-learning/"}]},
+  {"id":"4-5y-mengukur-dengan-balok","title":"Mengukur Meja dengan Balok","summary":"Anak mengukur panjang benda memakai balok yang disusun rapat dan menyebut hasil pengukurannya.","ageBands":["4-5y"],"areas":["math","movement"],"skills":["pengukuran nonstandar","urutan","ketelitian"],"objectives":["Meletakkan satuan tanpa celah","Membandingkan hasil pengukuran"],"materials":[{"name":"balok berukuran sama","fromHome":true,"optional":false},{"name":"benda panjang yang aman","fromHome":true,"optional":false},{"name":"kartu catatan","fromHome":true,"optional":true}],"prepMinutes":5,"durationMinutes":20,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan balok di ujung benda."},{"step":2,"text":"Susun balok rapat tanpa celah."},{"step":3,"text":"Hitung balok sampai ujung lainnya."},{"step":4,"text":"Sebutkan panjang dalam balok."}],"controlOfError":"Celah atau balok yang tumpang tindih mudah terlihat.","variations":["Ukur dua benda lalu bandingkan hasilnya."],"readySigns":["Menyusun balok dari titik awal yang sama."],"struggleSigns":["Meninggalkan celah atau memakai balok tidak seragam."],"safetyNotes":["Gunakan balok ringan dan ukur di lantai atau meja yang stabil."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"4-5y-mencocokkan-uang-mainan","title":"Bermain Toko dengan Uang Mainan","summary":"Anak bermain peran membeli barang sambil mencocokkan angka harga dan jumlah uang mainan.","ageBands":["4-5y"],"areas":["math","grace-courtesy"],"skills":["angka","bermain peran","percakapan"],"objectives":["Mengenali angka pada harga","Berlatih giliran sebagai penjual dan pembeli"],"materials":[{"name":"uang mainan besar","fromHome":true,"optional":false},{"name":"benda rumah tangga sebagai barang toko","fromHome":true,"optional":false},{"name":"label harga 1-10","fromHome":true,"optional":false}],"prepMinutes":10,"durationMinutes":25,"prepLevel":"tinggi","presentation":[{"step":1,"text":"Susun barang dan label harga."},{"step":2,"text":"Pilih satu barang untuk dibeli."},{"step":3,"text":"Cari uang sesuai label harga."},{"step":4,"text":"Ucapkan terima kasih dan bertukar peran."}],"controlOfError":"Label harga menjadi petunjuk jumlah uang.","variations":["Gunakan keranjang dan daftar belanja bergambar."],"readySigns":["Dapat menunggu giliran dan mengikuti aturan peran."],"struggleSigns":["Mengambil semua barang atau sulit berpindah peran."],"safetyNotes":["Gunakan uang mainan besar tanpa bagian kecil yang mudah lepas."],"references":[{"title":"healthychildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
+  {"id":"4-5y-menanam-biji","title":"Menanam Biji dalam Pot","summary":"Anak menyiapkan tanah, menanam biji, dan merawatnya dengan pengamatan singkat setiap hari.","ageBands":["4-5y"],"areas":["culture","outdoor","practical-life"],"skills":["merawat tanaman","urutan kerja","pengamatan"],"objectives":["Mengikuti langkah menanam","Mengamati perubahan makhluk hidup"],"materials":[{"name":"pot kecil berlubang","fromHome":true,"optional":false},{"name":"tanah dan biji kacang","fromHome":true,"optional":false},{"name":"sendok dan air","fromHome":true,"optional":false}],"prepMinutes":10,"durationMinutes":30,"prepLevel":"sedang","presentation":[{"step":1,"text":"Isi pot dengan tanah secukupnya."},{"step":2,"text":"Buat lubang kecil dengan jari."},{"step":3,"text":"Masukkan biji dan tutup tipis."},{"step":4,"text":"Siram sedikit lalu letakkan di tempat terang."}],"controlOfError":"Tanah terlalu kering atau terlalu basah tampak saat diamati.","variations":["Buat jurnal gambar pertumbuhan tanaman."],"readySigns":["Mengingat menyiram dengan jumlah sedikit."],"struggleSigns":["Menggali biji terus-menerus atau menyiram terlalu banyak."],"safetyNotes":["Cuci tangan setelah menyentuh tanah dan jangan gunakan biji beracun."],"references":[{"title":"WHO Five Keys to Safer Food","url":"https://www.who.int/teams/nutrition-and-food-safety/food-safety-and-zoonoses/five-keys-to-safer-food"}]},
+  {"id":"4-5y-mengamati-daun","title":"Mengamati dan Mengelompokkan Daun","summary":"Anak mengumpulkan daun yang jatuh, mengamati cirinya, lalu mengelompokkannya tanpa merusak tanaman.","ageBands":["4-5y"],"areas":["culture","outdoor","sensorial"],"skills":["pengamatan alam","klasifikasi","kosakata"],"objectives":["Membandingkan bentuk dan tekstur daun","Menunjukkan sikap merawat alam"],"materials":[{"name":"daun yang sudah jatuh","fromHome":false,"optional":false},{"name":"nampan atau alas","fromHome":true,"optional":false},{"name":"kaca pembesar","fromHome":true,"optional":true}],"prepMinutes":5,"durationMinutes":20,"prepLevel":"rendah","presentation":[{"step":1,"text":"Ambil hanya daun yang sudah jatuh."},{"step":2,"text":"Amati warna, bentuk, dan permukaannya."},{"step":3,"text":"Kelompokkan daun berdasarkan satu ciri."},{"step":4,"text":"Kembalikan daun ke tanah setelah selesai."}],"controlOfError":"Ciri yang dipilih menjadi aturan kelompok.","variations":["Buat gosokan tekstur daun dengan krayon."],"readySigns":["Mengamati tanpa memetik daun dari tanaman."],"struggleSigns":["Mencampur aturan kelompok atau meremas daun."],"safetyNotes":["Hindari daun yang tidak dikenal, bergetah, atau berjamur; cuci tangan setelah kegiatan."],"references":[{"title":"NHS Child Development","url":"https://www.nhs.uk/conditions/baby/babys-development/play-and-learning/"}]},
+  {"id":"4-5y-jejak-bentuk-alam","title":"Mencari Jejak Bentuk di Luar","summary":"Anak berburu bentuk lingkaran, segitiga, dan persegi di lingkungan sekitar dengan panduan sederhana.","ageBands":["4-5y"],"areas":["outdoor","sensorial","movement"],"skills":["mengenali bentuk","orientasi ruang","berjalan aman"],"objectives":["Menemukan bentuk pada benda nyata","Mengikuti batas area berjalan"],"materials":[{"name":"kartu pencarian bentuk","fromHome":true,"optional":false},{"name":"papan alas dan krayon","fromHome":true,"optional":true}],"prepMinutes":5,"durationMinutes":20,"prepLevel":"rendah","presentation":[{"step":1,"text":"Tunjukkan tiga bentuk pada kartu."},{"step":2,"text":"Tentukan area pencarian yang aman."},{"step":3,"text":"Cari benda dengan bentuk serupa."},{"step":4,"text":"Centang temuan pada kartu."}],"controlOfError":"Kartu bentuk menjadi pembanding visual.","variations":["Cari warna atau pola yang berulang di sekitar."],"readySigns":["Berjalan sambil memperhatikan batas area."],"struggleSigns":["Bergerak terlalu jauh atau hanya mencari benda yang disukai."],"safetyNotes":["Dampingi dekat, hindari jalan kendaraan, dan jangan menyentuh benda berbahaya."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"4-5y-memindahkan-bola-sendok","title":"Membawa Bola dengan Sendok","summary":"Anak berjalan pelan sambil menjaga bola tetap di atas sendok untuk melatih keseimbangan tubuh.","ageBands":["4-5y"],"areas":["movement","grace-courtesy"],"skills":["keseimbangan","kontrol gerak","ketekunan"],"objectives":["Mengatur kecepatan berjalan","Menjaga benda tetap stabil"],"materials":[{"name":"sendok besar","fromHome":true,"optional":false},{"name":"bola kain atau pom-pom besar","fromHome":true,"optional":false},{"name":"dua penanda lantai","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Letakkan bola di atas sendok."},{"step":2,"text":"Pegang sendok dengan satu tangan."},{"step":3,"text":"Berjalan pelan menuju penanda."},{"step":4,"text":"Berbalik dan kembali tanpa berlari."}],"controlOfError":"Bola jatuh jika gerakan terlalu cepat atau tidak seimbang.","variations":["Buat jalur berbelok atau gunakan dua tangan untuk pemula."],"readySigns":["Memperlambat langkah saat bola bergoyang."],"struggleSigns":["Berlari atau sering melihat kaki sehingga menabrak."],"safetyNotes":["Gunakan bola ringan dan lakukan di lantai bebas hambatan."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
