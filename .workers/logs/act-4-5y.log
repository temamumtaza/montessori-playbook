+  {"id":"4-5y-memilah-sampah","title":"Memilah Sampah Rumah Tangga","summary":"Anak memilah contoh sampah bersih ke tempat kertas, plastik, dan sisa makanan dengan bimbingan.","ageBands":["4-5y"],"areas":["culture","practical-life"],"skills":["kepedulian lingkungan","klasifikasi","tanggung jawab"],"objectives":["Mengenali beberapa jenis sampah","Membuang benda pada tempat yang sesuai"],"materials":[{"name":"tiga wadah berlabel gambar","fromHome":true,"optional":false},{"name":"contoh sampah bersih dan aman","fromHome":true,"optional":false}],"prepMinutes":8,"durationMinutes":15,"prepLevel":"sedang","presentation":[{"step":1,"text":"Tunjukkan label pada setiap wadah."},{"step":2,"text":"Ambil satu contoh sampah bersih."},{"step":3,"text":"Pilih wadah berdasarkan bahannya."},{"step":4,"text":"Cuci tangan setelah semua selesai."}],"controlOfError":"Label gambar membantu anak mengecek pilihannya.","variations":["Tambahkan kegiatan memakai ulang kardus untuk karya."],"readySigns":["Menyebut alasan memilih wadah tertentu."],"struggleSigns":["Memasukkan benda tanpa melihat label atau menyentuh sampah kotor."],"safetyNotes":["Hanya gunakan sampah bersih; hindari kaca, logam tajam, baterai, dan bahan kimia."],"references":[{"title":"WHO Five Keys to Safer Food","url":"https://www.who.int/teams/nutrition-and-food-safety/food-safety-and-zoonoses/five-keys-to-safer-food"}]},
+  {"id":"4-5y-latihan-menyapa","title":"Latihan Menyapa dan Meminta Tolong","summary":"Anak bermain peran menyapa, meminta bantuan, dan mengucapkan terima kasih dalam situasi sehari-hari.","ageBands":["4-5y"],"areas":["grace-courtesy","language"],"skills":["sopan santun","komunikasi","bergiliran"],"objectives":["Menggunakan kalimat sopan","Mendengarkan dan merespons lawan bicara"],"materials":[{"name":"dua kursi","fromHome":true,"optional":false},{"name":"benda peran seperti tas atau buku","fromHome":true,"optional":true}],"prepMinutes":3,"durationMinutes":12,"prepLevel":"rendah","presentation":[{"step":1,"text":"Tunjukkan cara menatap dan menyapa."},{"step":2,"text":"Peragakan meminta bantuan dengan kalimat jelas."},{"step":3,"text":"Tunggu jawaban tanpa memotong."},{"step":4,"text":"Ucapkan terima kasih lalu bertukar peran."}],"controlOfError":"Lawan bicara dapat mengulang jika pesan belum jelas.","variations":["Latih meminta izin meminjam benda atau bergabung bermain."],"readySigns":["Mau mencoba kalimat sopan tanpa dipaksa."],"struggleSigns":["Menirukan kata tanpa memahami giliran percakapan."],"safetyNotes":["Jelaskan bahwa anak boleh berkata tidak dan mencari orang dewasa jika merasa tidak aman."],"references":[{"title":"healthychildren.org","url":"https://www.healthychildren.org/English/ages-stages/preschool/Pages/default.aspx"}]},
+  {"id":"4-5y-menyusun-rak-buku","title":"Menata Buku di Rak","summary":"Anak mengembalikan buku dengan punggung menghadap depan dan menjaga rak tetap mudah digunakan.","ageBands":["4-5y"],"areas":["grace-courtesy","practical-life"],"skills":["merawat barang","pengelompokan","kemandirian"],"objectives":["Mengembalikan benda ke tempatnya","Menata buku tanpa merusak halaman"],"materials":[{"name":"rak rendah","fromHome":true,"optional":false},{"name":"enam sampai sepuluh buku anak","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Bawa satu buku dengan dua tangan."},{"step":2,"text":"Letakkan buku berdiri dengan punggung terlihat."},{"step":3,"text":"Berikan jarak agar buku mudah diambil."},{"step":4,"text":"Periksa rak sebelum meninggalkannya."}],"controlOfError":"Buku miring atau sulit diambil terlihat langsung.","variations":["Kelompokkan buku berdasarkan tema atau ukuran."],"readySigns":["Mengembalikan buku tanpa diminta berulang kali."],"struggleSigns":["Mendorong buku terlalu kuat atau menaruhnya sembarang."],"safetyNotes":["Gunakan rak rendah yang kokoh dan tidak mudah roboh."],"references":[{"title":"NHS Child Development","url":"https://www.nhs.uk/conditions/baby/babys-development/play-and-learning/"}]},
