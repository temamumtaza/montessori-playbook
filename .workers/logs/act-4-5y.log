+  {"id":"4-5y-menghitung-benda","title":"Menghitung Benda Satu per Satu","summary":"Anak menghitung kumpulan benda sambil menyentuh setiap benda agar satu benda mendapat satu angka.","ageBands":["4-5y"],"areas":["math"],"skills":["korespondensi satu-satu","jumlah","urutan angka"],"objectives":["Menghitung benda tanpa terlewat","Menghubungkan jumlah dengan angka terakhir"],"materials":[{"name":"dua puluh benda penghitung besar","fromHome":true,"optional":false},{"name":"kartu angka 1-10","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":12,"prepLevel":"rendah","presentation":[{"step":1,"text":"Buat satu baris benda penghitung."},{"step":2,"text":"Sentuh benda pertama sambil berkata satu."},{"step":3,"text":"Lanjutkan satu angka untuk satu benda."},{"step":4,"text":"Sebut jumlah setelah benda terakhir."}],"controlOfError":"Benda yang tersisa menunjukkan jika ada yang terlewat.","variations":["Cocokkan kumpulan dengan kartu angka."],"readySigns":["Menjaga urutan angka dan sentuhan tetap selaras."],"struggleSigns":["Menghitung terlalu cepat atau menyebut angka ganda."],"safetyNotes":["Gunakan benda besar dan awasi agar tidak dimasukkan ke mulut."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
