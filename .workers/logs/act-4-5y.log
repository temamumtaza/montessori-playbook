+  {"id":"4-5y-operasi-tambah-benda","title":"Bermain Tambah dengan Benda","summary":"Anak memahami penjumlahan awal dengan menggabungkan dua kelompok benda dan menghitung hasilnya.","ageBands":["4-5y"],"areas":["math"],"skills":["penjumlahan awal","menghitung","pemecahan masalah"],"objectives":["Menggabungkan dua kelompok","Menjelaskan jumlah keseluruhan"],"materials":[{"name":"kancing besar atau batu halus","fromHome":true,"optional":false},{"name":"dua alas kecil","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":15,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan dua benda pada alas pertama."},{"step":2,"text":"Letakkan satu benda pada alas kedua."},{"step":3,"text":"Gabungkan kedua kelompok."},{"step":4,"text":"Hitung jumlah semuanya bersama."}],"controlOfError":"Benda yang digabung dapat dihitung ulang.","variations":["Gunakan cerita sederhana tentang buah atau mainan."],"readySigns":["Memahami bahwa kelompok bergabung menjadi jumlah baru."],"struggleSigns":["Menghitung benda yang sama dua kali."],"safetyNotes":["Gunakan benda besar dan jangan gunakan makanan kecil sebagai alat hitung."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"4-5y-membandingkan-jumlah","title":"Membandingkan Dua Kelompok","summary":"Anak memasangkan benda dari dua kelompok untuk melihat mana yang lebih banyak atau sama.","ageBands":["4-5y"],"areas":["math","sensorial"],"skills":["lebih banyak","lebih sedikit","sama banyak"],"objectives":["Membandingkan jumlah secara visual","Menggunakan bahasa kuantitas"],"materials":[{"name":"dua jenis benda penghitung besar","fromHome":true,"optional":false},{"name":"dua alas","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":10,"prepLevel":"rendah","presentation":[{"step":1,"text":"Buat dua baris benda."},{"step":2,"text":"Pasangkan benda dari kiri ke kanan."},{"step":3,"text":"Amati baris yang tersisa."},{"step":4,"text":"Ucapkan mana lebih banyak atau sama."}],"controlOfError":"Benda yang tidak memiliki pasangan terlihat jelas.","variations":["Minta anak membuat dua kelompok yang sama banyak."],"readySigns":["Menggunakan pasangan, bukan hanya ukuran barisan."],"struggleSigns":["Mengira baris lebih panjang selalu lebih banyak."],"safetyNotes":["Pilih benda cukup besar dan pastikan lantai bebas dari benda yang dapat membuat tersandung."],"references":[{"title":"NHS Child Development","url":"https://www.nhs.uk/conditions/baby/babys-development/play-and-learning/"}]},
