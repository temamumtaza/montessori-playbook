+  {"id":"6-9m-rasa-buah-lembut","title":"Mencicipi Buah Lembut","summary":"Bayi yang siap makan mengenal rasa dan tekstur buah sesuai kebutuhannya.","ageBands":["6-9m"],"areas":["self-care","practical-life"],"skills":["makan mandiri","tekstur","koordinasi tangan-mulut"],"objectives":["Mencoba tekstur sesuai kesiapan","Berlatih mengambil makanan lunak"],"materials":[{"name":"potongan buah lunak besar","fromHome":true,"optional":false},{"name":"alas makan","fromHome":true,"optional":false}],"prepMinutes":10,"durationMinutes":15,"prepLevel":"sedang","presentation":[{"step":1,"text":"Cuci tangan dan siapkan potongan lunak."},{"step":2,"text":"Letakkan satu potong di alas makan."},{"step":3,"text":"Biarkan bayi mengambil tanpa dipaksa."}],"controlOfError":"Bayi dapat merasakan dan menolak makanan dengan jelas.","variations":["Tawarkan satu jenis buah pada satu waktu."],"readySigns":["Bayi dapat duduk dengan dukungan dan tertarik pada makanan."],"struggleSigns":["Bayi batuk terus, muntah, atau belum siap duduk."],"safetyNotes":["Ikuti kesiapan makan bayi, hindari potongan kecil atau bulat, dan selalu awasi untuk mencegah tersedak."],"references":[{"title":"NHS Weaning and feeding","url":"https://www.nhs.uk/start-for-life/baby/first-foods/"}]},
+  {"id":"6-9m-mencari-bunyi-bel","title":"Mencari Bunyi Bel","summary":"Bayi menoleh dan mencari sumber bunyi bel yang lembut.","ageBands":["6-9m"],"areas":["sensorial","language"],"skills":["lokalisasi suara","perhatian auditori","menoleh"],"objectives":["Menemukan arah suara","Menghubungkan bunyi dengan benda"],"materials":[{"name":"bel kain berukuran besar","fromHome":true,"optional":false}],"prepMinutes":2,"durationMinutes":6,"prepLevel":"rendah","presentation":[{"step":1,"text":"Bunyikan bel di samping bayi."},{"step":2,"text":"Tunggu bayi menoleh ke arahnya."},{"step":3,"text":"Tunjukkan bel setelah bayi mencari."}],"controlOfError":"Arah bunyi dapat dilacak dan benda terlihat.","variations":["Pindahkan sumber bunyi ke sisi lain."],"readySigns":["Bayi menoleh menuju bunyi."],"struggleSigns":["Bayi tampak kaget oleh bunyi."],"safetyNotes":["Pilih bel lembut tanpa bagian kecil yang dapat terlepas dan gunakan volume rendah."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
+  {"id":"6-9m-tekan-spons","title":"Menekan Spons Basah","summary":"Bayi meremas spons besar untuk melihat air keluar perlahan.","ageBands":["6-9m"],"areas":["sensorial","practical-life"],"skills":["meremas","sebab-akibat","kekuatan tangan"],"objectives":["Menguatkan telapak tangan","Mengamati perubahan spons"],"materials":[{"name":"spons mandi besar dan lembut","fromHome":true,"optional":false},{"name":"wadah dangkal","fromHome":true,"optional":false}],"prepMinutes":5,"durationMinutes":8,"prepLevel":"sedang","presentation":[{"step":1,"text":"Basahi spons dan peras sedikit."},{"step":2,"text":"Letakkan spons di wadah dangkal."},{"step":3,"text":"Bantu satu kali lalu tunggu bayi meremas."}],"controlOfError":"Air keluar ketika spons ditekan.","variations":["Gunakan spons kering untuk perbandingan."],"readySigns":["Bayi menggenggam dan menekan spons."],"struggleSigns":["Spons terlalu besar atau licin di tangan."],"safetyNotes":["Gunakan spons baru yang utuh, jangan biarkan bayi menggigit serpihan, dan awasi dekat air."],"references":[{"title":"healthychildren.org","url":"https://www.healthychildren.org/English/ages-stages/baby/Pages/default.aspx"}]},
+  {"id":"6-9m-buka-tutup-wadah","title":"Membuka Tutup Wadah Besar","summary":"Bayi mengamati penutup diangkat dan mencoba mengambilnya.","ageBands":["6-9m"],"areas":["practical-life","math"],"skills":["koordinasi","keberlanjutan benda","pemecahan masalah awal"],"objectives":["Mengikuti gerakan buka-tutup","Mencoba mengangkat penutup"],"materials":[{"name":"wadah plastik besar bertutup longgar","fromHome":true,"optional":false}],"prepMinutes":3,"durationMinutes":8,"prepLevel":"sedang","presentation":[{"step":1,"text":"Letakkan wadah tertutup di depan bayi."},{"step":2,"text":"Buka tutup perlahan dan tunjukkan isinya."},{"step":3,"text":"Tutup kembali dan tunggu usaha bayi."}],"controlOfError":"Tutup mudah diangkat dan isi terlihat.","variations":["Masukkan kain besar di dalam wadah."],"readySigns":["Bayi meraih tutup atau melihat ke dalam."],"struggleSigns":["Tutup terlalu rapat untuk diangkat."],"safetyNotes":["Gunakan wadah tanpa tepi tajam dan tutup yang tidak dapat mengunci atau menjepit jari."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
