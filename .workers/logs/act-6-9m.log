+  {"id":"6-9m-sentuh-es-batu-dingin","title":"Merasakan Benda Dingin","summary":"Bayi menyentuh wadah tertutup berisi benda dingin bersama orang dewasa.","ageBands":["6-9m"],"areas":["sensorial"],"skills":["membedakan suhu","meraba","respons sensori"],"objectives":["Mengenali sensasi dingin dengan aman","Mengamati respons tubuh"],"materials":[{"name":"kantong gel tertutup rapat","fromHome":true,"optional":false},{"name":"kain pembungkus","fromHome":true,"optional":false}],"prepMinutes":15,"durationMinutes":4,"prepLevel":"tinggi","presentation":[{"step":1,"text":"Dinginkan kantong gel dan bungkus kain."},{"step":2,"text":"Sentuhkan sebentar ke punggung tangan bayi."},{"step":3,"text":"Amati respons lalu hentikan bila menolak."}],"controlOfError":"Sensasi dingin dapat dihentikan segera.","variations":["Gunakan kain suhu ruang untuk pembanding."],"readySigns":["Bayi tetap tenang dan memperhatikan benda."],"struggleSigns":["Bayi menarik tangan atau menangis."],"safetyNotes":["Jangan gunakan es langsung, jangan letakkan kantong di mulut, dan periksa agar tidak bocor."],"references":[{"title":"healthychildren.org","url":"https://www.healthychildren.org/English/ages-stages/baby/Pages/default.aspx"}]},
