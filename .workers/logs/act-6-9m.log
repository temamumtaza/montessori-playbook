+  {"id":"6-9m-tepuk-tangan-bersama","title":"Tepuk Tangan Bersama","summary":"Bayi meniru tepukan lembut dalam permainan sosial singkat.","ageBands":["6-9m"],"areas":["grace-courtesy","movement"],"skills":["meniru gerak","ritme","interaksi"],"objectives":["Mengikuti gerakan sederhana","Berpartisipasi dalam permainan bersama"],"materials":[{"name":"tangan orang dewasa","fromHome":true,"optional":false}],"prepMinutes":0,"durationMinutes":5,"prepLevel":"rendah","presentation":[{"step":1,"text":"Duduk berhadapan dengan bayi."},{"step":2,"text":"Tepukkan tangan perlahan dua kali."},{"step":3,"text":"Berikan jeda untuk respons bayi."}],"controlOfError":"Gerakan terlihat jelas dan dapat diulang.","variations":["Tepuk paha dengan ritme yang sangat lembut."],"readySigns":["Bayi menggerakkan tangan atau tersenyum."],"struggleSigns":["Bayi tampak lelah atau tidak nyaman."],"safetyNotes":["Jangan memaksa tangan bayi dan hindari tepukan keras di dekat telinga."],"references":[{"title":"CDC Milestones","url":"https://www.cdc.gov/ncbddd/actearly/milestones/index.html"}]},
