def apply(e, f):
    for k, v in f.items():
        kind, idx = k.split('[')
        i = int(idx.rstrip(']'))
        if kind == 'steps': e['steps'][i] = v
        elif kind == 'safety': e['safetyNotes'][i] = v
        elif kind == 'mats': e['materialsNeeded'][i] = v

for e in d:
    if e['id'] in F: apply(e, F[e['id']])

