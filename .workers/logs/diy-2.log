def g(id, title, makes, timeMinutes, cost, mats, steps, ages, safety, refs):
    return {
        "id": id, "title": title, "makes": makes,
        "timeMinutes": timeMinutes, "cost": cost,
        "materialsNeeded": mats, "steps": steps,
        "ageBands": ages, "safetyNotes": safety, "references": refs,
    }

data = [
