import json,re
d=json.load(open('content/parts/diy-2.json'))
ages={'0-3m','3-6m','6-9m','9-12m','12-18m','18-24m','2-3y','3-4y','4-5y'}
costs={'gratis','rendah','sedang'}
errs=[]
ids=set()
for i,x in enumerate(d):
    k=set(x)
    need={'id','title','makes','timeMinutes','cost','materialsNeeded','steps','ageBands','safetyNotes','references'}
    if k!=need: errs.append((i,'keys',k^need))
    if not re.fullmatch(r'[a-z0-9-]+',x['id']): errs.append((i,'id',x['id']))
    if x['id'] in ids: errs.append((i,'dup',x['id']))
    ids.add(x['id'])
    if len(x['title'])<5: errs.append((i,'title',x['title']))
    if len(x['makes'])<3: errs.append((i,'makes',x['makes']))
    if not (5<=x['timeMinutes']<=600): errs.append((i,'time',x['timeMinutes']))
    if x['cost'] not in costs: errs.append((i,'cost',x['cost']))
    if len(x['materialsNeeded'])<1 or len(x['steps'])<2: errs.append((i,'arr',x['id']))
    if not x['ageBands'] or any(a not in ages for a in x['ageBands']): errs.append((i,'age',x['ageBands']))
    if any(a in {'0-3m','3-6m','6-9m','9-12m','12-18m','18-24m','2-3y'} for a in x['ageBands']) and len(x['safetyNotes'])<1:
        errs.append((i,'safety',x['id']))
    if len(x['references'])<1: errs.append((i,'refs',x['id']))
    for r in x['references']:
        if not r.get('title') or not r.get('url','').startswith('http'): errs.append((i,'ref',r))
print('count',len(d),'errors',len(errs))
for e in errs: print(e)
print('ages coverage')
from collections import Counter
c=Counter(a for x in d for a in x['ageBands'])
print(dict(c))
