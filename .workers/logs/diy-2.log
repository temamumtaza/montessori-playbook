TOY = {"title": "HealthyChildren.org - How to Buy Safe Toys", "url": H + "/English/safety-prevention/at-home/Pages/How-to-Buy-Safe-Toys.aspx"}
BABY = {"title": "HealthyChildren.org - Baby Ages and Stages", "url": H + "/English/ages-stages/baby/Pages/default.aspx"}
TODD = {"title": "HealthyChildren.org - Toddler Ages and Stages", "url": H + "/English/ages-stages/toddler/Pages/default.aspx"}
PRE = {"title": "HealthyChildren.org - Preschool Ages and Stages", "url": H + "/English/ages-stages/preschool/Pages/default.aspx"}
CHOKE = {"title": "HealthyChildren.org - Choking Prevention", "url": H + "/English/health-issues/injuries-emergencies/Pages/Choking-Prevention.aspx"}
NHS = {"title": "NHS - Baby and toddler health", "url": "https://www.nhs.uk/baby/"}
WHO = {"title": "WHO - Child health", "url": "https://www.who.int/health-topics/child-health"}
MON = {"title": "The Montessori Notebook - Montessori at Home", "url": "https://themontessorinotebook.com/montessori-at-home/"}
