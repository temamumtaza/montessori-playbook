import { db } from '../db'
import { ActionSheet } from '../components/ActionSheet'

export const AREA_GRADIENTS: Record<string, string> = {
  'practical-life': 'from-apple-500 to-apple-700',
  sensorial: 'from-grape-500 to-grape-700',
  language: 'from-sky-500 to-sky-700',
  math: 'from-leaf-500 to-leaf-700',
  culture: 'from-tosca-500 to-tosca-700',
  movement: 'from-mango-500 to-mango-700',
  'grace-courtesy': 'from-candy-500 to-candy-700',
  'self-care': 'from-sunny-500 to-sunny-700',
  'art-music': 'from-grape-500 to-candy-700',
  outdoor: 'from-leaf-500 to-tosca-700',
}

export function TodayPage() {
  const [acts, setActs] = useState<Activity[]>([])
  const [loading, setLoading] = useState(true)
  const band = activeAgeBand()
  const { children, activeId, setActive } = useChildStore()
  const child = children.find((c) => c.id === activeId)

  const [stats, setStats] = useState({ aktivitas: 0, area: 0, momen: 0, kebiasaan: 0 })
  const [toast, setToast] = useState('')
  const [dismissed, setDismissed] = useState(false)
  const [actionActivity, setActionActivity] = useState<Activity | null>(null)
  const longPressTimer = useRef<number | null>(null)
  const longPressTriggered = useRef(false)
  useEffect(() => {
    if (!toast) return
    const timer = window.setTimeout(() => setToast(''), 1500)
    return () => window.clearTimeout(timer)
  }, [toast])
  useEffect(() => {
    if (!activeId) return
    Promise.all([
      db.mastery.where('childId').equals(activeId).toArray(),
      db.journal.where('childId').equals(activeId).count(),
      loadAllActivities(),
    ]).then(([mastery, journalCount, allActivities]) => {
      const touched = mastery.filter((m) => m.level !== 'belum')
      const areasByActivity = new Map(allActivities.map((a) => [a.id, a.areas]))
      const areaSet = new Set(touched.filter((m) => m.kind === 'activity').flatMap((m) => areasByActivity.get(m.targetId) ?? []))
      setStats({
        aktivitas: touched.filter((m) => m.kind === 'activity').length,
        area: areaSet.size,
        momen: journalCount,
        kebiasaan: touched.filter((m) => m.kind === 'milestone').length,
      })
    })
  }, [activeId, acts])

  useEffect(() => {
    if (!band) return
    pickToday(band).then((a) => { setActs(a); setLoading(false) })
  }, [band])

  if (!child) return <OnboardPrompt />

  function startLongPress(activity: Activity) {
    longPressTriggered.current = false
    if (longPressTimer.current !== null) window.clearTimeout(longPressTimer.current)
    longPressTimer.current = window.setTimeout(() => {
      longPressTriggered.current = true
      setActionActivity(activity)
    }, 500)
  }

  function cancelLongPress() {
    if (longPressTimer.current !== null) window.clearTimeout(longPressTimer.current)
    longPressTimer.current = null
  }

  async function shareActivity(activity: Activity) {
    const url = `${window.location.origin}${window.location.pathname}#/aktivitas/${activity.id}`
    if (navigator.share) {
      await navigator.share({ title: activity.title, text: activity.summary, url }).catch(() => {})
    } else {
      await navigator.clipboard?.writeText(url)
      setToast('Link aktivitas disalin')
    }
  }

  async function toggleActivityBookmark(activity: Activity) {
    if (!activeId) return
    const existing = await db.bookmarks.where('[childId+targetId]').equals([activeId, activity.id]).first()
    if (existing) {
      await db.bookmarks.where('[childId+targetId]').equals([activeId, activity.id]).delete()
      setToast('Dihapus dari favorit')
    } else {
      await db.bookmarks.add({ childId: activeId, targetId: activity.id, createdAt: Date.now() })
      setToast('Ditambahkan ke favorit')
    }
  }

  return (
    <div className="px-5 space-y-5">
      {/* Halo header */}
      <section>
        <div className="flex items-center justify-between">
          <div>
            <h2 className="font-[family-name:var(--font-display)] text-2xl font-bold text-sky-900 dark:text-sky-100">
              Halo, {child.nickname} <span aria-hidden>👋</span>
            </h2>
            <p className="text-sm opacity-75 mt-0.5">Siap main dan belajar hari ini?</p>
          </div>
          <button aria-label="Pengingat" className="w-11 h-11 rounded-full bg-white dark:bg-navy-800 shadow-sm grid place-items-center text-lg active:scale-95 transition">
            🔔
          </button>
        </div>

        {/* Child switcher */}
        <div className="mt-3 flex gap-2 overflow-x-auto hide-scrollbar -mx-1 px-1" role="group" aria-label="Pilih anak">
          {children.map((c) => {
            const cBand = ageBandById(ageBandFromBirth(c.birthDate))
            return (
              <button
                key={c.id}
                onClick={() => setActive(c.id)}
                aria-pressed={activeId === c.id}
                className={`shrink-0 flex items-center gap-2 rounded-full pl-1.5 pr-4 min-h-[48px] border-2 transition active:scale-[0.97] ${
                  activeId === c.id
                    ? 'bg-sky-600 border-sky-600 text-white shadow-md'
                    : 'bg-white dark:bg-navy-800 border-sky-100 dark:border-navy-700'
                }`}
              >
                <span className="w-9 h-9 rounded-full bg-gradient-to-br from-sky-200 to-sky-400 dark:from-navy-600 dark:to-navy-500 grid place-items-center text-lg" aria-hidden>
                  {c.avatar ?? cBand?.mascot ?? '🙂'}
                </span>
                <span className="text-left leading-tight">
                  <span className="block text-sm font-semibold">{c.nickname}</span>
                  <span className={`block text-[11px] ${activeId === c.id ? 'text-white/80' : 'opacity-70'}`}>{cBand?.label ?? '—'}</span>
                </span>
              </button>
            )
          })}
        </div>
      </section>

      {/* Search bar */}
      <a
        href="#/cari"
        className="flex items-center gap-3 rounded-full bg-white dark:bg-navy-800 shadow-sm px-5 min-h-[48px] text-sm text-sky-900/50 dark:text-sky-100/50 active:scale-[0.98] transition"
      >
        <span aria-hidden>🔍</span>
        Cari aktivitas, misal "menuang", "sensorik"…
      </a>

      {/* Rekomendasi Hari Ini */}
      <section>
        <div className="flex items-center justify-between mb-2.5">
          <h3 className="font-[family-name:var(--font-display)] font-bold text-lg">Rekomendasi Hari Ini</h3>
          <a href="#/playbook" className="text-sm font-medium text-sky-600 dark:text-sky-400">Lihat Semua ›</a>
        </div>
        {loading ? (
          <SkeletonCards n={3} />
        ) : acts.length === 0 ? (
          <EmptyState
            title="Konten sedang disiapkan"
            text="Aktivitas untuk usia ini belum tersedia. Cek playbook usia lain dulu ya."
          />
        ) : (
          <div className="flex gap-3 overflow-x-auto hide-scrollbar -mx-5 px-5 pb-1 snap-x snap-mandatory">
            {acts.map((a) => {
              const area = areaById(a.areas[0])
              const grad = AREA_GRADIENTS[a.areas[0]] ?? 'from-sky-500 to-sky-700'
              return (
                <article
                  key={a.id}
                  onPointerDown={() => startLongPress(a)}
                  onPointerUp={cancelLongPress}
                  onPointerCancel={cancelLongPress}
                  onPointerLeave={cancelLongPress}
                  className="relative snap-start shrink-0 w-44 rounded-3xl bg-white dark:bg-navy-800 shadow-sky-sm overflow-hidden active:scale-[0.97] transition"
                >
                  <a href={`#/aktivitas/${a.id}`} aria-label={a.title} className="block" onClick={(event) => { if (longPressTriggered.current) { event.preventDefault(); longPressTriggered.current = false } }}>
                    <div className={`relative h-28 bg-gradient-to-br ${grad} grid place-items-center bg-black/15 bg-blend-overlay`}>
                      <AreaIcon area={a.areas[0]} className="w-14 h-14 text-white/95 drop-shadow" />
                      <span className="absolute top-2 left-2 text-[10px] font-semibold bg-white/90 text-sky-800 rounded-full px-2 py-0.5">{area?.label}</span>
                    </div>
                    <div className="p-3">
                      <h4 className="font-semibold text-sm leading-snug line-clamp-2 min-h-[2.5rem]">{a.title}</h4>
                      <p className="text-[11px] opacity-70 mt-1.5">⏱ {a.durationMinutes} mnt · {a.ageBands[0]}</p>
                    </div>
                  </a>
                  <BookmarkButton activityId={a.id} onToast={setToast} />
                  <button
                    aria-label="Aksi lainnya"
                    onPointerDown={(event) => event.stopPropagation()}
                    onClick={(event) => { event.stopPropagation(); setActionActivity(a) }}
                    className="absolute right-2 bottom-2 grid h-7 w-7 place-items-center rounded-full bg-white/90 text-sky-800"
                  >
                    <TabIcon name="ellipsis" className="h-4 w-4" />
                  </button>
                </article>
              )
            })}
          </div>
        )}
      </section>

      {/* Progres Minggu Ini */}
      <section>
        <div className="flex items-center justify-between mb-2.5">
          <h3 className="font-[family-name:var(--font-display)] font-bold text-lg">Progres Minggu Ini</h3>
          <a href="#/progres" className="text-sm font-medium text-sky-600 dark:text-sky-400">Lihat Detail ›</a>
        </div>
        <div className="grid grid-cols-4 gap-2">
          {[
            { n: stats.aktivitas, l: 'aktivitas', c: 'text-leaf-600' },
            { n: stats.area, l: 'area berbeda', c: 'text-sunny-700' },
            { n: stats.momen, l: 'momen berharga', c: 'text-apple-600' },
            { n: stats.kebiasaan, l: 'kebiasaan baru', c: 'text-sky-600' },
          ].map((s) => (
            <div key={s.l} className="rounded-2xl bg-white dark:bg-navy-800 shadow-sky-sm p-2.5 text-center">
              <p className={`font-[family-name:var(--font-display)] font-bold text-xl ${s.c}`}>{s.n}</p>
              <p className="text-[10px] opacity-70 leading-tight mt-0.5">{s.l}</p>
            </div>
          ))}
        </div>
      </section>

      {/* Reminder banner */}
      {!dismissed && <section className="rounded-3xl bg-sunny-100 dark:bg-navy-800 p-4 flex items-start gap-3">
        <span className="text-2xl" aria-hidden>🌞</span>
        <div className="flex-1">
          <p className="text-sm font-semibold">Jangan lupa istirahat, ya!</p>
          <p className="text-xs opacity-70 mt-0.5">Anak juga belajar dari momen santai bersama Mama & Papa.</p>
        </div>
        <button aria-label="Tutup pengingat" onClick={() => setDismissed(true)} className="opacity-70 text-sm px-1">✕</button>
      </section>}
      {toast && <div className="fixed bottom-24 inset-x-0 z-50 mx-auto w-fit rounded-full bg-navy-800 px-4 py-2 text-sm text-white shadow-lg" role="status" aria-live="polite">{toast}</div>}
      <ActionSheet
        open={actionActivity !== null}
        onClose={() => setActionActivity(null)}
        actions={actionActivity ? [
          { label: 'Bagikan Aktivitas', icon: '↗️', onSelect: () => { void shareActivity(actionActivity) } },
          { label: 'Tambah ke Favorit', icon: '♥', onSelect: () => { void toggleActivityBookmark(actionActivity) } },
          { label: 'Simpan Offline', icon: '✓', onSelect: () => setToast('Sudah offline — app ini local-first ✅') },
        ] : []}
      />
    </div>
  )
}

export function BookmarkButton({ activityId, onToast }: { activityId: string; onToast: (message: string) => void }) {
  const activeId = useChildStore((s) => s.activeId)
  const [bookmarked, setBookmarked] = useState(false)
  useEffect(() => {
    if (!activeId) return
    db.bookmarks.where('[childId+targetId]').equals([activeId, activityId]).first().then((b) => setBookmarked(!!b))
  }, [activeId, activityId])
  async function toggle(event: React.MouseEvent<HTMLButtonElement>) {
    event.stopPropagation()
    if (!activeId) return
    if (bookmarked) await db.bookmarks.where('[childId+targetId]').equals([activeId, activityId]).delete()
    else await db.bookmarks.add({ childId: activeId, targetId: activityId, createdAt: Date.now() })
    setBookmarked(!bookmarked)
    onToast(!bookmarked ? 'Disimpan' : 'Dihapus')
  }
  return <button onClick={toggle} aria-label={bookmarked ? 'Hapus bookmark' : 'Simpan ke bookmark'} aria-pressed={bookmarked} className="absolute top-2 right-2 w-7 h-7 rounded-full bg-white/90 grid place-items-center text-xs text-sky-800">{bookmarked ? '♥' : '♡'}</button>
}

function childBand(birth: string) {
  return ageBandById(ageBandFromBirth(birth))
}
void childBand

export function OnboardPrompt() {
  return (
    <div className="px-5 relative">
      <CloudDeco className="absolute -top-2 -right-2 w-24 text-white/70 dark:text-navy-700" />
      <StarDeco className="absolute top-8 left-4 w-5 text-sunny-400" />
      <div className="rounded-blob bg-white dark:bg-navy-800 p-6 text-center shadow-sky-sm relative overflow-hidden">
        <Mascot className="w-36 mx-auto" />
        <h1 className="font-[family-name:var(--font-display)] text-lg font-bold"><span className="text-sky-700">Montessori</span> <span className="text-candy-600">Playbook</span></h1>
        <h2 className="font-[family-name:var(--font-display)] text-2xl font-bold mt-2">Selamat datang!</h2>
        <p className="text-sm opacity-70 mt-2 max-w-[280px] mx-auto">
          Ceritakan tentang si kecil, agar kami bisa menyiapkan rekomendasi yang tepat.
        </p>
        <a
          href="#/lainnya"
          className="inline-block mt-4 rounded-full bg-sky-700 px-8 py-3 text-white font-semibold min-h-[48px] leading-[24px] active:scale-95 transition shadow-md shadow-sky-700/20"
        >
          Buat profil anak →
        </a>
      </div>
    </div>
  )
}

export function EmptyState({ title, text, mood = 'happy' }: { title: string; text: string; mood?: 'happy' | 'sleepy' | 'oops' }) {
  return (
    <div className="py-10 text-center px-6">
      <Mascot className="w-28 mx-auto" mood={mood} />
      <h3 className="font-[family-name:var(--font-display)] font-bold text-lg mt-2">{title}</h3>
      <p className="text-sm opacity-70 mt-1 max-w-xs mx-auto">{text}</p>
    </div>
  )
}

export function SkeletonCards({ n }: { n: number }) {
  return (
    <div className="flex gap-3 overflow-hidden -mx-5 px-5" aria-hidden>
      {Array.from({ length: n }).map((_, i) => (
        <div key={i} className="shrink-0 w-44 rounded-3xl bg-white dark:bg-navy-800 overflow-hidden animate-pulse">
          <div className="h-28 bg-sky-100 dark:bg-navy-700" />
          <div className="p-3 space-y-2">
            <div className="h-3.5 w-4/5 rounded bg-sky-100 dark:bg-navy-700" />
            <div className="h-2.5 w-2/5 rounded bg-sky-50 dark:bg-navy-700/60" />
          </div>
        </div>
      ))}
    </div>
  )
}
import { useEffect, useRef, useState } from 'react'
import { useNavigate, useParams } from 'react-router-dom'
import { loadAllActivities } from '../../content/store'
import { areaById, ageBandById } from '../../content/meta'
import type { Activity } from '../../content/schema'
import { AreaIcon } from '../components/icons'
import { AREA_GRADIENTS } from './TodayPage'
import { db } from '../db'
import { useChildStore } from '../stores/children'
import { BottomSheet } from '../components/BottomSheet'

type Mode = 'baca' | 'praktik'

export function ActivityDetailPage() {
  const { id } = useParams<{ id: string }>()
  const navigate = useNavigate()
  const [act, setAct] = useState<Activity | null>(null)
  const [notFound, setNotFound] = useState(false)
  const [mode, setMode] = useState<Mode>('baca')
  const [duration, setDuration] = useState<number | null>(null)
  const [remaining, setRemaining] = useState(0)
  const [durationChoice, setDurationChoice] = useState(10)
  const [toast, setToast] = useState('')
  const [wakeLocked, setWakeLocked] = useState(false)
  const [bookmarked, setBookmarked] = useState(false)
  const wakeRef = useRef<WakeLockSentinel | null>(null)
  const activeId = useChildStore((s) => s.activeId)

  useEffect(() => {
    if (!toast) return
    const timer = window.setTimeout(() => setToast(''), 1800)
    return () => window.clearTimeout(timer)
  }, [toast])

  useEffect(() => {
    loadAllActivities().then((all) => {
      const found = all.find((a) => a.id === id) ?? null
      setAct(found)
      setNotFound(!found)
    })
  }, [id])

  useEffect(() => {
    if (!act || !activeId) return
    db.bookmarks.where('[childId+targetId]').equals([activeId, act.id]).first().then((b) => setBookmarked(!!b))
  }, [act, activeId])

  // Mode praktik: timer jalan + Wake Lock
  useEffect(() => {
    if (mode !== 'praktik') {
      setDuration(null)
      setRemaining(0)
      wakeRef.current?.release().then(() => setWakeLocked(false)).catch(() => {})
      wakeRef.current = null
      return
    }
    if (duration === null) return
    const t = window.setInterval(() => {
      setRemaining((seconds) => {
        if (seconds <= 1) {
          window.clearInterval(t)
          setToast('Waktu selesai! 🎉')
          return 0
        }
        return seconds - 1
      })
    }, 1000)
    type NavWithLock = Navigator & { wakeLock?: { request: (t: 'screen') => Promise<WakeLockSentinel> } }
    const nav = navigator as NavWithLock
    if (nav.wakeLock) {
      nav.wakeLock.request('screen').then((s) => { wakeRef.current = s; setWakeLocked(true) }).catch(() => {})
    }
    return () => clearInterval(t)
  }, [mode, duration])

  async function toggleBookmark() {
    if (!act || !activeId) return
    if (bookmarked) {
      await db.bookmarks.where('[childId+targetId]').equals([activeId, act.id]).delete()
      setBookmarked(false)
    } else {
      await db.bookmarks.add({ childId: activeId, targetId: act.id, createdAt: Date.now() })
      setBookmarked(true)
    }
  }

  async function markDone(level: 'mulai' | 'mahir') {
    if (!act || !activeId) return
    await db.mastery.put({ childId: activeId, targetId: act.id, kind: 'activity', level, updatedAt: Date.now() })
    if (window.history.length > 1) navigate(-1)
    else navigate('/playbook')
  }

  if (notFound) {
    return <div className="px-5 py-10 text-center"><p className="font-semibold">Aktivitas tidak ditemukan</p><a href="#/playbook" className="text-sky-600 text-sm">← Kembali ke Playbook</a></div>
  }
  if (!act) return <div className="px-5 text-sm opacity-70">Memuat…</div>

  const area = areaById(act.areas[0])
  const grad = AREA_GRADIENTS[act.areas[0]] ?? 'from-sky-500 to-sky-700'
  const countdownMm = String(Math.floor(remaining / 60)).padStart(2, '0')
  const countdownSs = String(remaining % 60).padStart(2, '0')

  return (
    <div className="pb-8">
      {/* Hero */}
      <div className={`relative bg-gradient-to-br ${grad} px-5 pt-safe pb-6`}>
        <div className="flex items-center justify-between pt-2">
          <button onClick={() => { if (window.history.length > 1) navigate(-1); else navigate('/playbook') }} aria-label="Kembali" className="w-11 h-11 rounded-full bg-white/25 backdrop-blur grid place-items-center text-white text-lg active:scale-95 transition">←</button>
          <div className="flex gap-2">
            <button onClick={toggleBookmark} aria-label={bookmarked ? 'Hapus bookmark' : 'Bookmark'} aria-pressed={bookmarked} className="w-11 h-11 rounded-full bg-white/25 backdrop-blur grid place-items-center text-white active:scale-95 transition">
              {bookmarked ? '♥' : '♡'}
            </button>
          </div>
        </div>
        <div className="mt-4 flex items-center gap-3">
          <div className="w-14 h-14 rounded-2xl bg-white/25 backdrop-blur grid place-items-center">
            <AreaIcon area={act.areas[0]} className="w-8 h-8 text-white" />
          </div>
          <div className="text-white">
            <p className="text-xs font-semibold uppercase tracking-wide opacity-85">{area?.label}</p>
            <p className="text-sm opacity-90">{act.ageBands.map((b) => ageBandById(b)?.label).join(' · ')}</p>
          </div>
        </div>
        <h1 className="font-[family-name:var(--font-display)] text-2xl font-bold text-white mt-3 leading-tight">{act.title}</h1>
        <p className="text-white/90 text-sm mt-1.5">{act.summary}</p>
      </div>

      {/* Mode switcher: Baca | Praktik */}
      <div className="sticky z-30 -mt-4 px-5">
        <div role="tablist" aria-label="Mode" className="grid grid-cols-2 rounded-full bg-white dark:bg-navy-800 shadow-md overflow-hidden p-1">
          {(['baca', 'praktik'] as const).map((m) => (
            <button
              key={m}
              role="tab"
              aria-selected={mode === m}
              onClick={() => setMode(m)}
              className={`rounded-full min-h-[44px] text-sm font-semibold transition ${mode === m ? 'bg-sky-600 text-white' : 'text-sky-700 dark:text-sky-300'}`}
            >
              {m === 'baca' ? '📖 Baca' : `⏱ Praktik${mode === 'praktik' && duration !== null ? ` ${countdownMm}:${countdownSs}` : ''}`}
            </button>
          ))}
        </div>
        {mode === 'praktik' && (
          <p className="text-center text-xs mt-1.5 opacity-70">
            {wakeLocked ? '🔒 Layar tidak akan mati' : 'Layar mungkin mati otomatis'} · ⏱ {duration !== null ? `${countdownMm}:${countdownSs}` : 'belum mulai'}
          </p>
        )}
      </div>

      <BottomSheet open={mode === 'praktik' && duration === null} onClose={() => setMode('baca')} title="Pilih Durasi Aktivitas">
        <div className="mt-4 grid grid-cols-2 gap-2">
          {[5, 10, 15, 30, act.durationMinutes].map((minutes, index) => (
            <button
              key={`${minutes}-${index}`}
              aria-label={`Pilih durasi ${minutes} menit`}
              aria-pressed={durationChoice === minutes}
              onClick={() => setDurationChoice(minutes)}
              className={`min-h-[44px] rounded-full border-2 text-sm font-semibold transition ${durationChoice === minutes ? 'border-sky-600 bg-sky-600 text-white' : 'border-sky-200 text-sky-700 dark:border-navy-600 dark:text-sky-200'}`}
            >
              {index === 4 ? `⏱ ${minutes} mnt · rekomendasi` : `${minutes} mnt`}
            </button>
          ))}
        </div>
        <button
          aria-label="Mulai Aktivitas"
          onClick={() => { setDuration(durationChoice); setRemaining(durationChoice * 60) }}
          className="mt-4 min-h-[48px] w-full rounded-full bg-sky-600 font-semibold text-white shadow-md shadow-sky-600/20"
        >
          Mulai Aktivitas
        </button>
      </BottomSheet>

      <div className="px-5 space-y-4 mt-4">
        {/* Meta chips */}
        <div className="flex gap-1.5 flex-wrap">
          <span className="text-[11px] rounded-full bg-white dark:bg-navy-800 shadow-sm px-3 py-1.5">⏱ {act.durationMinutes} menit</span>
          <span className="text-[11px] rounded-full bg-white dark:bg-navy-800 shadow-sm px-3 py-1.5">🧺 persiapan {act.prepLevel} ({act.prepMinutes} mnt)</span>
        </div>

        {/* Tujuan */}
        <section className="rounded-3xl bg-white dark:bg-navy-800 p-4 shadow-sm">
          <h2 className="font-[family-name:var(--font-display)] font-bold">Tujuan</h2>
          <ul className="mt-2 space-y-1.5">
            {act.objectives.map((o, i) => (
              <li key={i} className="text-sm flex gap-2"><span className="text-sky-500">✦</span>{o}</li>
            ))}
          </ul>
        </section>

        {/* Bahan */}
        <section className="rounded-3xl bg-white dark:bg-navy-800 p-4 shadow-sm">
          <h2 className="font-[family-name:var(--font-display)] font-bold">Bahan</h2>
          <ul className="mt-2 space-y-1.5">
            {act.materials.map((m, i) => (
              <li key={i} className="text-sm flex items-center gap-2">
                <span className="w-5 h-5 rounded-md border-2 border-sky-200 inline-block" aria-hidden />
                {m.name}
                {m.fromHome && <span className="text-[10px] bg-leaf-100 text-leaf-700 rounded-full px-2 py-0.5">di rumah</span>}
                {m.optional && <span className="text-[10px] opacity-50">opsional</span>}
              </li>
            ))}
          </ul>
        </section>

        {/* Langkah */}
        <section className="rounded-3xl bg-white dark:bg-navy-800 p-4 shadow-sm">
          <h2 className="font-[family-name:var(--font-display)] font-bold">Langkah presentasi</h2>
          <ol className="mt-3 space-y-3">
            {act.presentation.map((p) => (
              <li key={p.step} className="flex gap-3">
                <span className="shrink-0 w-7 h-7 rounded-full bg-sky-600 text-white text-xs font-bold grid place-items-center">{p.step}</span>
                <p className="text-sm pt-1">{p.text}</p>
              </li>
            ))}
          </ol>
        </section>

        {/* Kontrol kesalahan & variasi */}
        {act.controlOfError && (
          <section className="rounded-3xl bg-tosca-50 dark:bg-navy-800 p-4 shadow-sm border border-tosca-100">
            <h2 className="font-semibold text-sm text-tosca-700">✅ Kontrol kesalahan</h2>
            <p className="text-sm mt-1">{act.controlOfError}</p>
          </section>
        )}
        {act.variations.length > 0 && (
          <section className="rounded-3xl bg-white dark:bg-navy-800 p-4 shadow-sm">
            <h2 className="font-[family-name:var(--font-display)] font-bold">Variasi</h2>
            <ul className="mt-2 space-y-1">{act.variations.map((v, i) => <li key={i} className="text-sm">• {v}</li>)}</ul>
          </section>
        )}

        {/* Keselamatan */}
        {act.safetyNotes.length > 0 && (
          <section className="rounded-3xl bg-apple-50 dark:bg-navy-800 p-4 shadow-sm border border-apple-100">
            <h2 className="font-semibold text-sm text-apple-700">🛡️ Keselamatan</h2>
            <ul className="mt-1.5 space-y-1">{act.safetyNotes.map((s, i) => <li key={i} className="text-sm">{s}</li>)}</ul>
          </section>
        )}

        {/* Tanda siap / kesulitan */}
        <div className="grid grid-cols-2 gap-3">
          <section className="rounded-3xl bg-leaf-50 dark:bg-navy-800 p-4 border border-leaf-100">
            <h2 className="font-semibold text-sm text-leaf-700">Tanda siap</h2>
            <ul className="mt-1.5 space-y-1">{act.readySigns.map((s, i) => <li key={i} className="text-xs">{s}</li>)}</ul>
          </section>
          {act.struggleSigns.length > 0 && (
            <section className="rounded-3xl bg-sunny-50 dark:bg-navy-800 p-4 border border-sunny-100">
              <h2 className="font-semibold text-sm text-sunny-700">Tanda kesulitan</h2>
              <ul className="mt-1.5 space-y-1">{act.struggleSigns.map((s, i) => <li key={i} className="text-xs">{s}</li>)}</ul>
            </section>
          )}
        </div>

        {/* Rujukan */}
        <section className="rounded-3xl bg-white dark:bg-navy-800 p-4 shadow-sm">
          <h2 className="font-semibold text-sm opacity-70">Rujukan</h2>
          <ul className="mt-1.5 space-y-1">
            {act.references.map((r, i) => (
              <li key={i} className="text-xs">
                <a href={r.url} target="_blank" rel="noreferrer" className="text-sky-600 underline">{r.title}</a>
              </li>
            ))}
          </ul>
        </section>

        {/* Aksi utama di zona jempol */}
        {mode === 'praktik' && duration !== null && (
          <div className="text-center">
            <button aria-label="Atur ulang durasi" onClick={() => setDuration(null)} className="text-xs font-semibold text-sky-600 underline dark:text-sky-300">
              atur ulang durasi
            </button>
          </div>
        )}
        <div className="grid grid-cols-2 gap-3 pt-2">
          <button onClick={() => markDone('mulai')} className="rounded-full border-2 border-sky-500 text-sky-700 dark:text-sky-300 font-semibold min-h-[48px] active:scale-[0.98] transition">
            Mulai dicoba
          </button>
          <button onClick={() => markDone('mahir')} className="rounded-full bg-sky-600 text-white font-semibold min-h-[48px] active:scale-[0.98] transition shadow-md shadow-sky-600/20">
            Sudah mahir ✓
          </button>
        </div>
      </div>
      {toast && <div className="fixed bottom-24 inset-x-0 z-50 mx-auto w-fit rounded-full bg-navy-800 px-4 py-2 text-sm text-white shadow-lg" role="status" aria-live="polite">{toast}</div>}
    </div>
  )
}

