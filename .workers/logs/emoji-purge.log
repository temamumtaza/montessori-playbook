function Row({ icon, color, title, subtitle, children }: { icon: string; color: string; title: string; subtitle: string; children: React.ReactNode }) { return <div className="flex items-center gap-3 px-4 min-h-[68px] border-b border-sky-100 dark:border-navy-700"><span className={`w-10 h-10 rounded-full ${color} grid place-items-center`} aria-hidden>{icon}</span><span className="flex-1 min-w-0"><strong className="block text-sm">{title}</strong><span className="block text-xs opacity-65 mt-0.5">{subtitle}</span></span>{children}</div> }
function LinkRow({ icon, color, title, subtitle, href }: { icon: string; color: string; title: string; subtitle: string; href: string }) { return <a href={href} className="flex items-center gap-3 px-4 min-h-[68px] border-b border-sky-100 dark:border-navy-700"><span className={`w-10 h-10 rounded-full ${color} grid place-items-center`} aria-hidden>{icon}</span><span className="flex-1"><strong className="block text-sm">{title}</strong><span className="block text-xs opacity-65 mt-0.5">{subtitle}</span></span><span className="text-xl text-sky-600 dark:text-sky-300" aria-hidden>›</span></a> }
function Expandable({ open, setOpen, icon, color, title, subtitle, children }: { open: boolean; setOpen: (value: boolean) => void; icon: string; color: string; title: string; subtitle: string; children: React.ReactNode }) { return <><button onClick={() => setOpen(!open)} aria-expanded={open} className="w-full text-left"><div className="flex items-center gap-3 px-4 min-h-[68px] border-b border-sky-100 dark:border-navy-700"><span className={`w-10 h-10 rounded-full ${color} grid place-items-center`} aria-hidden>{icon}</span><span className="flex-1"><strong className="block text-sm">{title}</strong><span className="block text-xs opacity-65 mt-0.5">{subtitle}</span></span><span className="text-xl text-sky-600 dark:text-sky-300" aria-hidden>{open ? '⌃' : '›'}</span></div></button>{open && <div className="border-b border-sky-100 dark:border-navy-700 px-4 py-3 text-sm leading-relaxed">{children}</div>}</> }
function InfoSection({ title, text, href, children }: { title: string; text: string; href: string; children: React.ReactNode }) { return <section className="rounded-3xl bg-white dark:bg-navy-800 p-4 shadow-sky-sm"><h2 className="font-[family-name:var(--font-display)] font-bold text-lg">{title}</h2><p className="text-sm opacity-70 mt-1">{text}</p><a href={href} className="mt-3 flex items-center justify-between rounded-2xl bg-sky-50 dark:bg-navy-700 px-4 min-h-[48px] font-semibold text-sky-700 dark:text-sky-300">{children}<span aria-hidden>→</span></a></section> }
function AddChildForm({ onAdd }: { onAdd: (nickname: string, birthDate: string, avatar?: string) => void }) { const [open, setOpen] = useState(false); const [nickname, setNickname] = useState(''); const [birth, setBirth] = useState(''); if (!open) return <button onClick={() => setOpen(true)} className="mt-3 w-full rounded-full border-2 border-dashed border-sky-300 dark:border-navy-600 text-sky-700 dark:text-sky-300 min-h-[48px] font-medium">+ Tambah anak</button>; return <form className="mt-3 space-y-2" onSubmit={(event) => { event.preventDefault(); if (!nickname.trim() || !birth) return; onAdd(nickname.trim(), birth, '🐥'); setOpen(false); setNickname(''); setBirth('') }}><input value={nickname} onChange={(event) => setNickname(event.target.value)} placeholder="Nama panggilan" className="w-full rounded-2xl border border-sky-200 dark:border-navy-700 px-4 min-h-[48px]" required /><input type="date" value={birth} onChange={(event) => setBirth(event.target.value)} className="w-full rounded-2xl border border-sky-200 dark:border-navy-700 px-4 min-h-[48px]" required /><div className="flex gap-2"><button type="button" onClick={() => setOpen(false)} className="flex-1 rounded-full border min-h-[44px]">Batal</button><button type="submit" className="flex-1 rounded-full bg-sky-600 text-white min-h-[44px]">Simpan</button></div></form> }
import { useEffect, useMemo, useState } from 'react'
import { loadGlobal } from '../../content/store'
import type { RoomSetup } from '../../content/schema'
import { db } from '../db'
import { useChildStore } from '../stores/children'
import { Mascot, RainbowDeco } from '../components/icons'

const ROOM_META: Record<RoomSetup['room'], { label: string; icon: string }> = {
  'kamar-anak': { label: 'Kamar anak', icon: '🛏️' },
  'kamar-mandi': { label: 'Kamar mandi', icon: '🛁' },
  dapur: { label: 'Dapur', icon: '🍳' },
  'ruang-keluarga': { label: 'Ruang keluarga', icon: '🛋️' },
  'area-makan': { label: 'Area makan', icon: '🍽️' },
  outdoor: { label: 'Outdoor', icon: '🌿' },
}

const ROOM_ORDER: RoomSetup['room'][] = ['kamar-anak', 'kamar-mandi', 'dapur', 'ruang-keluarga', 'area-makan', 'outdoor']

export function EnvironmentPage() {
  const activeId = useChildStore((s) => s.activeId)
  const [rooms, setRooms] = useState<RoomSetup[]>([])
  const [selectedRoom, setSelectedRoom] = useState<RoomSetup['room']>('kamar-anak')
  const [done, setDone] = useState<Set<number>>(new Set())
  const [loading, setLoading] = useState(true)

  useEffect(() => {
    loadGlobal().then((global) => {
      setRooms(global.roomSetups)
      if (global.roomSetups.length > 0) setSelectedRoom(global.roomSetups[0].room)
      setLoading(false)
    })
  }, [])

  const room = useMemo(() => rooms.find((r) => r.room === selectedRoom), [rooms, selectedRoom])

  useEffect(() => {
    let cancelled = false
    if (!activeId || !room) {
      setDone(new Set())
      return
    }
    db.checklists.where('childId').equals(activeId).toArray().then((records) => {
      if (!cancelled) setDone(new Set(records.filter((r) => r.checklistId === room.id && r.done).map((r) => r.itemId)))
    })
    return () => { cancelled = true }
  }, [activeId, room])

  async function toggleItem(itemId: number) {
    if (!activeId || !room) return
    const nextDone = !done.has(itemId)
    setDone((current) => {
      const next = new Set(current)
      if (nextDone) next.add(itemId)
      else next.delete(itemId)
      return next
    })
    await db.checklists.put({ childId: activeId, checklistId: room.id, itemId, done: nextDone })
  }

  if (loading) return <div className="px-5 py-12 text-center text-sm opacity-75">Menyiapkan panduan ruangan…</div>

  return (
    <div className="px-5 space-y-5">
      <section className="relative overflow-hidden rounded-3xl bg-white dark:bg-navy-800 p-5 shadow-sm">
        <RainbowDeco className="absolute -right-1 -top-1 w-20 opacity-70" />
        <h2 className="relative font-[family-name:var(--font-display)] text-2xl font-bold">Persiapan rumah</h2>
        <p className="relative mt-1 max-w-sm text-sm opacity-70">Buat lingkungan yang mengundang anak untuk bergerak, memilih, dan mandiri.</p>
      </section>

      <section aria-label="Pilih ruangan">
        <div className="flex gap-2 overflow-x-auto hide-scrollbar -mx-1 px-1 pb-1">
          {ROOM_ORDER.map((roomId) => {
            const meta = ROOM_META[roomId]
            const available = rooms.some((r) => r.room === roomId)
            return (
              <button
                key={roomId}
                onClick={() => setSelectedRoom(roomId)}
                disabled={!available}
                aria-pressed={selectedRoom === roomId}
                className={`shrink-0 rounded-2xl px-3 min-h-[64px] border-2 transition active:scale-[0.97] ${
                  selectedRoom === roomId ? 'bg-sky-600 border-sky-600 text-white shadow-md' : 'bg-white dark:bg-navy-800 border-sky-100 dark:border-navy-700'
                } ${!available ? 'opacity-40' : ''}`}
              >
                <span className="block text-xl" aria-hidden>{meta.icon}</span>
                <span className="block text-[11px] font-semibold mt-0.5">{meta.label}</span>
              </button>
            )
          })}
        </div>
      </section>

      {!room ? (
        <div className="rounded-3xl bg-white dark:bg-navy-800 p-6 text-center shadow-sm">
          <Mascot className="w-28 mx-auto" mood="sleepy" />
          <p className="mt-2 text-sm opacity-70">Panduan ruangan belum tersedia.</p>
        </div>
      ) : (
        <>
          <section className="rounded-3xl bg-white dark:bg-navy-800 p-5 shadow-sm">
            <h2 className="font-[family-name:var(--font-display)] text-xl font-bold">{room.title}</h2>
            <div className="mt-4 flex items-center justify-between text-sm font-medium">
              <span>Progres persiapan</span>
              <span className="text-sky-600 dark:text-sky-400">{done.size}/{room.items.length}</span>
            </div>
            <div className="mt-2 h-2.5 overflow-hidden rounded-full bg-sky-100 dark:bg-navy-700" aria-label={`${done.size} dari ${room.items.length} item selesai`} role="progressbar" aria-valuemin={0} aria-valuemax={room.items.length} aria-valuenow={done.size}>
              <div className="h-full rounded-full bg-sky-600 transition-all" style={{ width: `${room.items.length ? (done.size / room.items.length) * 100 : 0}%` }} />
            </div>
            {!activeId && <p className="mt-3 text-xs text-apple-600">Pilih atau buat profil anak di menu Lainnya agar progres tersimpan.</p>}
          </section>

          <section className="rounded-3xl bg-white dark:bg-navy-800 p-5 shadow-sm">
            <h3 className="font-[family-name:var(--font-display)] text-lg font-bold">Prinsip penataan</h3>
            <ul className="mt-3 space-y-3 text-sm">
              {room.principles.map((principle) => <li key={principle} className="flex gap-2"><span className="text-sky-500" aria-hidden>✦</span><span>{principle}</span></li>)}
            </ul>
          </section>

          <section>
            <h3 className="mb-2.5 font-[family-name:var(--font-display)] text-lg font-bold">Checklist perlengkapan</h3>
            <div className="space-y-3">
              {room.items.map((item, index) => (
                <label key={item.name} className={`block rounded-3xl bg-white dark:bg-navy-800 p-4 shadow-sm transition ${done.has(index) ? 'ring-2 ring-leaf-300' : ''}`}>
                  <span className="flex items-start gap-3">
                    <input type="checkbox" checked={done.has(index)} onChange={() => toggleItem(index)} disabled={!activeId} className="mt-1 h-5 w-5 accent-sky-600" />
                    <span className="min-w-0 flex-1">
                      <span className={`block font-semibold ${done.has(index) ? 'line-through opacity-70' : ''}`}>{item.name}</span>
                      <span className="mt-2 grid gap-1 text-xs opacity-75"><span><b className="text-leaf-700 dark:text-leaf-300">Rendah:</b> {item.budgetRendah}</span>{item.budgetSedang && <span><b className="text-mango-700 dark:text-mango-300">Sedang:</b> {item.budgetSedang}</span>}</span>
                      <span className="mt-2 flex flex-wrap gap-1.5">{item.essential && <span className="rounded-full bg-sky-100 dark:bg-navy-700 px-2 py-0.5 text-[10px] font-semibold text-sky-700 dark:text-sky-300">Esensial</span>}{item.diy && <span className="rounded-full bg-sunny-100 px-2 py-0.5 text-[10px] font-semibold text-sunny-700">DIY</span>}</span>
                    </span>
                  </span>
                </label>
              ))}
            </div>
          </section>

          <section className="rounded-3xl bg-tosca-50 dark:bg-navy-800 p-5 shadow-sm">
            <h3 className="font-[family-name:var(--font-display)] text-lg font-bold">Tips tata letak</h3>
            <ul className="mt-3 space-y-2 text-sm">{room.layoutTips.map((tip) => <li key={tip} className="flex gap-2"><span aria-hidden>💡</span><span>{tip}</span></li>)}</ul>
          </section>
        </>
      )}
    </div>
  )
}
import { useLiveQuery } from 'dexie-react-hooks'
import { db } from '../db'
import { useChildStore } from '../stores/children'
import { loadBundle } from '../../content/store'
import { useEffect, useState } from 'react'
import type { Milestone } from '../../content/schema'
import { EmptyState } from './TodayPage'
import { ConfettiBurst } from '../components/icons'

export function ProgressPage() {
  const activeId = useChildStore((s) => s.activeId)
  const [milestones, setMilestones] = useState<Milestone[] | null>(null)
  const [confettiSeed, setConfettiSeed] = useState<number | null>(null)
  const [toast, setToast] = useState('')

  useEffect(() => {
    if (!toast) return
    const timer = window.setTimeout(() => setToast(''), 1800)
    return () => window.clearTimeout(timer)
  }, [toast])

  useEffect(() => {
    if (confettiSeed === null) return
    const timer = window.setTimeout(() => setConfettiSeed(null), 1800)
    return () => window.clearTimeout(timer)
  }, [confettiSeed])

  useEffect(() => {
    const st = useChildStore.getState()
    const c = st.children.find((x) => x.id === st.activeId)
    if (!c) return
    import('../stores/children').then(({ ageBandFromBirth }) => {
      loadBundle(ageBandFromBirth(c.birthDate)).then((b) => setMilestones(b.milestones))
    })
  }, [activeId])

  const mastery = useLiveQuery(
    async () => {
      if (!activeId) return []
      return db.mastery.where('childId').equals(activeId).toArray()
    },
    [activeId],
  )

  const doneCount = mastery?.filter((m) => m.level !== 'belum').length ?? 0

  if (!milestones) return <p className="px-5 text-sm opacity-70">Memuat…</p>

  return (
    <div className="px-5 space-y-4">
      <section className="rounded-blob bg-gradient-to-br from-leaf-100 to-cream-100 dark:from-navy-800 dark:to-navy-700 p-5">
        <h2 className="font-[family-name:var(--font-display)] text-xl font-bold">Perkembangan 🌱</h2>
        <p className="text-sm opacity-75 mt-1">
          {doneCount} tanda dicatat. Setiap anak punya tempo sendiri — ini peta, bukan lomba.
        </p>
        {milestones.length > 0 && (
          <a href="#/belajar" className="mt-3 inline-flex items-center rounded-full border border-sky-600 bg-white/80 px-4 min-h-[48px] font-semibold text-sky-700 dark:border-sky-300 dark:bg-navy-800/80 dark:text-sky-200">
            🚩 Lihat red flags usia ini
          </a>
        )}
      </section>

      {milestones.length === 0 ? (
        <EmptyState title="Milestone usia ini belum tersedia" text="Konten progres sedang dibangun bertahap." />
      ) : (
        <ul className="space-y-3">
          {milestones.map((m) => {
            const rec = mastery?.find((x) => x.targetId === m.id)
            return (
              <li key={m.id} className="rounded-blob bg-white dark:bg-navy-800 p-4 shadow-sm">
                <div className="flex justify-between gap-2">
                  <div>
                    <h3 className="font-semibold text-sm">{m.title}</h3>
                    <p className="text-xs opacity-75 mt-1">{m.description}</p>
                  </div>
                  <Segmented
                    value={rec?.level ?? 'belum'}
                    onChange={async (lv) => {
                      if (!activeId) return
                      if (lv === 'mahir' && rec?.level !== 'mahir') {
                        setConfettiSeed(Date.now())
                        setToast('🎉 Milestone mahir!')
                      }
                      await db.mastery.put({ childId: activeId, targetId: m.id, kind: 'milestone', level: lv, updatedAt: Date.now() })
                    }}
                  />
                </div>
              </li>
            )
          })}
        </ul>
      )}
      {confettiSeed !== null && (
        <div className="pointer-events-none fixed inset-x-0 top-20 z-50 h-48 overflow-hidden" aria-hidden>
          {[0, 1, 2, 3, 4].map((i) => (
            <ConfettiBurst
              key={`${confettiSeed}-${i}`}
              className="confetti-fall absolute h-10 w-20"
              style={{ left: `${12 + ((confettiSeed + i * 23) % 76)}%`, top: `${i * 4}px`, animationDelay: `${i * 0.06}s` }}
            />
          ))}
        </div>
      )}
      {toast && <div className="fixed bottom-24 inset-x-0 z-50 mx-auto w-fit rounded-full bg-navy-800 px-4 py-2 text-sm text-white shadow-lg" role="status" aria-live="polite">{toast}</div>}
    </div>
  )
}

function Segmented({ value, onChange }: { value: 'belum' | 'mulai' | 'mahir'; onChange: (v: 'belum' | 'mulai' | 'mahir') => void }) {
  const opts = ['belum', 'mulai', 'mahir'] as const
  return (
    <div role="radiogroup" aria-label="Status" className="flex flex-col gap-1 shrink-0">
      {opts.map((o) => (
        <button
          key={o}
          role="radio"
          aria-checked={value === o}
          onClick={() => onChange(o)}
          className={`text-[11px] rounded-full px-2.5 min-h-[28px] border transition ${
            value === o ? 'bg-leaf-600 text-white border-leaf-600' : 'border-sky-200 dark:border-navy-700 opacity-70'
          }`}
        >
          {o}
        </button>
      ))}
    </div>
  )
}
import { useEffect, useState } from 'react'
import { useSearchParams } from 'react-router-dom'
import { loadBundle, loadGlobal } from '../../content/store'
import type { Milestone, ParentGuide } from '../../content/schema'
import { AGE_BANDS } from '../../content/meta'
import { EmptyState } from './TodayPage'
import { ageBandFromBirth, useChildStore } from '../stores/children'

type Tab = 'guides' | 'red-flags'

const CATEGORY_LABELS: Record<ParentGuide['category'], string> = {
  filosofi: 'Filosofi',
  komunikasi: 'Komunikasi',
  disiplin: 'Disiplin',
  rutinitas: 'Rutinitas',
  'screen-time': 'Screen time',
  sibling: 'Saudara',
  toilet: 'Toilet learning',
  tantrum: 'Tantrum',
  observasi: 'Observasi',
  'self-care': 'Merawat diri',
}

const CATEGORY_CLASSES: Record<ParentGuide['category'], string> = {
  filosofi: 'bg-grape-100 text-grape-700',
  komunikasi: 'bg-sky-100 text-sky-700',
  disiplin: 'bg-apple-100 text-apple-700',
  rutinitas: 'bg-leaf-100 text-leaf-700',
  'screen-time': 'bg-mango-100 text-mango-700',
  sibling: 'bg-tosca-100 text-tosca-700',
  toilet: 'bg-sunny-100 text-sunny-800',
  tantrum: 'bg-candy-100 text-candy-700',
  observasi: 'bg-sky-100 text-sky-700',
  'self-care': 'bg-leaf-100 text-leaf-700',
}

export function LearnPage() {
  const [searchParams] = useSearchParams()
  const activeId = useChildStore((s) => s.activeId)
  const child = useChildStore((s) => s.children.find((c) => c.id === s.activeId))
  const [tab, setTab] = useState<Tab>('guides')
  const [guides, setGuides] = useState<ParentGuide[] | null>(null)
  const [redFlags, setRedFlags] = useState<Milestone[] | null>(null)

  useEffect(() => {
    setTab(searchParams.get('tab') === 'red-flags' ? 'red-flags' : 'guides')
  }, [searchParams])

  useEffect(() => {
    let cancelled = false
    loadGlobal().then((global) => {
      if (!cancelled) setGuides(global.parentGuides)
    })
    return () => { cancelled = true }
  }, [])

  useEffect(() => {
    let cancelled = false
    setRedFlags(null)
    if (!child || !activeId) {
      setRedFlags([])
      return () => { cancelled = true }
    }
    loadBundle(ageBandFromBirth(child.birthDate)).then((bundle) => {
      if (!cancelled) setRedFlags(bundle.milestones.filter((milestone) => milestone.redFlags.length > 0))
    })
    return () => { cancelled = true }
  }, [activeId, child])

  return (
    <div className="px-5 space-y-4">
      <section className="rounded-3xl bg-sunny-100 dark:bg-navy-800 p-4 flex items-start gap-3">
        <span className="text-xl" aria-hidden>⚠️</span>
        <p className="text-sm text-sky-900 dark:text-sky-100">
          Bukan pengganti nasihat dokter. Jika ada kekhawatiran tentang tumbuh kembang anak, konsultasikan dengan dokter atau tenaga kesehatan.
        </p>
      </section>

      <div className="grid grid-cols-2 gap-1 rounded-full bg-sky-100 dark:bg-navy-800 p-1" role="tablist" aria-label="Pilih isi panduan">
        <TabButton active={tab === 'guides'} onClick={() => setTab('guides')} id="guides-tab">Panduan</TabButton>
        <TabButton active={tab === 'red-flags'} onClick={() => setTab('red-flags')} id="red-flags-tab">Red Flags</TabButton>
      </div>

      {tab === 'guides' ? (
        guides === null ? <Loading /> : guides.length === 0 ? (
          <EmptyState title="Panduan belum tersedia" text="Panduan orang tua sedang disiapkan." mood="sleepy" />
        ) : (
          <div className="space-y-3" role="tabpanel" aria-labelledby="guides-tab">
            {guides.map((guide) => <GuideCard key={guide.id} guide={guide} />)}
          </div>
        )
      ) : redFlags === null ? (
        <Loading />
      ) : redFlags.length === 0 ? (
        <EmptyState title="Belum ada red flags" text="Belum ada catatan red flags untuk rentang usia ini." mood="happy" />
      ) : (
        <div className="space-y-3" role="tabpanel" aria-labelledby="red-flags-tab">
          {redFlags.map((milestone) => (
            <article key={milestone.id} className="rounded-3xl bg-white dark:bg-navy-800 shadow-sm p-4">
              <h2 className="font-[family-name:var(--font-display)] font-bold">{milestone.title}</h2>
              <ul className="mt-2 space-y-2 text-sm text-apple-700 dark:text-apple-300">
                {milestone.redFlags.map((flag) => <li key={flag} className="flex gap-2"><span aria-hidden>•</span><span>{flag}</span></li>)}
              </ul>
            </article>
          ))}
        </div>
      )}
    </div>
  )
}

function TabButton({ active, onClick, id, children }: { active: boolean; onClick: () => void; id: string; children: string }) {
  return (
    <button
      id={id}
      role="tab"
      aria-selected={active}
      onClick={onClick}
      className={`rounded-full min-h-[48px] px-4 text-sm font-semibold transition ${active ? 'bg-white dark:bg-navy-700 text-sky-700 dark:text-sky-200 shadow-sm' : 'opacity-70'}`}
    >
      {children}
    </button>
  )
}

function GuideCard({ guide }: { guide: ParentGuide }) {
  const [open, setOpen] = useState(false)
  const bandLabels = guide.ageBands.map((id) => AGE_BANDS.find((band) => band.id === id)?.label).filter(Boolean)

  return (
    <article className="rounded-3xl bg-white dark:bg-navy-800 shadow-sm overflow-hidden">
      <button onClick={() => setOpen((value) => !value)} aria-expanded={open} className="w-full text-left p-4 min-h-[48px]">
        <div className="flex items-start justify-between gap-3">
          <span className={`rounded-full px-2.5 py-1 text-[11px] font-semibold ${CATEGORY_CLASSES[guide.category]}`}>
            {CATEGORY_LABELS[guide.category]}
          </span>
          <span className="text-sky-600 dark:text-sky-300" aria-hidden>{open ? '⌃' : '⌄'}</span>
        </div>
        <h2 className="font-[family-name:var(--font-display)] text-lg font-bold mt-2">{guide.title}</h2>
        {bandLabels.length > 0 && <p className="text-xs opacity-70 mt-1">{bandLabels.join(' · ')}</p>}
        <ul className="mt-3 space-y-1 text-sm opacity-80">
          {guide.keyTakeaways.slice(0, 2).map((takeaway) => <li key={takeaway} className="flex gap-2"><span className="text-leaf-600" aria-hidden>✓</span><span>{takeaway}</span></li>)}
        </ul>
      </button>
      {open && <div className="border-t border-sky-100 dark:border-navy-700 px-4 pb-4 pt-3 text-sm leading-relaxed space-y-3">{renderBody(guide.body)}</div>}
    </article>
  )
}

function renderBody(body: string) {
  return body.split(/\n\n+/).map((paragraph, index) => (
    <p key={`${paragraph}-${index}`}>{renderBold(paragraph)}</p>
  ))
}

function renderBold(text: string) {
  return text.split(/(\*\*[^*]+\*\*)/g).map((part, index) =>
    part.startsWith('**') && part.endsWith('**')
      ? <strong key={index}>{part.slice(2, -2)}</strong>
      : <span key={index}>{part}</span>,
  )
}

function Loading() {
  return <div className="rounded-3xl bg-white dark:bg-navy-800 p-6 text-center text-sm opacity-70">Memuat panduan…</div>
}
import { useEffect, useRef, useState } from 'react'
import { loadGlobal, searchActivities } from '../../content/store'
import type { Activity, GlossaryEntry } from '../../content/schema'
import { areaById } from '../../content/meta'
import { AreaIcon } from '../components/icons'
import { AREA_GRADIENTS, EmptyState, SkeletonCards } from './TodayPage'

export function SearchGlossaryPage() {
  const [query, setQuery] = useState('')
  const [activities, setActivities] = useState<Activity[]>([])
  const [glossary, setGlossary] = useState<GlossaryEntry[]>([])
  const [loadingGlobal, setLoadingGlobal] = useState(true)
  const [searching, setSearching] = useState(false)
  const requestId = useRef(0)

  useEffect(() => { loadGlobal().then((global) => { setGlossary(global.glossary); setLoadingGlobal(false) }) }, [])
  useEffect(() => {
    const q = query.trim(); const id = ++requestId.current
    if (!q) { setActivities([]); setSearching(false); return }
    setSearching(true)
    const timer = window.setTimeout(() => { searchActivities(q).then((results) => { if (id === requestId.current) { setActivities(results); setSearching(false) } }) }, 250)
    return () => window.clearTimeout(timer)
  }, [query])

  const normalizedQuery = query.trim().toLocaleLowerCase()
  const filteredGlossary = glossary.filter((entry) => !normalizedQuery || entry.term.toLocaleLowerCase().includes(normalizedQuery) || entry.definition.toLocaleLowerCase().includes(normalizedQuery))
  return (
    <div className="px-5 space-y-6">
      <div className="sticky top-0 z-30 -mx-5 px-5 py-2 bg-sky-50/90 dark:bg-navy-900/90 backdrop-blur-md">
        <label className="sr-only" htmlFor="activity-search">Cari aktivitas atau glosarium</label>
        <div className="flex items-center gap-3 rounded-full bg-white dark:bg-navy-800 shadow-sm px-5 min-h-[56px]"><span aria-hidden className="text-lg">🔍</span><input id="activity-search" value={query} onChange={(event) => setQuery(event.target.value)} placeholder="Cari aktivitas atau istilah…" className="min-w-0 flex-1 bg-transparent text-base text-sky-900 dark:text-sky-100 placeholder:text-sky-900/45 dark:placeholder:text-sky-100/45 outline-none" type="search" autoComplete="off" />{query && <button type="button" onClick={() => setQuery('')} aria-label="Hapus pencarian" className="w-8 h-8 rounded-full text-sky-900/50 dark:text-sky-100/50">✕</button>}</div>
      </div>
      {query.trim() && <section aria-labelledby="activity-results-title"><h2 id="activity-results-title" className="font-[family-name:var(--font-display)] font-bold text-lg mb-2.5">Aktivitas <span className="opacity-50 text-base">({activities.length})</span></h2>{searching ? <SkeletonCards n={3} /> : activities.length === 0 ? <EmptyState title="Aktivitas belum ditemukan" text="Coba kata kunci lain, seperti menuang, bahasa, atau sensorik." mood="sleepy" /> : <ul className="space-y-3">{activities.map((activity) => <ActivityResult key={activity.id} activity={activity} />)}</ul>}</section>}
      <section aria-labelledby="glossary-title"><h2 id="glossary-title" className="font-[family-name:var(--font-display)] font-bold text-lg">Glosarium <span className="opacity-50 text-base">({filteredGlossary.length})</span></h2>{loadingGlobal ? <GlossarySkeleton /> : filteredGlossary.length === 0 ? <EmptyState title="Istilah belum ditemukan" text="Coba cari istilah Montessori yang lain." mood="sleepy" /> : <dl className="space-y-3">{filteredGlossary.map((entry) => <div key={entry.term} className="rounded-3xl bg-white dark:bg-navy-800 shadow-sm p-4"><dt className="font-semibold">{entry.term}</dt><dd className="text-sm opacity-70 mt-1 leading-relaxed">{entry.definition}</dd></div>)}</dl>}</section>
    </div>
  )
}

function ActivityResult({ activity }: { activity: Activity }) {
  const area = areaById(activity.areas[0]); const gradient = AREA_GRADIENTS[activity.areas[0]] ?? 'from-sky-500 to-sky-700'
  return <li><article className="rounded-3xl bg-white dark:bg-navy-800 shadow-sm overflow-hidden active:scale-[0.98] transition"><a href={`#/aktivitas/${activity.id}`} aria-label={activity.title} className="flex items-stretch"><div className={`w-24 shrink-0 bg-gradient-to-br ${gradient} bg-black/15 bg-blend-overlay grid place-items-center relative`}><AreaIcon area={activity.areas[0]} className="w-10 h-10 text-white/95 drop-shadow" /><span className="absolute bottom-2 left-1.5 right-1.5 text-center text-[9px] font-semibold bg-white/90 text-sky-800 rounded-full px-1 py-0.5 truncate">{area?.label}</span></div><div className="p-3.5 min-w-0"><h3 className="font-semibold leading-snug">{activity.title}</h3><p className="text-xs opacity-75 mt-1 line-clamp-2">{activity.summary}</p><p className="text-[11px] opacity-70 mt-2">⏱ {activity.durationMinutes} mnt</p></div></a></article></li>
}

function GlossarySkeleton() { return <div className="space-y-3 animate-pulse" aria-hidden>{[1, 2, 3].map((item) => <div key={item} className="rounded-3xl bg-white dark:bg-navy-800 p-4 space-y-2"><div className="h-4 w-1/3 rounded bg-sky-100 dark:bg-navy-700" /><div className="h-3 w-full rounded bg-sky-50 dark:bg-navy-700/60" /><div className="h-3 w-4/5 rounded bg-sky-50 dark:bg-navy-700/60" /></div>)}</div> }
import { useEffect, useState } from 'react'
import { loadAllActivities } from '../../content/store'
import { AGE_BANDS, AREAS, areaById } from '../../content/meta'
import type { Activity, AgeBandId } from '../../content/schema'
import { EmptyState, SkeletonCards, AREA_GRADIENTS, BookmarkButton } from './TodayPage'
import { AreaIcon } from '../components/icons'

type Filters = { band: AgeBandId | 'semua'; area: string | 'semua'; durasi: 'semua' | 'pendek' | 'sedang'; fromHome: boolean }

const CHIP_ACTIVE: Record<string, string> = {
  '0-3m': 'bg-sky-500', '3-6m': 'bg-tosca-500', '6-9m': 'bg-leaf-500',
  '9-12m': 'bg-sunny-500', '12-18m': 'bg-mango-500', '18-24m': 'bg-candy-500',
  '2-3y': 'bg-apple-500', '3-4y': 'bg-grape-500', '4-5y': 'bg-sky-600',
}

export function PlaybookPage() {
  const [acts, setActs] = useState<Activity[] | null>(null)
  const [f, setF] = useState<Filters>({ band: 'semua', area: 'semua', durasi: 'semua', fromHome: false })
  const [toast, setToast] = useState('')
  useEffect(() => {
    if (!toast) return
    const timer = window.setTimeout(() => setToast(''), 1500)
    return () => window.clearTimeout(timer)
  }, [toast])

  useEffect(() => {
    loadAllActivities().then(setActs)
  }, [])

  const filtered = (acts ?? []).filter((a) => {
    if (f.band !== 'semua' && !a.ageBands.includes(f.band)) return false
    if (f.area !== 'semua' && !a.areas.includes(f.area as never)) return false
    if (f.durasi === 'pendek' && a.durationMinutes > 15) return false
    if (f.durasi === 'sedang' && (a.durationMinutes < 15 || a.durationMinutes > 40)) return false
    if (f.fromHome && !a.materials.every((m) => m.fromHome)) return false
    return true
  })

  return (
    <div className="px-5 space-y-3">
      {/* Chips usia */}
      <div className="hide-scrollbar -mx-5 px-5 flex gap-2 overflow-x-auto pb-1" role="group" aria-label="Filter usia">
        <Chip active={f.band === 'semua'} onClick={() => setF({ ...f, band: 'semua' })}>Semua</Chip>
        {AGE_BANDS.map((b) => (
          <button
            key={b.id}
            aria-pressed={f.band === b.id}
            onClick={() => setF({ ...f, band: f.band === b.id ? 'semua' : b.id })}
            className={`shrink-0 w-[68px] rounded-2xl border-2 py-2 text-center transition active:scale-95 ${
              f.band === b.id
                ? `${CHIP_ACTIVE[b.id]} border-transparent text-white shadow-md`
                : 'bg-white dark:bg-navy-800 border-sky-100 dark:border-navy-700 text-sky-900 dark:text-sky-100'
            }`}
          >
            <span className="block text-base leading-none" aria-hidden>{b.mascot}</span>
            <span className="block text-[10px] font-semibold mt-1">{b.id}</span>
          </button>
        ))}
      </div>

      {/* Grid area warna */}
      <section aria-label="Area Montessori">
        <h3 className="font-[family-name:var(--font-display)] font-bold text-lg mb-2">Area Montessori</h3>
        <div className="grid grid-cols-3 gap-2.5">
          {AREAS.map((a) => {
            const active = f.area === a.id
            const grad = AREA_GRADIENTS[a.id] ?? 'from-sky-500 to-sky-700'
            return (
              <button
                key={a.id}
                onClick={() => setF({ ...f, area: active ? 'semua' : a.id })}
                aria-pressed={active}
                className={`rounded-3xl p-3.5 text-left aspect-[5/4] bg-gradient-to-br ${grad} bg-black/15 bg-blend-overlay text-white shadow-sm transition active:scale-[0.96] relative overflow-hidden ${
                  active ? 'ring-4 ring-sky-300 scale-[1.02]' : ''
                }`}
              >
                <AreaIcon area={a.id} className="w-9 h-9 drop-shadow" />
                <span className="absolute bottom-2.5 left-3 right-2 text-xs font-bold leading-tight drop-shadow-sm">
                  {a.label}
                </span>
              </button>
            )
          })}
        </div>
      </section>

      {/* Filter durasi & bahan */}
      <div className="hide-scrollbar -mx-5 px-5 flex gap-2 overflow-x-auto pb-1" role="group" aria-label="Filter lainnya">
        <Chip active={f.durasi === 'pendek'} onClick={() => setF({ ...f, durasi: f.durasi === 'pendek' ? 'semua' : 'pendek' })}>≤ 15 menit</Chip>
        <Chip active={f.durasi === 'sedang'} onClick={() => setF({ ...f, durasi: f.durasi === 'sedang' ? 'semua' : 'sedang' })}>15–40 menit</Chip>
        <Chip active={f.fromHome} onClick={() => setF({ ...f, fromHome: !f.fromHome })}>🏠 Bahan di Rumah</Chip>
      </div>

      {/* Hasil */}
      <section>
        <h3 className="font-[family-name:var(--font-display)] font-bold text-lg mb-2">
          Semua Aktivitas <span className="opacity-50 text-base">({filtered.length})</span>
        </h3>
        {!acts ? (
          <SkeletonCards n={4} />
        ) : filtered.length === 0 ? (
          <EmptyState title="Belum ada yang cocok" text="Coba longgarkan filternya — konten masih terus bertambah." />
        ) : (
          <ul className="space-y-3">
            {filtered.map((a) => {
              const area = areaById(a.areas[0])
              const grad = AREA_GRADIENTS[a.areas[0]] ?? 'from-sky-500 to-sky-700'
              return (
                <li key={a.id}>
                  <article className="relative rounded-3xl bg-white dark:bg-navy-800 shadow-sky-sm overflow-hidden active:scale-[0.98] transition">
                    <a href={`#/aktivitas/${a.id}`} aria-label={a.title} className="block">
                      <div className={`relative h-24 bg-gradient-to-br ${grad} grid place-items-center bg-black/15 bg-blend-overlay`}>
                        <AreaIcon area={a.areas[0]} className="w-11 h-11 text-white/95 drop-shadow" />
                        <span className="absolute top-2 left-2 text-[10px] font-semibold bg-white/90 text-sky-800 rounded-full px-2 py-0.5">{area?.label}</span>
                      </div>
                      <div className="p-4">
                        <h4 className="font-semibold">{a.title}</h4>
                        <p className="text-sm opacity-70 mt-1 line-clamp-2">{a.summary}</p>
                        <div className="flex gap-1.5 mt-2.5 flex-wrap"><Badge>⏱ {a.durationMinutes} mnt</Badge><Badge>{a.ageBands.join(' · ')}</Badge></div>
                      </div>
                    </a>
                    <BookmarkButton activityId={a.id} onToast={setToast} />
                  </article>
                </li>
              )
            })}
          </ul>
        )}
      </section>
      {toast && <div className="fixed bottom-24 inset-x-0 z-50 mx-auto w-fit rounded-full bg-navy-800 px-4 py-2 text-sm text-white shadow-lg" role="status" aria-live="polite">{toast}</div>}
    </div>
  )
}

function Chip({ active, onClick, children }: { active: boolean; onClick: () => void; children: React.ReactNode }) {
  return (
    <button
      onClick={onClick}
      aria-pressed={active}
      className={`shrink-0 rounded-full px-4 min-h-[36px] text-sm font-medium border transition active:scale-95 ${
        active
          ? 'bg-sky-600 text-white border-sky-600'
          : 'bg-white dark:bg-navy-800 border-sky-200 dark:border-navy-700 text-sky-800 dark:text-sky-200'
      }`}
    >
      {children}
    </button>
  )
}

function Badge({ children }: { children: React.ReactNode }) {
  return <span className="text-[11px] rounded-full bg-sky-50 dark:bg-navy-700 px-2 py-0.5 text-sky-800 dark:text-sky-200">{children}</span>
}
import { BottomSheet } from './BottomSheet'

export type ActionSheetAction = {
  label: string
  icon: string
  onSelect: () => void
}

type ActionSheetProps = {
  open: boolean
  onClose: () => void
  actions: ActionSheetAction[]
}

export function ActionSheet({ open, onClose, actions }: ActionSheetProps) {
  return (
    <BottomSheet open={open} onClose={onClose} title="Pilih Aksi">
      <div className="mt-4 space-y-2">
        {actions.map((action) => (
          <button
            key={action.label}
            aria-label={action.label}
            onClick={() => { action.onSelect(); onClose() }}
            className="flex min-h-[48px] w-full items-center gap-3 rounded-2xl bg-sky-50 px-4 text-left font-semibold text-sky-800 dark:bg-navy-700 dark:text-sky-100"
          >
            <span className="text-xl" aria-hidden>{action.icon}</span>
            {action.label}
          </button>
        ))}
        <button aria-label="Batal" onClick={onClose} className="mt-2 min-h-[48px] w-full rounded-full border border-sky-200 text-sm font-semibold text-sky-700 dark:border-navy-600 dark:text-sky-200">
          Batal
        </button>
      </div>
    </BottomSheet>
  )
}
import { useEffect, useState } from 'react'

export function UpdateToast({ swUpdate }: { swUpdate: { onNeedRefresh: (cb: () => void) => () => void; applyUpdate: () => void } }) {
  const [visible, setVisible] = useState(false)

  useEffect(() => swUpdate.onNeedRefresh(() => setVisible(true)), [swUpdate])

  if (!visible) return null

  return (
    <div
      className="fixed bottom-24 inset-x-4 z-[60] mx-auto max-w-sm rounded-2xl bg-navy-800 px-4 py-3 text-white shadow-xl flex items-center gap-3 page-enter"
      role="status"
    >
      <span aria-hidden className="text-xl">✨</span>
      <p className="flex-1 text-sm">Versi baru tersedia</p>
      <button
        onClick={() => { swUpdate.applyUpdate(); setVisible(false) }}
        className="rounded-full bg-sky-500 px-4 py-2 text-sm font-semibold min-h-[40px] active:scale-95 transition"
      >
        Perbarui
      </button>
    </div>
  )
}
import { useEffect, useState, createContext, useContext } from 'react'
import { Routes, Route, NavLink, useLocation } from 'react-router-dom'
import { TodayPage } from './pages/TodayPage'
import { PlaybookPage } from './pages/PlaybookPage'
import { JournalPage } from './pages/JournalPage'
import { ProgressPage } from './pages/ProgressPage'
import { MorePage } from './pages/MorePage'
import { ActivityDetailPage } from './pages/ActivityDetailPage'
import { SearchGlossaryPage } from './pages/SearchGlossaryPage'
import { EnvironmentPage } from './pages/EnvironmentPage'
import { LearnPage } from './pages/LearnPage'
import { UpdateToast } from './components/UpdateToast'
import { swUpdate } from './pwa'
import { useChildStore } from './stores/children'
import { TabIcon } from './components/icons'

type TabScroll = Record<string, number>
const ScrollCtx = createContext<{ save: (tab: string, y: number) => void; get: (tab: string) => number }>({
  save: () => {},
  get: () => 0,
})
export const useTabScroll = () => useContext(ScrollCtx)

const TABS = [
  { to: '/', label: 'Hari Ini', icon: 'home' as const },
  { to: '/playbook', label: 'Playbook', icon: 'book-open' as const },
  { to: '/jurnal', label: 'Jurnal', icon: 'journal' as const },
  { to: '/progres', label: 'Progres', icon: 'chart' as const },
  { to: '/lainnya', label: 'Lainnya', icon: 'ellipsis' as const },
]

export default function App() {
  const location = useLocation()
  const [scrollMem, setScrollMem] = useState<TabScroll>({})
  const [isDark, setIsDark] = useState(
    () => localStorage.getItem('mp-theme') === 'dark' ||
      (localStorage.getItem('mp-theme') === null && window.matchMedia('(prefers-color-scheme: dark)').matches),
  )
  const activeChild = useChildStore((s) => s.children[0])

  useEffect(() => {
    document.documentElement.classList.toggle('dark', isDark)
    localStorage.setItem('mp-theme', isDark ? 'dark' : 'light')
  }, [isDark])

  // Simpan scroll per tab & restore saat kembali
  useEffect(() => {
    const tab = TABS.find((t) => t.to === location.pathname)?.to ?? location.pathname
    const saved = scrollMem[tab]
    if (saved !== undefined) requestAnimationFrame(() => window.scrollTo(0, saved))
    const onScroll = () => {
      setScrollMem((m) => (m[tab] === window.scrollY ? m : { ...m, [tab]: window.scrollY }))
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    return () => window.removeEventListener('scroll', onScroll)
  }, [location.pathname])

  return (
    <ScrollCtx.Provider value={{ save: () => {}, get: (t) => scrollMem[t] ?? 0 }}>
      <div className="min-h-dvh bg-sky-50 dark:bg-navy-900 text-sky-900 dark:text-sky-100 transition-colors">
        {/* Header collapsing large title */}
        <Header title={titleFor(location.pathname)} />

        <main className="px-safe pb-28 pt-2 page-enter" key={location.pathname}>
          <Routes location={location}>
            <Route path="/" element={<TodayPage />} />
            <Route path="/playbook" element={<PlaybookPage />} />
            <Route path="/aktivitas/:id" element={<ActivityDetailPage />} />
            <Route path="/cari" element={<SearchGlossaryPage />} />
            <Route path="/jurnal" element={<JournalPage />} />
            <Route path="/progres" element={<ProgressPage />} />
            <Route path="/lainnya" element={<MorePage isDark={isDark} onToggleDark={() => setIsDark((d) => !d)} />} />
            <Route path="/lingkungan" element={<EnvironmentPage />} />
            <Route path="/belajar" element={<LearnPage />} />
          </Routes>
        </main>

        <TabBar tabs={TABS} />
        <UpdateToast swUpdate={swUpdate} />
        {/* a11y: nama anak di judul dinamis */}
        <span className="sr-only" aria-live="polite">{activeChild ? `Profil aktif: ${activeChild.nickname}` : ''}</span>
      </div>
    </ScrollCtx.Provider>
  )
}

function titleFor(path: string): string {
  if (path === '/') return 'Hari Ini'
  if (path.startsWith('/cari')) return 'Cari'
  if (path.startsWith('/playbook')) return 'Playbook'
  if (path.startsWith('/jurnal')) return 'Jurnal'
  if (path.startsWith('/progres')) return 'Progres'
  if (path.startsWith('/lingkungan')) return 'Persiapan rumah'
  if (path.startsWith('/belajar')) return 'Panduan & Pemantauan'
  return 'Lainnya'
}

function Header({ title }: { title: string }) {
  const [compact, setCompact] = useState(false)
  useEffect(() => {
    const onScroll = () => setCompact(window.scrollY > 36)
    window.addEventListener('scroll', onScroll, { passive: true })
    return () => window.removeEventListener('scroll', onScroll)
  }, [])
  return (
    <header className="sticky top-0 z-40 bg-sky-50/85 dark:bg-navy-900/85 backdrop-blur-md pt-safe">
      <div className="px-5 pb-2 transition-all" style={{ height: compact ? 48 : 84 }}>
        <h1
          className={`font-[family-name:var(--font-display)] font-bold text-sky-700 dark:text-sky-300 transition-all ${compact ? 'text-xl leading-[48px]' : 'text-3xl leading-[84px]'}`}
        >
          {title}
        </h1>
      </div>
    </header>
  )
}

function TabBar({ tabs }: { tabs: typeof TABS }) {
  return (
    <nav
      aria-label="Navigasi utama"
      className="fixed bottom-0 inset-x-0 z-50 bg-white/90 dark:bg-navy-800/90 backdrop-blur-md border-t border-sky-100 dark:border-navy-700 pb-safe"
    >
      <div className="grid grid-cols-5 px-safe">
        {tabs.map((t) => (
          <NavLink
            key={t.to}
            to={t.to}
            end={t.to === '/'}
            className={({ isActive }) =>
              `flex flex-col items-center gap-0.5 py-2 min-h-[48px] justify-center text-[11px] font-medium transition-colors ${
                isActive ? 'text-sky-700 dark:text-sky-400' : 'text-sky-900/75 dark:text-sky-100/75'
              }`
            }
          >
            {({ isActive }) => (
              <>
                <TabIcon name={t.icon} className="w-5 h-5" />
                <span>{t.label}</span>
                {isActive && (
                  <span className="absolute top-0 h-0.5 w-8 rounded-full bg-sky-500 transition-all" aria-hidden />
                )}
              </>
            )}
          </NavLink>
        ))}
      </div>
    </nav>
  )
}

