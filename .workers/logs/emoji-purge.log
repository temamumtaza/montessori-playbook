+export const IconHeart = ({ filled = false, ...p }: IconProps) => <Line {...p} filled={filled}><path d="M20.8 8.8c0 5.5-8.8 10.2-8.8 10.2S3.2 14.3 3.2 8.8A4.8 4.8 0 0 1 12 6a4.8 4.8 0 0 1 8.8 2.8Z"/></Line>
