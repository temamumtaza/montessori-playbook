+export const IconDownload = (p: IconProps) => <Line {...p}><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></Line>
+export const IconUpload = (p: IconProps) => <Line {...p}><path d="M12 15V3M7 8l5-5 5 5M5 21h14"/></Line>
