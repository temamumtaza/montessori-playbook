+function GlossaryCard({ entry }: { entry: GlossaryEntry }) { const area = AREAS.find((candidate) => [candidate.id, candidate.label, candidate.labelEn].some((value) => [entry.term, ...entry.relatedTerms].some((term) => term.toLocaleLowerCase().includes(value.toLocaleLowerCase())))); return <div className="rounded-3xl bg-white dark:bg-navy-800 shadow-sky-sm p-4"><div className="flex gap-3"><div className="w-10 h-10 rounded-2xl bg-sky-50 dark:bg-navy-700 grid place-items-center shrink-0">{area ? <AreaIcon area={area.id} className="w-7 h-7 text-sky-600 dark:text-sky-300" /> : <span aria-hidden>☁️</span>}</div><div className="min-w-0"><dt className="font-semibold text-sky-900 dark:text-sky-100">{entry.term}</dt>{entry.termEn && <p className="text-xs italic opacity-60 mt-0.5">{entry.termEn}</p>}<dd className="text-sm opacity-70 mt-1 leading-relaxed">{entry.definition}</dd></div></div></div> }
+function Badge({ children, className = '' }: { children: string; className?: string }) { return <span className={`inline-block rounded-full px-2.5 py-1 text-[11px] font-semibold ${className}`}>{children}</span> }
+function ResultChip({ active, onClick, children }: { active: boolean; onClick: () => void; children: string }) { return <button onClick={onClick} aria-pressed={active} className={`shrink-0 rounded-full px-4 min-h-[36px] text-sm font-medium border transition ${active ? 'bg-sky-600 text-white border-sky-600' : 'bg-white dark:bg-navy-800 border-sky-200 dark:border-navy-700 text-sky-800 dark:text-sky-200'}`}>{children}</button> }
+function GlossarySkeleton() { return <div className="space-y-3 animate-pulse" aria-hidden>{[1, 2, 3].map((item) => <div key={item} className="rounded-3xl bg-white dark:bg-navy-800 p-4 space-y-2"><div className="h-4 w-1/3 rounded bg-sky-100 dark:bg-navy-700" /><div className="h-3 w-full rounded bg-sky-50 dark:bg-navy-700/60" /><div className="h-3 w-4/5 rounded bg-sky-50 dark:bg-navy-700/60" /></div>)}</div> }
+function searchableGlossary(entry: GlossaryEntry) { return [entry.term, entry.termEn ?? '', entry.definition, ...entry.relatedTerms].join(' ').toLocaleLowerCase() }
+function searchableGuide(guide: ParentGuide) { return [guide.title, guide.body, ...guide.keyTakeaways].join(' ').toLocaleLowerCase() }
+function readHistory() { try { const value: unknown = JSON.parse(localStorage.getItem(HISTORY_KEY) ?? '[]'); return Array.isArray(value) ? value.filter((item): item is string => typeof item === 'string').slice(0, 5) : [] } catch { return [] } }
+function saveHistory(query: string, setHistory: (items: string[]) => void) { const next = [query, ...readHistory().filter((item) => item !== query)].slice(0, 5); localStorage.setItem(HISTORY_KEY, JSON.stringify(next)); setHistory(next) }
+function removeHistory(query: string, setHistory: (items: string[]) => void) { const next = readHistory().filter((item) => item !== query); localStorage.setItem(HISTORY_KEY, JSON.stringify(next)); setHistory(next) }

