import Dexie, { type Table } from 'dexie'

export type JournalEntry = {
  id?: number
  childId: string
  createdAt: number
  note: string
  photoBlob?: Blob
  activityId?: string
  skillTags: string[]
  mood?: 'senang' | 'fokus' | 'frustrasi' | 'tenang'
}

export type MasteryRecord = {
  childId: string
  targetId: string // activity/skill/milestone id
  kind: 'activity' | 'skill' | 'milestone'
  level: 'belum' | 'mulai' | 'mahir'
  updatedAt: number
}

export type Bookmark = {
  childId: string
  targetId: string
  createdAt: number
}

export type ChecklistState = {
  childId: string
  checklistId: string
  itemId: number
  done: boolean
}

export type Profile = {
  key: string // 'onboarding-v1'
  reminders: boolean
  reminderHour: number
  exportedAt?: string
}

class PlaybookDB extends Dexie {
  journal!: Table<JournalEntry, number>
  mastery!: Table<MasteryRecord, [string, string]>
  bookmarks!: Table<Bookmark, [string, string]>
  checklists!: Table<ChecklistState, [string, string, number]>
  profiles!: Table<Profile, string>

  constructor() {
    super('montessori-playbook')
    this.version(1).stores({
      journal: '++id, childId, createdAt, activityId',
      mastery: '[childId+targetId], childId, level',
      bookmarks: '[childId+targetId], childId',
      checklists: '[childId+checklistId+itemId], childId',
      profiles: 'key',
    })
  }
}

export const db = new PlaybookDB()

export async function exportAllData(): Promise<string> {
  const [journal, mastery, bookmarks, checklists] = await Promise.all([
    db.journal.toArray(),
    db.mastery.toArray(),
    db.bookmarks.toArray(),
    db.checklists.toArray(),
  ])
  // foto blob -> base64
  const journalSer = await Promise.all(
    journal.map(async (j) => ({
      ...j,
      photoBlob: j.photoBlob ? await blobToBase64(j.photoBlob) : undefined,
    })),
  )
  return JSON.stringify({ v: 1, exportedAt: new Date().toISOString(), journal: journalSer, mastery, bookmarks, checklists }, null, 2)
}

export async function importAllData(json: string): Promise<void> {
  const data = JSON.parse(json)
  if (data.v !== 1) throw new Error('Format file tidak dikenal')
  await db.transaction('rw', db.journal, db.mastery, db.bookmarks, db.checklists, async () => {
    for (const j of data.journal ?? []) {
      const { photoBlob, ...rest } = j
      await db.journal.add({ ...rest, photoBlob: photoBlob ? await base64ToBlob(photoBlob) : undefined })
    }
    if (data.mastery) await db.mastery.bulkPut(data.mastery)
    if (data.bookmarks) await db.bookmarks.bulkPut(data.bookmarks)
    if (data.checklists) await db.checklists.bulkPut(data.checklists)
  })
}

function blobToBase64(blob: Blob): Promise<string> {
  return new Promise((res) => {
    const r = new FileReader()
    r.onload = () => res(String(r.result))
    r.readAsDataURL(blob)
  })
}

function base64ToBlob(dataUrl: string): Promise<Blob> {
  return fetch(dataUrl).then((r) => r.blob())
}
import { create } from 'zustand'
import { persist } from 'zustand/middleware'
import type { AgeBandId } from '../../content/schema'

export type Child = {
  id: string
  nickname: string
  birthDate: string // ISO date
}

export function ageBandFromBirth(birthDate: string, now = new Date()): AgeBandId {
  const b = new Date(birthDate)
  const months = (now.getFullYear() - b.getFullYear()) * 12 + (now.getMonth() - b.getMonth())
  if (months < 3) return '0-3m'
  if (months < 6) return '3-6m'
  if (months < 9) return '6-9m'
  if (months < 12) return '9-12m'
  if (months < 18) return '12-18m'
  if (months < 24) return '18-24m'
  if (months < 36) return '2-3y'
  if (months < 48) return '3-4y'
  return '4-5y'
}

type ChildStore = {
  children: Child[]
  activeId: string | null
  onboarded: boolean
  addChild: (nickname: string, birthDate: string) => void
  setActive: (id: string) => void
  removeChild: (id: string) => void
}

export const useChildStore = create<ChildStore>()(
  persist(
    (set) => ({
      children: [],
      activeId: null,
      onboarded: false,
      addChild: (nickname, birthDate) => {
        const id = crypto.randomUUID()
        set((s) => ({
          children: [...s.children, { id, nickname, birthDate }],
          activeId: s.activeId ?? id,
          onboarded: true,
        }))
      },
      setActive: (id) => set({ activeId: id }),
      removeChild: (id) =>
        set((s) => {
          const children = s.children.filter((c) => c.id !== id)
          return { children, activeId: children[0]?.id ?? null, onboarded: children.length > 0 }
        }),
    }),
    { name: 'mp-children' },
  ),
)

export function getActiveChild(): Child | null {
  const st = useChildStore.getState()
  return st.children.find((c) => c.id === st.activeId) ?? null
}

export function activeAgeBand(): AgeBandId | null {
  const c = getActiveChild()
  return c ? ageBandFromBirth(c.birthDate) : null
}
