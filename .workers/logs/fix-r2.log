import { useEffect, useState } from 'react'
import { pickToday } from '../../content/store'
import { activeAgeBand, useChildStore, ageBandFromBirth } from '../stores/children'
import { ageBandById, areaById } from '../../content/meta'
import type { Activity } from '../../content/schema'
import { AreaIcon, Mascot, StarDeco, CloudDeco } from '../components/icons'
import { db } from '../db'
import { useNavigate } from 'react-router-dom'

export const AREA_GRADIENTS: Record<string, string> = {
  'practical-life': 'from-apple-400 to-apple-600',
  sensorial: 'from-grape-400 to-grape-600',
  language: 'from-sky-400 to-sky-600',
  math: 'from-leaf-400 to-leaf-600',
  culture: 'from-tosca-400 to-tosca-600',
  movement: 'from-mango-400 to-mango-600',
  'grace-courtesy': 'from-candy-400 to-candy-600',
  'self-care': 'from-sunny-400 to-sunny-600',
  'art-music': 'from-grape-400 to-candy-500',
  outdoor: 'from-leaf-400 to-tosca-500',
}

export function TodayPage() {
  const navigate = useNavigate()
  const [acts, setActs] = useState<Activity[]>([])
  const [loading, setLoading] = useState(true)
  const band = activeAgeBand()
  const { children, activeId, setActive } = useChildStore()
  const child = children.find((c) => c.id === activeId)

  const [stats, setStats] = useState({ aktivitas: 0, area: 0, momen: 0, kebiasaan: 0 })
  useEffect(() => {
    if (!activeId) return
    Promise.all([
      db.mastery.where('childId').equals(activeId).toArray(),
      db.journal.where('childId').equals(activeId).count(),
    ]).then(([mastery, journalCount]) => {
      const touched = mastery.filter((m) => m.level !== 'belum')
      setStats({
        aktivitas: touched.filter((m) => m.kind === 'activity').length,
        area: touched.length % 12,
        momen: journalCount,
        kebiasaan: touched.filter((m) => m.kind === 'milestone').length,
      })
    })
  }, [activeId, acts])

  useEffect(() => {
    if (!band) return
    pickToday(band).then((a) => { setActs(a); setLoading(false) })
  }, [band])

  if (!child) return <OnboardPrompt />

  return (
    <div className="px-5 space-y-5">
      {/* Halo header */}
      <section>
        <div className="flex items-center justify-between">
          <div>
            <h2 className="font-[family-name:var(--font-display)] text-2xl font-bold text-sky-900 dark:text-sky-100">
              Halo, {child.nickname} <span aria-hidden>👋</span>
            </h2>
            <p className="text-sm opacity-65 mt-0.5">Siap main dan belajar hari ini?</p>
          </div>
          <button aria-label="Pengingat" className="w-11 h-11 rounded-full bg-white dark:bg-navy-800 shadow-sm grid place-items-center text-lg active:scale-95 transition">
            🔔
          </button>
        </div>

        {/* Child switcher */}
        <div className="mt-3 flex gap-2 overflow-x-auto hide-scrollbar -mx-1 px-1" role="group" aria-label="Pilih anak">
          {children.map((c) => {
            const cBand = ageBandById(ageBandFromBirth(c.birthDate))
            return (
              <button
                key={c.id}
                onClick={() => setActive(c.id)}
                aria-pressed={activeId === c.id}
                className={`shrink-0 flex items-center gap-2 rounded-full pl-1.5 pr-4 min-h-[48px] border-2 transition active:scale-[0.97] ${
                  activeId === c.id
                    ? 'bg-sky-600 border-sky-600 text-white shadow-md'
                    : 'bg-white dark:bg-navy-800 border-sky-100 dark:border-navy-700'
                }`}
              >
                <span className="w-9 h-9 rounded-full bg-gradient-to-br from-sky-200 to-sky-400 dark:from-navy-600 dark:to-navy-500 grid place-items-center text-lg" aria-hidden>
                  {cBand?.mascot ?? '🙂'}
                </span>
                <span className="text-left leading-tight">
                  <span className="block text-sm font-semibold">{c.nickname}</span>
                  <span className={`block text-[11px] ${activeId === c.id ? 'text-white/80' : 'opacity-55'}`}>{cBand?.label ?? '—'}</span>
                </span>
              </button>
            )
          })}
        </div>
      </section>

      {/* Search bar */}
      <a
        href="#/cari"
        className="flex items-center gap-3 rounded-full bg-white dark:bg-navy-800 shadow-sm px-5 min-h-[48px] text-sm text-sky-900/50 dark:text-sky-100/50 active:scale-[0.98] transition"
      >
        <span aria-hidden>🔍</span>
        Cari aktivitas, misal "menuang", "sensorik"…
      </a>

      {/* Rekomendasi Hari Ini */}
      <section>
        <div className="flex items-center justify-between mb-2.5">
          <h3 className="font-[family-name:var(--font-display)] font-bold text-lg">Rekomendasi Hari Ini</h3>
          <a href="#/playbook" className="text-sm font-medium text-sky-600 dark:text-sky-400">Lihat Semua ›</a>
        </div>
        {loading ? (
          <SkeletonCards n={3} />
        ) : acts.length === 0 ? (
          <EmptyState
            title="Konten sedang disiapkan"
            text="Aktivitas untuk usia ini belum tersedia. Cek playbook usia lain dulu ya."
          />
        ) : (
          <div className="flex gap-3 overflow-x-auto hide-scrollbar -mx-5 px-5 pb-1 snap-x snap-mandatory">
            {acts.map((a) => {
              const area = areaById(a.areas[0])
              const grad = AREA_GRADIENTS[a.areas[0]] ?? 'from-sky-400 to-sky-600'
              return (
                <article
                  key={a.id}
                  onClick={() => navigate(`/aktivitas/${a.id}`)}
                  className="snap-start shrink-0 w-44 rounded-3xl bg-white dark:bg-navy-800 shadow-sm overflow-hidden active:scale-[0.97] transition cursor-pointer"
                >
                  <div className={`relative h-28 bg-gradient-to-br ${grad} grid place-items-center`}>
                    <AreaIcon area={a.areas[0]} className="w-14 h-14 text-white/95 drop-shadow" />
                    <span className="absolute top-2 left-2 text-[10px] font-semibold bg-white/90 text-sky-800 rounded-full px-2 py-0.5">
                      {area?.label}
                    </span>
                    <button aria-label="Simpan ke bookmark" className="absolute top-2 right-2 w-7 h-7 rounded-full bg-white/90 grid place-items-center text-xs">
                      ♡
                    </button>
                  </div>
                  <div className="p-3">
                    <h4 className="font-semibold text-sm leading-snug line-clamp-2 min-h-[2.5rem]">{a.title}</h4>
                    <p className="text-[11px] opacity-60 mt-1.5">
                      ⏱ {a.durationMinutes} mnt · {a.ageBands[0]}
                    </p>
                  </div>
                </article>
              )
            })}
          </div>
        )}
      </section>

      {/* Progres Minggu Ini */}
      <section>
        <div className="flex items-center justify-between mb-2.5">
          <h3 className="font-[family-name:var(--font-display)] font-bold text-lg">Progres Minggu Ini</h3>
          <a href="#/progres" className="text-sm font-medium text-sky-600 dark:text-sky-400">Lihat Detail ›</a>
        </div>
        <div className="grid grid-cols-4 gap-2">
          {[
            { n: stats.aktivitas, l: 'aktivitas', c: 'text-leaf-600' },
            { n: stats.area, l: 'area berbeda', c: 'text-sunny-700' },
            { n: stats.momen, l: 'momen berharga', c: 'text-apple-600' },
            { n: stats.kebiasaan, l: 'kebiasaan baru', c: 'text-sky-600' },
          ].map((s) => (
            <div key={s.l} className="rounded-2xl bg-white dark:bg-navy-800 shadow-sm p-2.5 text-center">
              <p className={`font-[family-name:var(--font-display)] font-bold text-xl ${s.c}`}>{s.n}</p>
              <p className="text-[10px] opacity-60 leading-tight mt-0.5">{s.l}</p>
            </div>
          ))}
        </div>
      </section>

      {/* Reminder banner */}
      <section className="rounded-3xl bg-sunny-100 dark:bg-navy-800 p-4 flex items-start gap-3">
        <span className="text-2xl" aria-hidden>🌞</span>
        <div className="flex-1">
          <p className="text-sm font-semibold">Jangan lupa istirahat, ya!</p>
          <p className="text-xs opacity-70 mt-0.5">Anak juga belajar dari momen santai bersama Mama & Papa.</p>
        </div>
        <button aria-label="Tutup pengingat" className="opacity-40 text-sm px-1">✕</button>
      </section>
    </div>
  )
}

function childBand(birth: string) {
  return ageBandById(ageBandFromBirth(birth))
}
void childBand

export function OnboardPrompt() {
  return (
    <div className="px-5 relative">
      <CloudDeco className="absolute -top-2 -right-2 w-24 text-white/70 dark:text-navy-700" />
      <StarDeco className="absolute top-8 left-4 w-5 text-sunny-400" />
      <div className="rounded-blob bg-white dark:bg-navy-800 p-6 text-center shadow-sm relative overflow-hidden">
        <Mascot className="w-36 mx-auto" />
        <h2 className="font-[family-name:var(--font-display)] text-2xl font-bold mt-2">Selamat datang!</h2>
        <p className="text-sm opacity-70 mt-2 max-w-[280px] mx-auto">
          Ceritakan tentang si kecil, agar kami bisa menyiapkan rekomendasi yang tepat.
        </p>
        <a
          href="#/lainnya"
          className="inline-block mt-4 rounded-full bg-sky-600 px-8 py-3 text-white font-semibold min-h-[48px] leading-[24px] active:scale-95 transition shadow-md shadow-sky-600/20"
        >
          Buat profil anak →
        </a>
      </div>
    </div>
  )
}

export function EmptyState({ title, text, mood = 'happy' }: { title: string; text: string; mood?: 'happy' | 'sleepy' | 'oops' }) {
  return (
    <div className="py-10 text-center px-6">
      <Mascot className="w-28 mx-auto" mood={mood} />
      <h3 className="font-[family-name:var(--font-display)] font-bold text-lg mt-2">{title}</h3>
      <p className="text-sm opacity-65 mt-1 max-w-xs mx-auto">{text}</p>
    </div>
  )
}

export function SkeletonCards({ n }: { n: number }) {
  return (
    <div className="flex gap-3 overflow-hidden -mx-5 px-5" aria-hidden>
      {Array.from({ length: n }).map((_, i) => (
        <div key={i} className="shrink-0 w-44 rounded-3xl bg-white dark:bg-navy-800 overflow-hidden animate-pulse">
          <div className="h-28 bg-sky-100 dark:bg-navy-700" />
          <div className="p-3 space-y-2">
            <div className="h-3.5 w-4/5 rounded bg-sky-100 dark:bg-navy-700" />
            <div className="h-2.5 w-2/5 rounded bg-sky-50 dark:bg-navy-700/60" />
          </div>
        </div>
      ))}
    </div>
  )
}

--- Playbook ---
import { useEffect, useState } from 'react'
import { loadAllActivities } from '../../content/store'
import { AGE_BANDS, AREAS, areaById } from '../../content/meta'
import type { Activity, AgeBandId } from '../../content/schema'
import { EmptyState, SkeletonCards, AREA_GRADIENTS } from './TodayPage'
import { AreaIcon } from '../components/icons'
import { useNavigate } from 'react-router-dom'

type Filters = { band: AgeBandId | 'semua'; area: string | 'semua'; durasi: 'semua' | 'pendek' | 'sedang'; fromHome: boolean }

const CHIP_ACTIVE: Record<string, string> = {
  '0-3m': 'bg-sky-500', '3-6m': 'bg-tosca-500', '6-9m': 'bg-leaf-500',
  '9-12m': 'bg-sunny-500', '12-18m': 'bg-mango-500', '18-24m': 'bg-candy-500',
  '2-3y': 'bg-apple-500', '3-4y': 'bg-grape-500', '4-5y': 'bg-sky-600',
}

export function PlaybookPage() {
  const navigate = useNavigate()
  const [acts, setActs] = useState<Activity[] | null>(null)
  const [f, setF] = useState<Filters>({ band: 'semua', area: 'semua', durasi: 'semua', fromHome: false })

  useEffect(() => {
    loadAllActivities().then(setActs)
  }, [])

  const filtered = (acts ?? []).filter((a) => {
    if (f.band !== 'semua' && !a.ageBands.includes(f.band)) return false
    if (f.area !== 'semua' && !a.areas.includes(f.area as never)) return false
    if (f.durasi === 'pendek' && a.durationMinutes > 15) return false
    if (f.durasi === 'sedang' && (a.durationMinutes < 15 || a.durationMinutes > 40)) return false
    if (f.fromHome && !a.materials.every((m) => m.fromHome)) return false
    return true
  })

  return (
    <div className="px-5 space-y-3">
      {/* Chips usia */}
      <div className="hide-scrollbar -mx-5 px-5 flex gap-2 overflow-x-auto pb-1" role="group" aria-label="Filter usia">
        <Chip active={f.band === 'semua'} onClick={() => setF({ ...f, band: 'semua' })}>Semua</Chip>
        {AGE_BANDS.map((b) => (
          <button
            key={b.id}
            aria-pressed={f.band === b.id}
            onClick={() => setF({ ...f, band: f.band === b.id ? 'semua' : b.id })}
            className={`shrink-0 w-[68px] rounded-2xl border-2 py-2 text-center transition active:scale-95 ${
              f.band === b.id
                ? `${CHIP_ACTIVE[b.id]} border-transparent text-white shadow-md`
                : 'bg-white dark:bg-navy-800 border-sky-100 dark:border-navy-700 text-sky-900 dark:text-sky-100'
            }`}
          >
            <span className="block text-base leading-none" aria-hidden>{b.mascot}</span>
            <span className="block text-[10px] font-semibold mt-1">{b.id}</span>
          </button>
        ))}
      </div>

      {/* Grid area warna */}
      <section aria-label="Area Montessori">
        <h3 className="font-[family-name:var(--font-display)] font-bold text-lg mb-2">Area Montessori</h3>
        <div className="grid grid-cols-3 gap-2.5">
          {AREAS.map((a) => {
            const active = f.area === a.id
            const grad = AREA_GRADIENTS[a.id] ?? 'from-sky-400 to-sky-600'
            return (
              <button
                key={a.id}
                onClick={() => setF({ ...f, area: active ? 'semua' : a.id })}
                aria-pressed={active}
                className={`rounded-3xl p-3.5 text-left aspect-[5/4] bg-gradient-to-br ${grad} text-white shadow-sm transition active:scale-[0.96] relative overflow-hidden ${
                  active ? 'ring-4 ring-sky-300 scale-[1.02]' : ''
                }`}
              >
                <AreaIcon area={a.id} className="w-9 h-9 drop-shadow" />
                <span className="absolute bottom-2.5 left-3 right-2 text-[11px] font-bold leading-tight drop-shadow-sm">
                  {a.label}
                </span>
              </button>
            )
          })}
        </div>
      </section>

      {/* Filter durasi & bahan */}
      <div className="hide-scrollbar -mx-5 px-5 flex gap-2 overflow-x-auto pb-1" role="group" aria-label="Filter lainnya">
        <Chip active={f.durasi === 'pendek'} onClick={() => setF({ ...f, durasi: f.durasi === 'pendek' ? 'semua' : 'pendek' })}>≤ 15 menit</Chip>
        <Chip active={f.durasi === 'sedang'} onClick={() => setF({ ...f, durasi: f.durasi === 'sedang' ? 'semua' : 'sedang' })}>15–40 menit</Chip>
        <Chip active={f.fromHome} onClick={() => setF({ ...f, fromHome: !f.fromHome })}>🏠 Bahan di Rumah</Chip>
      </div>

      {/* Hasil */}
      <section>
        <h3 className="font-[family-name:var(--font-display)] font-bold text-lg mb-2">
          Semua Aktivitas <span className="opacity-50 text-base">({filtered.length})</span>
        </h3>
        {!acts ? (
          <SkeletonCards n={4} />
        ) : filtered.length === 0 ? (
          <EmptyState title="Belum ada yang cocok" text="Coba longgarkan filternya — konten masih terus bertambah." />
        ) : (
          <ul className="space-y-3">
            {filtered.map((a) => {
              const area = areaById(a.areas[0])
              const grad = AREA_GRADIENTS[a.areas[0]] ?? 'from-sky-400 to-sky-600'
              return (
                <li key={a.id}>
                  <article onClick={() => navigate(`/aktivitas/${a.id}`)} className="rounded-3xl bg-white dark:bg-navy-800 shadow-sm overflow-hidden active:scale-[0.98] transition cursor-pointer">
                    <div className={`relative h-24 bg-gradient-to-br ${grad} grid place-items-center`}>
                      <AreaIcon area={a.areas[0]} className="w-11 h-11 text-white/95 drop-shadow" />
                      <span className="absolute top-2 left-2 text-[10px] font-semibold bg-white/90 text-sky-800 rounded-full px-2 py-0.5">
                        {area?.label}
                      </span>
                      <button aria-label="Bookmark" className="absolute top-2 right-2 w-7 h-7 rounded-full bg-white/90 grid place-items-center text-xs">♡</button>
                    </div>
                    <div className="p-4">
                      <h4 className="font-semibold">{a.title}</h4>
                      <p className="text-sm opacity-70 mt-1 line-clamp-2">{a.summary}</p>
                      <div className="flex gap-1.5 mt-2.5 flex-wrap">
                        <Badge>⏱ {a.durationMinutes} mnt</Badge>
                        <Badge>{a.ageBands.join(' · ')}</Badge>
                      </div>
                    </div>
                  </article>
                </li>
              )
            })}
          </ul>
        )}
      </section>
    </div>
  )
}

function Chip({ active, onClick, children }: { active: boolean; onClick: () => void; children: React.ReactNode }) {
  return (
    <button
      onClick={onClick}
      aria-pressed={active}
      className={`shrink-0 rounded-full px-4 min-h-[36px] text-sm font-medium border transition active:scale-95 ${
        active
          ? 'bg-sky-600 text-white border-sky-600'
          : 'bg-white dark:bg-navy-800 border-sky-200 dark:border-navy-700 text-sky-800 dark:text-sky-200'
      }`}
    >
      {children}
    </button>
  )
}

function Badge({ children }: { children: React.ReactNode }) {
  return <span className="text-[11px] rounded-full bg-sky-50 dark:bg-navy-700 px-2 py-0.5 text-sky-800 dark:text-sky-200">{children}</span>
}

--- App/icons ---
import { useEffect, useState, createContext, useContext } from 'react'
import { Routes, Route, NavLink, useLocation } from 'react-router-dom'
import { AnimatePresence, motion } from 'framer-motion'
import { TodayPage } from './pages/TodayPage'
import { PlaybookPage } from './pages/PlaybookPage'
import { JournalPage } from './pages/JournalPage'
import { ProgressPage } from './pages/ProgressPage'
import { MorePage } from './pages/MorePage'
import { ActivityDetailPage } from './pages/ActivityDetailPage'
import { SearchGlossaryPage } from './pages/SearchGlossaryPage'
import { EnvironmentPage } from './pages/EnvironmentPage'
import { LearnPage } from './pages/LearnPage'
import { UpdateToast } from './components/UpdateToast'
import { swUpdate } from './pwa'
import { useChildStore } from './stores/children'

type TabScroll = Record<string, number>
const ScrollCtx = createContext<{ save: (tab: string, y: number) => void; get: (tab: string) => number }>({
  save: () => {},
  get: () => 0,
})
export const useTabScroll = () => useContext(ScrollCtx)

const TABS = [
  { to: '/', label: 'Hari Ini', icon: '☀️' },
  { to: '/playbook', label: 'Playbook', icon: '📖' },
  { to: '/jurnal', label: 'Jurnal', icon: '📝' },
  { to: '/progres', label: 'Progres', icon: '🌱' },
  { to: '/lainnya', label: 'Lainnya', icon: '⋯' },
]

export default function App() {
  const location = useLocation()
  const [scrollMem, setScrollMem] = useState<TabScroll>({})
  const [isDark, setIsDark] = useState(
    () => localStorage.getItem('mp-theme') === 'dark' ||
      (localStorage.getItem('mp-theme') === null && window.matchMedia('(prefers-color-scheme: dark)').matches),
  )
  const activeChild = useChildStore((s) => s.children[0])

  useEffect(() => {
    document.documentElement.classList.toggle('dark', isDark)
    localStorage.setItem('mp-theme', isDark ? 'dark' : 'light')
  }, [isDark])

  // Simpan scroll per tab & restore saat kembali
  useEffect(() => {
    const tab = TABS.find((t) => t.to === location.pathname)?.to ?? location.pathname
    const saved = scrollMem[tab]
    if (saved !== undefined) requestAnimationFrame(() => window.scrollTo(0, saved))
    const onScroll = () => {
      setScrollMem((m) => (m[tab] === window.scrollY ? m : { ...m, [tab]: window.scrollY }))
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    return () => window.removeEventListener('scroll', onScroll)
  }, [location.pathname])

  return (
    <ScrollCtx.Provider value={{ save: () => {}, get: (t) => scrollMem[t] ?? 0 }}>
      <div className="min-h-dvh bg-sky-50 dark:bg-navy-900 text-sky-900 dark:text-sky-100 transition-colors">
        {/* Header collapsing large title */}
        <Header title={titleFor(location.pathname)} />

        <main className="px-safe pb-28 pt-2">
          <AnimatePresence mode="wait" initial={false}>
            <motion.div
              key={location.pathname}
              initial={{ opacity: 0, x: 24 }}
              animate={{ opacity: 1, x: 0 }}
              exit={{ opacity: 0, x: -24 }}
              transition={{ duration: 0.22, ease: [0.32, 0.72, 0, 1] }}
            >
              <Routes location={location}>
                <Route path="/" element={<TodayPage />} />
                <Route path="/playbook" element={<PlaybookPage />} />
                <Route path="/aktivitas/:id" element={<ActivityDetailPage />} />
                <Route path="/cari" element={<SearchGlossaryPage />} />
                <Route path="/jurnal" element={<JournalPage />} />
                <Route path="/progres" element={<ProgressPage />} />
                <Route path="/lainnya" element={<MorePage isDark={isDark} onToggleDark={() => setIsDark((d) => !d)} />} />
                <Route path="/lingkungan" element={<EnvironmentPage />} />
                <Route path="/belajar" element={<LearnPage />} />
              </Routes>
            </motion.div>
          </AnimatePresence>
        </main>

        <TabBar tabs={TABS} />
        <UpdateToast swUpdate={swUpdate} />
        {/* a11y: nama anak di judul dinamis */}
        <span className="sr-only" aria-live="polite">{activeChild ? `Profil aktif: ${activeChild.nickname}` : ''}</span>
      </div>
    </ScrollCtx.Provider>
  )
}

function titleFor(path: string): string {
  if (path === '/') return 'Hari Ini'
  if (path.startsWith('/cari')) return 'Cari'
  if (path.startsWith('/playbook')) return 'Playbook'
  if (path.startsWith('/jurnal')) return 'Jurnal'
  if (path.startsWith('/progres')) return 'Progres'
  if (path.startsWith('/lingkungan')) return 'Persiapan rumah'
  if (path.startsWith('/belajar')) return 'Panduan & Pemantauan'
  return 'Lainnya'
}

function Header({ title }: { title: string }) {
  const [compact, setCompact] = useState(false)
  useEffect(() => {
    const onScroll = () => setCompact(window.scrollY > 36)
    window.addEventListener('scroll', onScroll, { passive: true })
    return () => window.removeEventListener('scroll', onScroll)
  }, [])
  return (
    <header className="sticky top-0 z-40 bg-sky-50/85 dark:bg-navy-900/85 backdrop-blur-md pt-safe">
      <div className="px-5 pb-2 transition-all" style={{ height: compact ? 48 : 84 }}>
        <h1
          className={`font-[family-name:var(--font-display)] font-bold text-sky-700 dark:text-sky-300 transition-all ${compact ? 'text-xl leading-[48px]' : 'text-3xl leading-[84px]'}`}
        >
          {title}
        </h1>
      </div>
    </header>
  )
}

function TabBar({ tabs }: { tabs: typeof TABS }) {
  return (
    <nav
      aria-label="Navigasi utama"
      className="fixed bottom-0 inset-x-0 z-50 bg-white/90 dark:bg-navy-800/90 backdrop-blur-md border-t border-sky-100 dark:border-navy-700 pb-safe"
    >
      <div className="grid grid-cols-5 px-safe">
        {tabs.map((t) => (
          <NavLink
            key={t.to}
            to={t.to}
            end={t.to === '/'}
            className={({ isActive }) =>
              `flex flex-col items-center gap-0.5 py-2 min-h-[48px] justify-center text-[11px] font-medium transition-colors ${
                isActive ? 'text-sky-600 dark:text-sky-400' : 'text-sky-900/45 dark:text-sky-100/45'
              }`
            }
          >
            {({ isActive }) => (
              <>
                <span aria-hidden className="text-xl leading-none">{t.icon}</span>
                <span>{t.label}</span>
                {isActive && (
                  <motion.span layoutId="tabdot" className="absolute top-0 h-0.5 w-8 rounded-full bg-sky-500" />
                )}
              </>
            )}
          </NavLink>
        ))}
      </div>
    </nav>
  )
}
// Ikon area flat-cute (putih, dipakai di tile warna) + dekorasi langit
type P = { className?: string }

export function AreaIcon({ area, className }: { area: string; className?: string }) {
  const cls = className ?? 'w-8 h-8'
  switch (area) {
    case 'practical-life':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <path d="M14 20c0-2 2-4 4-4h12c2 0 4 2 4 4v2c0 2-2 4-4 4H18c-2 0-4-2-4-4v-2z" fill="#fff" opacity=".95"/>
          <path d="M17 26h14v3c0 6-3 10-7 10s-7-4-7-10v-3z" fill="#fff" opacity=".8"/>
          <path d="M31 12c3 1 6 4 6 8" stroke="#fff" strokeWidth="2.6" strokeLinecap="round"/>
          <circle cx="31" cy="11" r="2.4" fill="#fff"/>
        </svg>
      )
    case 'sensorial':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <rect x="8" y="26" width="32" height="7" rx="3.5" fill="#fff" opacity=".85"/>
          <rect x="13" y="17" width="22" height="7" rx="3.5" fill="#fff" opacity=".92"/>
          <rect x="18" y="8" width="12" height="7" rx="3.5" fill="#fff"/>
        </svg>
      )
    case 'language':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <path d="M8 12c0-2 2-4 4-4h20c2 0 4 2 4 4v14c0 2-2 4-4 4H20l-8 8v-8h-.5C9 30 8 28 8 26V12z" fill="#fff" opacity=".95"/>
          <circle cx="18" cy="19" r="2.2" fill="currentColor" opacity=".55"/>
          <circle cx="25" cy="19" r="2.2" fill="currentColor" opacity=".55"/>
          <circle cx="32" cy="19" r="2.2" fill="currentColor" opacity=".55"/>
        </svg>
      )
    case 'math':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <rect x="7" y="18" width="14" height="22" rx="3" fill="#fff" opacity=".9"/>
          <rect x="17" y="10" width="14" height="30" rx="3" fill="#fff" opacity=".95"/>
          <rect x="27" y="14" width="14" height="26" rx="3" fill="#fff" opacity=".85"/>
          <circle cx="24" cy="6" r="3" fill="#fff"/>
        </svg>
      )
    case 'culture':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <circle cx="24" cy="24" r="17" fill="#fff" opacity=".95"/>
          <path d="M14 18c4-2 7 1 6 5s3 6 7 4 8 1 6 5c-2 5-9 8-14 6-6-2-10-9-8-15 .7-2 1.6-4 3-5z" fill="currentColor" opacity=".45"/>
          <path d="M30 12c3 2 5 5 5 8 0 2-3 2-5 1s-4-3-3-6c.6-1.7 2-2.7 3-3z" fill="currentColor" opacity=".3"/>
        </svg>
      )
    case 'movement':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <circle cx="20" cy="9" r="5" fill="#fff"/>
          <path d="M20 15c-4 1-7 4-8 8l-2 7c-.5 2 1 3.5 3 3.5 1.5 0 2.7-1 3.2-2.5l1.3-4" stroke="#fff" strokeWidth="3.4" strokeLinecap="round"/>
          <path d="M20 20c4 0 7 2 9 5l4 6M17 33l-4 8M28 31l5 9" stroke="#fff" strokeWidth="3.4" strokeLinecap="round"/>
        </svg>
      )
    case 'grace-courtesy':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <circle cx="15" cy="12" r="5" fill="#fff"/>
          <path d="M15 18c-4 2-7 6-7 11v6h13v-6M25 20l8-8M25 12l8 8" stroke="#fff" strokeWidth="3.2" strokeLinecap="round"/>
          <path d="M36 26c2 3 2 7-1 10-2 2-5 3-8 2" stroke="#fff" strokeWidth="3.2" strokeLinecap="round"/>
        </svg>
      )
    case 'self-care':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <rect x="10" y="20" width="20" height="18" rx="4" fill="#fff" opacity=".95"/>
          <path d="M14 20v-4c0-3 3-6 7-6 2 0 4 1 5 2.5M34 14c3 0 5 2 5 5s-2 5-5 5h-4" stroke="#fff" strokeWidth="3.2" strokeLinecap="round"/>
          <path d="M16 28h8" stroke="currentColor" strokeWidth="2.6" strokeLinecap="round" opacity=".5"/>
        </svg>
      )
    case 'art-music':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <path d="M18 36V14l16-4v20" stroke="#fff" strokeWidth="3.2" strokeLinecap="round"/>
          <ellipse cx="14" cy="36" rx="5" ry="4" fill="#fff"/>
          <ellipse cx="30" cy="30" rx="5" ry="4" fill="#fff"/>
          <path d="M14 12c2 4 2 8-1 12" stroke="#fff" strokeWidth="2.4" strokeLinecap="round" opacity=".7"/>
        </svg>
      )
    case 'outdoor':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
