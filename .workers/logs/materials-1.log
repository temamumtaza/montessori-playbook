[0m$ [0mpython3 - <<'EOF'
import json, re
d = json.load(open('content/parts/materials-1.json'))
bands = {"0-3m","3-6m","6-9m","9-12m","12-18m","18-24m","2-3y","3-4y","4-5y"}
problems = []
for m in d:
    if not re.fullmatch(r'[a-z0-9]+(-[a-z0-9]+)*', m['id']): problems.append(('id', m['id']))
    if len(m.get('purpose','')) < 30: problems.append(('purpose', m['id']))
    if not set(m['ageBands']) <= bands: problems.append(('ageBands', m['id']))
    if m['budget'] not in ('rendah','sedang','tinggi'): problems.append(('budget', m['id']))
    if not m.get('safetyNotes'): problems.append(('safetyNotes-missing', m['id']))
    if not m.get('references') or not all(r.get('url','').startswith('http') for r in m['references']): problems.append(('references', m['id']))
    if not isinstance(m.get('diy'), bool): problems.append(('diy', m['id']))
ids = [m['id'] for m in d]
if len(ids) != len(set(ids)): problems.append(('dup-ids',))
zero3 = [m['id'] for m in d if set(m['ageBands']) & {"0-3m","3-6m","6-9m","9-12m"}]
print('problems:', problems)
print('total:', len(d), '| covering 0-3y:', len(zero3))
# check no raw newline inside strings (json.load would fail anyway) and ASCII safety
print('keys sample:', sorted(d[0].keys()))
