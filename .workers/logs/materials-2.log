    assert x['ageBands'] and all(a in ages for a in x['ageBands']),x['id']
    assert x['budget'] in {'rendah','sedang','tinggi'}
    assert isinstance(x['diy'],bool)
    assert isinstance(x['safetyNotes'],list)
    assert len(x['references'])>=1
    for r in x['references']:
        assert len(r['title'])>=3 and r['url'].startswith('https://'),x['id']
print('schema-like OK',len(d))
