import json
p='content/parts/mile-2-3y.json'
d=json.load(open(p))
for e in d:
    assert 24<=e['typicalFromMonths']<=e['typicalToMonths']<=36,(e['id'],e['typicalFromMonths'],e['typicalToMonths'])
    assert e['domain'] in ['motorik-kasar','motorik-halus','bahasa','kognitif','sosial-emosional','self-help']
    assert len(e['description'])>=30
    assert e['safetyNotes']
for e in d:
    if 'nhs.uk' in e['references'][1]['url']:
        e['references'][1]['url']='https://www.nhs.uk/conditions/baby/'
json.dump(d,open(p,'w'),ensure_ascii=False,indent=2)
print('OK',len(d),sorted({e['domain'] for e in d}))
