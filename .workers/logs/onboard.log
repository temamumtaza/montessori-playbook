/* ===== Native feel global ===== */
html {
  background: var(--color-sky-50);
  -webkit-tap-highlight-color: transparent;
  -webkit-text-size-adjust: 100%;
  overscroll-behavior-y: none; /* cegah pull-bounce browser */
}

body {
  font-family: var(--font-body);
  touch-action: manipulation; /* matikan double-tap zoom */
  overscroll-behavior-y: none;
}

/* Elemen UI tidak bisa diseleksi; konten bacaan tetap bisa */
button, nav, header, [role='tablist'], .no-select {
  user-select: none;
  -webkit-user-select: none;
}

/* Safe area helpers (notch & home indicator) */
.pt-safe { padding-top: max(env(safe-area-inset-top), 0.5rem); }
.pb-safe { padding-bottom: max(env(safe-area-inset-bottom), 0.25rem); }
.px-safe { padding-left: env(safe-area-inset-left); padding-right: env(safe-area-inset-right); }

/* ===== Dark mode (class-based) ===== */
.dark html, html.dark {
  background: var(--color-navy-900);
}

/* Scrollbar disembunyikan di chip scroller horizontal */
.hide-scrollbar::-webkit-scrollbar { display: none; }
.hide-scrollbar { scrollbar-width: none; }

/* Transisi halaman: CSS murni (native-feel, nol JS animation lib) */
@keyframes pageIn {
  from { opacity: 0; transform: translateX(16px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.sheet-enter { animation: sheetUp 0.24s cubic-bezier(0.32, 0.72, 0, 1); }

@keyframes confettiFall {
  0% { opacity: 0; transform: translateY(-18px) rotate(0deg) scale(.6); }
  12% { opacity: 1; }
  100% { opacity: 0; transform: translateY(170px) rotate(250deg) scale(1); }
}
.confetti-fall { animation: confettiFall 1.8s ease-out forwards; }
.page-enter {
  animation: pageIn 0.22s cubic-bezier(0.32, 0.72, 0, 1);
}

.shadow-sky-sm { box-shadow: 0 4px 16px rgba(2,132,199,.08); }
.shadow-sky-md { box-shadow: 0 8px 24px rgba(2,132,199,.12); }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

