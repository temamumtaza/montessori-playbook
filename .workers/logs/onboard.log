const ageColors: Record<AgeBandId, [string, string]> = {
  '0-3m': ['#bae6fd', '#0284c7'], '3-6m': ['#99f6e4', '#0f766e'], '6-9m': ['#bbf7d0', '#16a34a'],
  '9-12m': ['#fef08a', '#ca8a04'], '12-18m': ['#fed7aa', '#ea580c'], '18-24m': ['#fbcfe8', '#db2777'],
  '2-3y': ['#d9f99d', '#65a30d'], '3-4y': ['#e9d5ff', '#9333ea'], '4-5y': ['#bae6fd', '#2563eb'],
}
export function AgeBandIcon({ band, className }: { band: AgeBandId; className?: string }) {
  const [soft, strong] = ageColors[band]
  const common = { className, viewBox: '0 0 48 48', 'aria-hidden': true }
  const face = <><circle cx="24" cy="25" r="13" fill={soft}/><circle cx="19" cy="24" r="1.5" fill={strong}/><circle cx="29" cy="24" r="1.5" fill={strong}/><path d="M21 29c2 2 4 2 6 0" fill="none" stroke={strong} strokeWidth="1.8" strokeLinecap="round"/></>
  switch (band) {
    case '0-3m': return <svg {...common}>{face}<path d="M13 16c2-6 7-8 11-8s9 2 11 8" fill={strong} opacity=".8"/><path d="M9 39c5-3 25-3 30 0" fill="none" stroke={strong} strokeWidth="3" strokeLinecap="round"/></svg>
    case '3-6m': return <svg {...common}><ellipse cx="24" cy="29" rx="15" ry="10" fill={soft}/><circle cx="14" cy="27" r="6" fill={strong}/>{face}</svg>
    case '6-9m': return <svg {...common}><circle cx="14" cy="17" r="6" fill={soft}/><path d="M12 23c5-4 17-3 22 3l-3 8H12z" fill={strong}/><circle cx="16" cy="37" r="3" fill={soft}/><circle cx="32" cy="37" r="3" fill={soft}/></svg>
    case '9-12m': return <svg {...common}><rect x="14" y="15" width="15" height="21" rx="7" fill={soft}/><circle cx="21" cy="11" r="6" fill={strong}/><path d="M8 9v30M8 19h7" fill="none" stroke={strong} strokeWidth="3" strokeLinecap="round"/></svg>
    case '12-18m': return <svg {...common}><circle cx="25" cy="10" r="5" fill={strong}/><path d="M25 16v15m0-10-8 7m8-7 8 5m-8 0-6 10m6-10 8 10" fill="none" stroke={strong} strokeWidth="3" strokeLinecap="round"/></svg>
    case '18-24m': return <svg {...common}><rect x="9" y="25" width="13" height="13" rx="2" fill={soft}/><rect x="23" y="18" width="14" height="20" rx="2" fill={strong}/><rect x="18" y="10" width="12" height="9" rx="2" fill={soft}/></svg>
    case '2-3y': return <svg {...common}><rect x="8" y="19" width="28" height="15" rx="4" fill={strong}/><path d="m15 19 4-7h7l4 7" fill={soft}/><circle cx="15" cy="36" r="4" fill={strong}/><circle cx="33" cy="36" r="4" fill={strong}/></svg>
    case '3-4y': return <svg {...common}><path d="M9 35 28 10" stroke={strong} strokeWidth="4" strokeLinecap="round"/><path d="M12 31c7-2 13 2 20 0" fill={soft} stroke={strong} strokeWidth="2"/><circle cx="33" cy="13" r="5" fill={soft}/></svg>
    default: return <svg {...common}><circle cx="31" cy="18" r="8" fill={soft}/><path d="M9 35c7-9 19-9 25 0" fill={strong}/><path d="M18 19 9 8" stroke={strong} strokeWidth="3" strokeLinecap="round"/><circle cx="31" cy="18" r="3" fill={strong}/></svg>
  }
}

export function IconRoom({ room, className }: { room: RoomId; className?: string }) {
  const common = { className, viewBox: '0 0 48 48', fill: 'none', stroke: 'currentColor', strokeWidth: 2.5, strokeLinecap: 'round' as const, strokeLinejoin: 'round' as const, 'aria-hidden': true }
  switch (room) {
    case 'kamar-anak': return <svg {...common}><path d="M7 31V18h34v13M7 24h34M12 31v7M36 31v7"/><rect x="11" y="14" width="14" height="10" rx="2" fill="currentColor" opacity=".18"/></svg>
    case 'kamar-mandi': return <svg {...common}><path d="M8 27h32M11 27v6a7 7 0 0 0 14 0v-6M18 13v8M18 13a5 5 0 0 1 9-2"/><path d="M34 8c0 3-3 4-3 7a3 3 0 0 0 6 0c0-3-3-4-3-7Z" fill="currentColor" opacity=".25"/></svg>
    case 'dapur': return <svg {...common}><path d="M8 25h32l-3 12H11zM12 25c0-9 24-9 24 0M18 20V12M30 20V12"/><path d="M18 12c-2-3 2-4 0-7M30 12c-2-3 2-4 0-7"/></svg>
    case 'ruang-keluarga': return <svg {...common}><path d="M8 25v-5a4 4 0 0 1 4-4h24a4 4 0 0 1 4 4v5M8 25h32v10H8zM13 35v4M35 35v4"/></svg>
    case 'area-makan': return <svg {...common}><path d="M9 8v13M13 8v13M9 14h4M11 21v18M29 8v31M29 8c7 5 7 11 0 13"/></svg>
    default: return <svg {...common}><path d="M24 39V20M24 25c-7 0-12-5-12-12 7 0 12 5 12 12ZM24 29c0-8 6-14 14-14 0 8-6 14-14 14Z"/><path d="M8 39h32"/></svg>
  }
}

// Ikon area flat-cute (putih, dipakai di tile warna) + dekorasi langit
type P = { className?: string; style?: React.CSSProperties }

export function TabIcon({ name, className }: { name: 'home' | 'book-open' | 'journal' | 'chart' | 'ellipsis'; className?: string }) {
  const common = { className, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', strokeWidth: 2, strokeLinecap: 'round' as const, strokeLinejoin: 'round' as const, 'aria-hidden': true }
  switch (name) {
    case 'home': return <svg {...common}><path d="m3 10 9-7 9 7" /><path d="M5 9v11h14V9M9 20v-6h6v6" /></svg>
    case 'book-open': return <svg {...common}><path d="M3 5.5A2.5 2.5 0 0 1 5.5 3H12v17H5.5A2.5 2.5 0 0 1 3 17.5z" /><path d="M21 5.5A2.5 2.5 0 0 0 18.5 3H12v17h6.5a2.5 2.5 0 0 0 2.5-2.5z" /></svg>
    case 'journal': return <svg {...common}><path d="M4 4h12a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3z" /><path d="M7 4v16M9 9h6M9 13h6" /><path d="m16 3 3 3" /></svg>
    case 'chart': return <svg {...common}><path d="M4 19V5M4 19h16" /><path d="m7 15 3-4 3 2 5-7" /><path d="M18 6h-3" /></svg>
    case 'ellipsis': return <svg {...common}><circle cx="5" cy="12" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="19" cy="12" r="1" /></svg>
  }
}

export function AreaIcon({ area, className }: { area: string; className?: string }) {
  const cls = className ?? 'w-8 h-8'
  switch (area) {
    case 'practical-life':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <path d="M14 20c0-2 2-4 4-4h12c2 0 4 2 4 4v2c0 2-2 4-4 4H18c-2 0-4-2-4-4v-2z" fill="#fff" opacity=".95"/>
          <path d="M17 26h14v3c0 6-3 10-7 10s-7-4-7-10v-3z" fill="#fff" opacity=".8"/>
          <path d="M31 12c3 1 6 4 6 8" stroke="#fff" strokeWidth="2.6" strokeLinecap="round"/>
          <circle cx="31" cy="11" r="2.4" fill="#fff"/>
        </svg>
      )
    case 'sensorial':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <rect x="8" y="26" width="32" height="7" rx="3.5" fill="#fff" opacity=".85"/>
          <rect x="13" y="17" width="22" height="7" rx="3.5" fill="#fff" opacity=".92"/>
          <rect x="18" y="8" width="12" height="7" rx="3.5" fill="#fff"/>
        </svg>
      )
    case 'language':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <path d="M8 12c0-2 2-4 4-4h20c2 0 4 2 4 4v14c0 2-2 4-4 4H20l-8 8v-8h-.5C9 30 8 28 8 26V12z" fill="#fff" opacity=".95"/>
          <circle cx="18" cy="19" r="2.2" fill="currentColor" opacity=".55"/>
          <circle cx="25" cy="19" r="2.2" fill="currentColor" opacity=".55"/>
          <circle cx="32" cy="19" r="2.2" fill="currentColor" opacity=".55"/>
        </svg>
      )
    case 'math':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <rect x="7" y="18" width="14" height="22" rx="3" fill="#fff" opacity=".9"/>
          <rect x="17" y="10" width="14" height="30" rx="3" fill="#fff" opacity=".95"/>
          <rect x="27" y="14" width="14" height="26" rx="3" fill="#fff" opacity=".85"/>
          <circle cx="24" cy="6" r="3" fill="#fff"/>
        </svg>
      )
    case 'culture':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <circle cx="24" cy="24" r="17" fill="#fff" opacity=".95"/>
          <path d="M14 18c4-2 7 1 6 5s3 6 7 4 8 1 6 5c-2 5-9 8-14 6-6-2-10-9-8-15 .7-2 1.6-4 3-5z" fill="currentColor" opacity=".45"/>
          <path d="M30 12c3 2 5 5 5 8 0 2-3 2-5 1s-4-3-3-6c.6-1.7 2-2.7 3-3z" fill="currentColor" opacity=".3"/>
        </svg>
      )
    case 'movement':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <circle cx="20" cy="9" r="5" fill="#fff"/>
          <path d="M20 15c-4 1-7 4-8 8l-2 7c-.5 2 1 3.5 3 3.5 1.5 0 2.7-1 3.2-2.5l1.3-4" stroke="#fff" strokeWidth="3.4" strokeLinecap="round"/>
          <path d="M20 20c4 0 7 2 9 5l4 6M17 33l-4 8M28 31l5 9" stroke="#fff" strokeWidth="3.4" strokeLinecap="round"/>
        </svg>
      )
    case 'grace-courtesy':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <circle cx="15" cy="12" r="5" fill="#fff"/>
          <path d="M15 18c-4 2-7 6-7 11v6h13v-6M25 20l8-8M25 12l8 8" stroke="#fff" strokeWidth="3.2" strokeLinecap="round"/>
          <path d="M36 26c2 3 2 7-1 10-2 2-5 3-8 2" stroke="#fff" strokeWidth="3.2" strokeLinecap="round"/>
        </svg>
      )
    case 'self-care':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <rect x="10" y="20" width="20" height="18" rx="4" fill="#fff" opacity=".95"/>
          <path d="M14 20v-4c0-3 3-6 7-6 2 0 4 1 5 2.5M34 14c3 0 5 2 5 5s-2 5-5 5h-4" stroke="#fff" strokeWidth="3.2" strokeLinecap="round"/>
          <path d="M16 28h8" stroke="currentColor" strokeWidth="2.6" strokeLinecap="round" opacity=".5"/>
        </svg>
      )
    case 'art-music':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <path d="M18 36V14l16-4v20" stroke="#fff" strokeWidth="3.2" strokeLinecap="round"/>
          <ellipse cx="14" cy="36" rx="5" ry="4" fill="#fff"/>
          <ellipse cx="30" cy="30" rx="5" ry="4" fill="#fff"/>
          <path d="M14 12c2 4 2 8-1 12" stroke="#fff" strokeWidth="2.4" strokeLinecap="round" opacity=".7"/>
        </svg>
      )
    case 'outdoor':
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <circle cx="33" cy="13" r="6" fill="#fff" opacity=".9"/>
          <path d="M24 12c3 0 6 3 6 6M16 40V26M16 26c-5 0-9-4-9-9 5 0 9 4 9 9zM16 30c0-6 5-11 11-11 0 6-5 11-11 11z" stroke="#fff" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round"/>
          <path d="M9 40h30" stroke="#fff" strokeWidth="3" strokeLinecap="round"/>
        </svg>
      )
    default:
      return (
        <svg viewBox="0 0 48 48" className={cls} fill="none" aria-hidden>
          <circle cx="24" cy="24" r="14" fill="#fff"/>
        </svg>
      )
  }
}

