function AddChildForm({ onAdd }: { onAdd: (nickname: string, birthDate: string) => void }) {
  const [open, setOpen] = useState(false)
  const [nickname, setNickname] = useState('')
  const [birth, setBirth] = useState('')

  if (!open)
    return (
      <button
        onClick={() => setOpen(true)}
        className="mt-3 w-full rounded-full border-2 border-dashed border-sky-300 dark:border-navy-600 text-sky-700 dark:text-sky-300 min-h-[48px] font-medium active:scale-[0.98] transition"
      >
        + Tambah anak
      </button>
    )

  return (
    <form
      className="mt-3 space-y-2"
      onSubmit={(e) => {
        e.preventDefault()
        if (!nickname.trim() || !birth) return
        onAdd(nickname.trim(), birth)
        setNickname(''); setBirth(''); setOpen(false)
      }}
    >
      <input
        value={nickname}
        onChange={(e) => setNickname(e.target.value)}
        placeholder="Nama panggilan"
        aria-label="Nama panggilan anak"
        className="w-full rounded-2xl border border-sky-200 dark:border-navy-700 bg-sky-50/50 dark:bg-navy-700/40 px-4 min-h-[48px]"
        required
      />
      <input
        type="date"
        value={birth}
        onChange={(e) => setBirth(e.target.value)}
        aria-label="Tanggal lahir anak"
        className="w-full rounded-2xl border border-sky-200 dark:border-navy-700 bg-sky-50/50 dark:bg-navy-700/40 px-4 min-h-[48px]"
        required
      />
      <div className="flex gap-2">
        <button type="button" onClick={() => setOpen(false)} className="flex-1 rounded-full border border-sky-200 dark:border-navy-700 min-h-[44px]">
          Batal
        </button>
        <button type="submit" className="flex-1 rounded-full bg-sky-600 text-white font-semibold min-h-[44px]">
          Simpan
        </button>
      </div>
    </form>
  )
}
import { create } from 'zustand'
import { persist } from 'zustand/middleware'
import type { AgeBandId } from '../../content/schema'

export type Child = {
  id: string
  nickname: string
  birthDate: string // ISO date
}

export function ageBandFromBirth(birthDate: string, now = new Date()): AgeBandId {
  const b = new Date(birthDate)
  const months = (now.getFullYear() - b.getFullYear()) * 12 + (now.getMonth() - b.getMonth())
  if (months < 3) return '0-3m'
  if (months < 6) return '3-6m'
  if (months < 9) return '6-9m'
  if (months < 12) return '9-12m'
  if (months < 18) return '12-18m'
  if (months < 24) return '18-24m'
  if (months < 36) return '2-3y'
  if (months < 48) return '3-4y'
  return '4-5y'
}

type ChildStore = {
  children: Child[]
  activeId: string | null
  onboarded: boolean
  addChild: (nickname: string, birthDate: string) => void
  setActive: (id: string) => void
  removeChild: (id: string) => void
}

export const useChildStore = create<ChildStore>()(
  persist(
    (set) => ({
      children: [],
      activeId: null,
      onboarded: false,
      addChild: (nickname, birthDate) => {
        const id = crypto.randomUUID()
        set((s) => ({
          children: [...s.children, { id, nickname, birthDate }],
          activeId: s.activeId ?? id,
          onboarded: true,
        }))
      },
      setActive: (id) => set({ activeId: id }),
      removeChild: (id) =>
        set((s) => {
          const children = s.children.filter((c) => c.id !== id)
          return { children, activeId: children[0]?.id ?? null, onboarded: children.length > 0 }
        }),
    }),
    { name: 'mp-children' },
  ),
)

export function getActiveChild(): Child | null {
  const st = useChildStore.getState()
  return st.children.find((c) => c.id === st.activeId) ?? null
}

export function activeAgeBand(): AgeBandId | null {
  const c = getActiveChild()
  return c ? ageBandFromBirth(c.birthDate) : null
}
