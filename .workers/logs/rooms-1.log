for i, r in enumerate(rooms):
    assert len(r["principles"]) >= 3, i
    assert len(r["items"]) >= 5, i
    assert len(r["layoutTips"]) >= 2, i
    assert len(r["references"]) >= 1, i
    for it in r["items"]:
        for k in ("name","essential","budgetRendah","diy"):
            assert k in it, (i, k)
    valid = {"0-3m","3-6m","6-9m","9-12m","12-18m","18-24m","2-3y","3-4y","4-5y"}
    assert set(r["ageBands"]) <= valid, i

with open("content/parts/rooms-1.json", "w", encoding="utf-8") as f:
    json.dump(rooms, f, ensure_ascii=False, indent=2)
print("written", len(rooms))
