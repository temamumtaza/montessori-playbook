import { useRef, useState } from 'react'
import type { ReactNode } from 'react'
import { useChildStore } from '../stores/children'
import { exportAllData, importAllData } from '../db'
import { AgeBandIcon, IconBell, IconBook, IconChevronDown, IconChevronRight, IconDownload, IconFlag, IconGlobe, IconHeart, IconMoon, IconPlus, IconShield, IconTrash, IconUpload } from '../components/ui-icons'
import { CloudDeco } from '../components/icons'

export function MorePage({ isDark, onToggleDark }: { isDark: boolean; onToggleDark: () => void }) {
  const { children, activeId, setActive, addChild, removeChild } = useChildStore()
  const fileRef = useRef<HTMLInputElement>(null)
  const [reminder, setReminder] = useState(() => localStorage.getItem('mp-reminder') !== 'off')
  const [hour, setHour] = useState(() => localStorage.getItem('mp-reminder-hour') ?? '07')
  const [installOpen, setInstallOpen] = useState(false)
  const [aboutOpen, setAboutOpen] = useState(false)
  const [disclaimerOpen, setDisclaimerOpen] = useState(false)
  const toggleReminder = () => { const next = !reminder; setReminder(next); localStorage.setItem('mp-reminder', next ? 'on' : 'off') }
  const chooseHour = (value: string) => { setHour(value); localStorage.setItem('mp-reminder-hour', value) }
  async function onExport() { const json = await exportAllData(); const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([json], { type: 'application/json' })); a.download = `montessori-playbook-backup-${new Date().toISOString().slice(0, 10)}.json`; a.click() }
  async function onImport(file: File) { try { await importAllData(await file.text()); alert('Data berhasil diimpor.') } catch { alert('File tidak dikenali. Gunakan file hasil ekspor app ini.') } }
  return <div className="px-5 space-y-4">
    <section className="rounded-3xl bg-white dark:bg-navy-800 p-4 shadow-sky-sm"><h2 className="font-[family-name:var(--font-display)] font-bold text-lg">Profil anak</h2>{children.length === 0 ? <p className="text-sm opacity-70 mt-1">Belum ada profil.</p> : <ul className="mt-2 space-y-2">{children.map((child) => <li key={child.id} className="flex gap-2"><button onClick={() => setActive(child.id)} aria-pressed={activeId === child.id} className={`flex-1 flex items-center gap-2 text-left rounded-2xl px-3 min-h-[48px] border ${activeId === child.id ? 'bg-sky-600 text-white border-sky-600' : 'border-sky-200 dark:border-navy-700'}`}><AgeBandIcon band="0-3m" className="w-7 h-7" /><span><strong className="block">{child.nickname}</strong><span className="block text-xs opacity-70">Lahir {child.birthDate}</span></span></button><button onClick={() => { if (confirm(`Hapus profil ${child.nickname}? Data jurnalnya tetap tersimpan.`)) removeChild(child.id) }} aria-label={`Hapus profil ${child.nickname}`} className="rounded-full border border-apple-400 text-apple-600 min-w-[48px] grid place-items-center"><IconTrash className="w-4 h-4" /></button></li>)}</ul>}<AddChildForm onAdd={addChild} /></section>
    <InfoSection title="Persiapan rumah" text="Atur ruangan agar si kecil lebih mudah bergerak dan mandiri." href="#/lingkungan">Lihat planner per ruangan</InfoSection>
    <section><h2 className="font-[family-name:var(--font-display)] font-bold text-lg mb-2">Pengaturan Aplikasi</h2><div className="rounded-3xl bg-white dark:bg-navy-800 shadow-sky-sm overflow-hidden"><Row icon={<IconBell className="w-5 h-5" />} color="bg-apple-100" title="Pengingat Lembut" subtitle="Atur waktu pengingat aktivitas"><Switch checked={reminder} onClick={toggleReminder} label="Aktifkan pengingat" /></Row>{reminder && <div className="px-4 pb-3 flex gap-1.5">{['07', '12', '16', '19'].map((value) => <button key={value} onClick={() => chooseHour(value)} aria-pressed={hour === value} className={`flex-1 rounded-full min-h-[36px] text-xs font-semibold ${hour === value ? 'bg-sky-600 text-white' : 'bg-sky-50 dark:bg-navy-700 text-sky-700 dark:text-sky-200'}`}>{value}:00</button>)}</div>}<Row icon={<IconDownload className="w-5 h-5" />} color="bg-sky-100" title="Ekspor / Impor Data" subtitle="Cadangkan data di perangkat ini"><div className="flex gap-1"><button onClick={onExport} className="rounded-full border border-sky-200 dark:border-navy-600 px-3 min-h-[36px] text-xs font-semibold"><IconDownload className="inline w-3.5 h-3.5" /> Ekspor</button><button onClick={() => fileRef.current?.click()} className="rounded-full border border-sky-200 dark:border-navy-600 px-3 min-h-[36px] text-xs font-semibold"><IconUpload className="inline w-3.5 h-3.5" /> Impor</button><input ref={fileRef} type="file" accept="application/json" className="hidden" onChange={(event) => event.target.files?.[0] && onImport(event.target.files[0])} /></div></Row><Row icon={<IconGlobe className="w-5 h-5" />} color="bg-tosca-100" title="Bahasa Aplikasi" subtitle="Bahasa Indonesia"><span className="rounded-full bg-sky-100 dark:bg-navy-700 px-2 py-1 text-[10px] font-bold opacity-60">ID</span></Row><Row icon={<IconMoon className="w-5 h-5" />} color="bg-grape-100" title="Mode Gelap" subtitle="Sky navy, nyaman untuk sesi malam."><Switch checked={isDark} onClick={onToggleDark} label="Mode gelap" /></Row></div></section>
    <section><h2 className="font-[family-name:var(--font-display)] font-bold text-lg mb-2">Panduan & Dukungan</h2><div className="rounded-3xl bg-white dark:bg-navy-800 shadow-sky-sm overflow-hidden"><LinkRow icon={<IconBook className="w-5 h-5" />} color="bg-sky-100" title="Panduan Montessori Playbook" subtitle="Mulai dari dasar-dasarnya" href="#/belajar" /><LinkRow icon={<IconFlag className="w-5 h-5" />} color="bg-apple-100" title="Red Flag Perkembangan" subtitle="Kenali tanda yang perlu diperhatikan" href="#/belajar?tab=red-flags" /><Expandable open={installOpen} setOpen={setInstallOpen} icon={<IconDownload className="w-5 h-5" />} color="bg-leaf-100" title="Cara Install Aplikasi" subtitle="Tambahkan ke layar utama"><ol className="list-decimal pl-5 space-y-1.5"><li><strong>iOS:</strong> Safari, Bagikan, Tambahkan ke Layar Utama.</li><li><strong>Android:</strong> Chrome, menu, Instal aplikasi.</li><li>Konfirmasi nama aplikasi lalu tekan Tambahkan atau Instal.</li><li>Buka dari ikon baru untuk pengalaman seperti aplikasi.</li></ol></Expandable><Expandable open={aboutOpen} setOpen={setAboutOpen} icon={<IconHeart className="w-5 h-5" />} color="bg-candy-100" title="Tentang Montessori Playbook" subtitle="Versi 1.0.0">Versi 1.0.0, dibuat untuk keluarga Indonesia. <a className="font-semibold text-sky-700 dark:text-sky-300" href="https://github.com/temamumtaza/montessori-playbook" target="_blank" rel="noreferrer">Lihat GitHub repo</a></Expandable><Expandable open={disclaimerOpen} setOpen={setDisclaimerOpen} icon={<IconShield className="w-5 h-5" />} color="bg-sunny-100" title="Disclaimer" subtitle="Panduan edukatif, bukan nasihat medis">Montessori Playbook bukan pengganti nasihat dokter, terapis, atau tenaga kesehatan. Jika ada kekhawatiran tentang tumbuh kembang anak, konsultasikan ke tenaga kesehatan.</Expandable></div></section>
    <p className="text-center text-xs opacity-50 pb-2">Montessori Playbook v1.0.0 · dibuat untuk keluarga Indonesia</p><CloudDeco className="w-16 mx-auto opacity-25" />
  </div>
}

function Switch({ checked, onClick, label }: { checked: boolean; onClick: () => void; label: string }) { return <button role="switch" aria-label={label} aria-checked={checked} onClick={onClick} className={`w-12 h-7 rounded-full relative ${checked ? 'bg-sky-600' : 'bg-sky-200 dark:bg-navy-600'}`}><span className={`absolute top-1 h-5 w-5 rounded-full bg-white shadow ${checked ? 'left-6' : 'left-1'}`} /></button> }
function Row({ icon, color, title, subtitle, children }: { icon: ReactNode; color: string; title: string; subtitle: string; children: ReactNode }) { return <div className="flex items-center gap-3 px-4 min-h-[68px] border-b border-sky-100 dark:border-navy-700"><span className={`w-10 h-10 rounded-full ${color} grid place-items-center`} aria-hidden>{icon}</span><span className="flex-1 min-w-0"><strong className="block text-sm">{title}</strong><span className="block text-xs opacity-65 mt-0.5">{subtitle}</span></span>{children}</div> }
function LinkRow({ icon, color, title, subtitle, href }: { icon: ReactNode; color: string; title: string; subtitle: string; href: string }) { return <a href={href} className="flex items-center gap-3 px-4 min-h-[68px] border-b border-sky-100 dark:border-navy-700"><span className={`w-10 h-10 rounded-full ${color} grid place-items-center`} aria-hidden>{icon}</span><span className="flex-1"><strong className="block text-sm">{title}</strong><span className="block text-xs opacity-65 mt-0.5">{subtitle}</span></span><IconChevronRight className="w-5 h-5 text-sky-600 dark:text-sky-300" /></a> }
function Expandable({ open, setOpen, icon, color, title, subtitle, children }: { open: boolean; setOpen: (value: boolean) => void; icon: ReactNode; color: string; title: string; subtitle: string; children: ReactNode }) { return <><button onClick={() => setOpen(!open)} aria-expanded={open} className="w-full text-left"><div className="flex items-center gap-3 px-4 min-h-[68px] border-b border-sky-100 dark:border-navy-700"><span className={`w-10 h-10 rounded-full ${color} grid place-items-center`} aria-hidden>{icon}</span><span className="flex-1"><strong className="block text-sm">{title}</strong><span className="block text-xs opacity-65 mt-0.5">{subtitle}</span></span>{open ? <IconChevronDown className="w-5 h-5 text-sky-600 dark:text-sky-300" /> : <IconChevronRight className="w-5 h-5 text-sky-600 dark:text-sky-300" />}</div></button>{open && <div className="border-b border-sky-100 dark:border-navy-700 px-4 py-3 text-sm leading-relaxed">{children}</div>}</> }
function InfoSection({ title, text, href, children }: { title: string; text: string; href: string; children: ReactNode }) { return <section className="rounded-3xl bg-white dark:bg-navy-800 p-4 shadow-sky-sm"><h2 className="font-[family-name:var(--font-display)] font-bold text-lg">{title}</h2><p className="text-sm opacity-70 mt-1">{text}</p><a href={href} className="mt-3 flex items-center justify-between rounded-2xl bg-sky-50 dark:bg-navy-700 px-4 min-h-[48px] font-semibold text-sky-700 dark:text-sky-300">{children}<IconChevronRight className="w-5 h-5" /></a></section> }
function AddChildForm({ onAdd }: { onAdd: (nickname: string, birthDate: string, avatar?: string) => void }) { const [open, setOpen] = useState(false); const [nickname, setNickname] = useState(''); const [birth, setBirth] = useState(''); if (!open) return <button onClick={() => setOpen(true)} className="mt-3 w-full rounded-full border-2 border-dashed border-sky-300 dark:border-navy-600 text-sky-700 dark:text-sky-300 min-h-[48px] font-medium"><IconPlus className="inline w-4 h-4 mr-1" />Tambah anak</button>; return <form className="mt-3 space-y-2" onSubmit={(event) => { event.preventDefault(); if (!nickname.trim() || !birth) return; onAdd(nickname.trim(), birth); setOpen(false); setNickname(''); setBirth('') }}><input value={nickname} onChange={(event) => setNickname(event.target.value)} placeholder="Nama panggilan" className="w-full rounded-2xl border border-sky-200 dark:border-navy-700 px-4 min-h-[48px]" required /><input type="date" value={birth} onChange={(event) => setBirth(event.target.value)} className="w-full rounded-2xl border border-sky-200 dark:border-navy-700 px-4 min-h-[48px]" required /><div className="flex gap-2"><button type="button" onClick={() => setOpen(false)} className="flex-1 rounded-full border min-h-[44px]">Batal</button><button type="submit" className="flex-1 rounded-full bg-sky-600 text-white min-h-[44px]">Simpan</button></div></form> }

