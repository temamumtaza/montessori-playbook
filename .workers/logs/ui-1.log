+      setSearching(false)
+      return
+    }
+
+    setSearching(true)
+    const timer = window.setTimeout(() => {
+      searchActivities(q).then((results) => {
+        if (id === requestId.current) {
+          setActivities(results)
+          setSearching(false)
+        }
+      })
+    }, 250)
+
+    return () => window.clearTimeout(timer)
