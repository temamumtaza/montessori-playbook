import { z } from 'zod'

// ===== Enum inti =====
export const AgeBandId = z.enum([
  '0-3m', '3-6m', '6-9m', '9-12m',
  '12-18m', '18-24m', '2-3y', '3-4y', '4-5y',
])
export type AgeBandId = z.infer<typeof AgeBandId>

export const AreaId = z.enum([
  'practical-life', 'sensorial', 'language', 'math', 'culture',
  'movement', 'grace-courtesy', 'self-care', 'art-music', 'outdoor',
])
export type AreaId = z.infer<typeof AreaId>

export const MasteryLevel = z.enum(['belum', 'mulai', 'mahir'])
export type MasteryLevel = z.infer<typeof MasteryLevel>

// ===== Referensi sumber (WAJIB di tiap entri konten) =====
export const Source = z.object({
  title: z.string().min(3),
  url: z.string().url(),
  note: z.string().optional(),
})
export type Source = z.infer<typeof Source>

// ===== Activity (entitas inti) =====
export const Activity = z.object({
  id: z.string().regex(/^[a-z0-9-]+$/, 'id: kebab-case'),
  title: z.string().min(5),
  summary: z.string().min(20, 'ringkasan minimal 20 karakter'),
  ageBands: z.array(AgeBandId).min(1),
  areas: z.array(AreaId).min(1),
  skills: z.array(z.string()).default([]),
  objectives: z.array(z.string()).min(1, 'minimal 1 tujuan'),
  materials: z.array(z.object({
    name: z.string().min(2),
    fromHome: z.boolean().default(true),
    optional: z.boolean().default(false),
  })).min(1),
  prepMinutes: z.number().int().min(0).max(120),
  durationMinutes: z.number().int().min(1).max(180),
  prepLevel: z.enum(['rendah', 'sedang', 'tinggi']),
  presentation: z.array(z.object({
    step: z.number().int().min(1),
    text: z.string().min(10),
  })).min(2, 'minimal 2 langkah presentasi'),
  controlOfError: z.string().min(10).optional(),
  variations: z.array(z.string()).default([]),
  readySigns: z.array(z.string()).min(1, 'minimal 1 tanda siap'),
  struggleSigns: z.array(z.string()).default([]),
  safetyNotes: z.array(z.string()).default([]),
  references: z.array(Source).min(1, 'WAJIB minimal 1 rujukan'),
  diyGuideId: z.string().optional(),
  materialIds: z.array(z.string()).default([]),
})
export type Activity = z.infer<typeof Activity>

// ===== Material =====
export const Material = z.object({
  id: z.string().regex(/^[a-z0-9-]+$/),
  name: z.string().min(3),
  purpose: z.string().min(20),
  ageBands: z.array(AgeBandId).min(1),
  budget: z.enum(['rendah', 'sedang', 'tinggi']),
  buyHint: z.string().optional(),
  diy: z.boolean().default(false),
  safetyNotes: z.array(z.string()).default([]),
  references: z.array(Source).min(1),
})
export type Material = z.infer<typeof Material>

// ===== DIYGuide =====
export const DIYGuide = z.object({
  id: z.string().regex(/^[a-z0-9-]+$/),
  title: z.string().min(5),
  makes: z.string().min(3),
  timeMinutes: z.number().int().min(5).max(600),
  cost: z.enum(['gratis', 'rendah', 'sedang']),
  materialsNeeded: z.array(z.string()).min(1),
  steps: z.array(z.string()).min(2),
  ageBands: z.array(AgeBandId).min(1),
  safetyNotes: z.array(z.string()).default([]),
  references: z.array(Source).min(1),
})
export type DIYGuide = z.infer<typeof DIYGuide>

// ===== RoomSetup =====
export const RoomSetup = z.object({
  id: z.string().regex(/^[a-z0-9-]+$/),
  room: z.enum(['kamar-anak', 'kamar-mandi', 'dapur', 'ruang-keluarga', 'area-makan', 'outdoor']),
  title: z.string().min(5),
  principles: z.array(z.string()).min(2),
  items: z.array(z.object({
    name: z.string().min(2),
    essential: z.boolean().default(true),
    budgetRendah: z.string(),
    budgetSedang: z.string().optional(),
    diy: z.boolean().default(false),
  })).min(3),
  layoutTips: z.array(z.string()).min(1),
  ageBands: z.array(AgeBandId).min(1),
  references: z.array(Source).min(1),
})
export type RoomSetup = z.infer<typeof RoomSetup>

// ===== Milestone =====
export const Milestone = z.object({
  id: z.string().regex(/^[a-z0-9-]+$/),
  title: z.string().min(5),
  ageBand: AgeBandId,
  domain: z.enum(['motorik-kasar', 'motorik-halus', 'bahasa', 'kognitif', 'sosial-emosional', 'self-help']),
  description: z.string().min(20),
  typicalFromMonths: z.number().min(0).max(72),
  typicalToMonths: z.number().min(0).max(72),
  redFlags: z.array(z.string()).default([]),
  references: z.array(Source).min(1),
})
export type Milestone = z.infer<typeof Milestone>

// ===== ParentGuide =====
export const ParentGuide = z.object({
  id: z.string().regex(/^[a-z0-9-]+$/),
  title: z.string().min(5),
  category: z.enum(['filosofi', 'komunikasi', 'disiplin', 'rutinitas', 'screen-time', 'sibling', 'toilet', 'tantrum', 'observasi', 'self-care']),
  ageBands: z.array(AgeBandId).default([]),
  body: z.string().min(200, 'panduan minimal 200 karakter'),
  keyTakeaways: z.array(z.string()).min(2),
  references: z.array(Source).min(1),
})
export type ParentGuide = z.infer<typeof ParentGuide>

// ===== Glossary =====
export const GlossaryEntry = z.object({
  term: z.string().min(2),
  termEn: z.string().optional(),
  definition: z.string().min(30),
  relatedTerms: z.array(z.string()).default([]),
})
export type GlossaryEntry = z.infer<typeof GlossaryEntry>

// ===== Checklist =====
export const Checklist = z.object({
  id: z.string().regex(/^[a-z0-9-]+$/),
  title: z.string().min(5),
  kind: z.enum(['environment', 'rutinitas', 'persiapan-aktivitas', 'keselamatan']),
  scope: z.string(),
  items: z.array(z.object({
    text: z.string().min(5),
    hint: z.string().optional(),
  })).min(3),
  references: z.array(Source).min(1),
})
export type Checklist = z.infer<typeof Checklist>

// ===== Skill =====
export const Skill = z.object({
  id: z.string().regex(/^[a-z0-9-]+$/),
  name: z.string().min(3),
  area: AreaId,
  description: z.string().min(20),
  ageBands: z.array(AgeBandId).min(1),
})
export type Skill = z.infer<typeof Skill>

// ===== AgeBand metadata (warna & label) =====
export const AgeBandMeta = z.object({
  id: AgeBandId,
  label: z.string().min(3),
  rangeMonths: z.tuple([z.number(), z.number()]),
  color: z.enum(['sky', 'apple', 'mango', 'sunny', 'leaf', 'grape', 'candy', 'tosca']),
  mascot: z.string().min(1),
})
export type AgeBandMeta = z.infer<typeof AgeBandMeta>

// ===== Area metadata =====
export const AreaMeta = z.object({
  id: AreaId,
  label: z.string().min(3),
  labelEn: z.string(),
  color: z.enum(['sky', 'apple', 'mango', 'sunny', 'leaf', 'grape', 'candy', 'tosca']),
  icon: z.string().min(1),
  description: z.string().min(30),
})
export type AreaMeta = z.infer<typeof AreaMeta>

// ===== Bundle per AgeBand (lazy-load unit) =====
export const AgeBandBundle = z.object({
  ageBand: AgeBandId,
  activities: z.array(Activity),
  milestones: z.array(Milestone).default([]),
})
export type AgeBandBundle = z.infer<typeof AgeBandBundle>

// ===== File bundle global =====
export const GlobalBundle = z.object({
  ageBands: z.array(AgeBandMeta),
  areas: z.array(AreaMeta),
  skills: z.array(Skill).default([]),
  materials: z.array(Material),
  diyGuides: z.array(DIYGuide),
  roomSetups: z.array(RoomSetup),
  parentGuides: z.array(ParentGuide),
  glossary: z.array(GlossaryEntry),
  checklists: z.array(Checklist),
})
export type GlobalBundle = z.infer<typeof GlobalBundle>
import { create } from 'zustand'
import { persist } from 'zustand/middleware'
import type { AgeBandId } from '../../content/schema'

export type Child = {
  id: string
  nickname: string
  birthDate: string // ISO date
}

export function ageBandFromBirth(birthDate: string, now = new Date()): AgeBandId {
  const b = new Date(birthDate)
  const months = (now.getFullYear() - b.getFullYear()) * 12 + (now.getMonth() - b.getMonth())
  if (months < 3) return '0-3m'
  if (months < 6) return '3-6m'
  if (months < 9) return '6-9m'
  if (months < 12) return '9-12m'
  if (months < 18) return '12-18m'
  if (months < 24) return '18-24m'
  if (months < 36) return '2-3y'
  if (months < 48) return '3-4y'
  return '4-5y'
}

type ChildStore = {
  children: Child[]
  activeId: string | null
  onboarded: boolean
  addChild: (nickname: string, birthDate: string) => void
  setActive: (id: string) => void
  removeChild: (id: string) => void
}

export const useChildStore = create<ChildStore>()(
  persist(
    (set) => ({
      children: [],
      activeId: null,
      onboarded: false,
      addChild: (nickname, birthDate) => {
        const id = crypto.randomUUID()
        set((s) => ({
          children: [...s.children, { id, nickname, birthDate }],
          activeId: s.activeId ?? id,
          onboarded: true,
        }))
      },
      setActive: (id) => set({ activeId: id }),
      removeChild: (id) =>
        set((s) => {
          const children = s.children.filter((c) => c.id !== id)
          return { children, activeId: children[0]?.id ?? null, onboarded: children.length > 0 }
        }),
    }),
    { name: 'mp-children' },
  ),
)

export function getActiveChild(): Child | null {
  const st = useChildStore.getState()
  return st.children.find((c) => c.id === st.activeId) ?? null
}

export function activeAgeBand(): AgeBandId | null {
  const c = getActiveChild()
  return c ? ageBandFromBirth(c.birthDate) : null
}
import { useLiveQuery } from 'dexie-react-hooks'
import { db } from '../db'
import { useChildStore } from '../stores/children'
import { loadBundle } from '../../content/store'
import { useEffect, useState } from 'react'
import type { Milestone } from '../../content/schema'
import { EmptyState } from './TodayPage'

export function ProgressPage() {
  const activeId = useChildStore((s) => s.activeId)
  const [milestones, setMilestones] = useState<Milestone[] | null>(null)

  useEffect(() => {
    const st = useChildStore.getState()
    const c = st.children.find((x) => x.id === st.activeId)
    if (!c) return
    import('../stores/children').then(({ ageBandFromBirth }) => {
      loadBundle(ageBandFromBirth(c.birthDate)).then((b) => setMilestones(b.milestones))
    })
  }, [activeId])

  const mastery = useLiveQuery(
    async () => {
      if (!activeId) return []
      return db.mastery.where('childId').equals(activeId).toArray()
    },
    [activeId],
  )

  const doneCount = mastery?.filter((m) => m.level !== 'belum').length ?? 0

  if (!milestones) return <p className="px-5 text-sm opacity-60">Memuat…</p>

  return (
    <div className="px-5 space-y-4">
      <section className="rounded-blob bg-gradient-to-br from-leaf-100 to-cream-100 dark:from-navy-800 dark:to-navy-700 p-5">
        <h2 className="font-[family-name:var(--font-display)] text-xl font-bold">Perkembangan 🌱</h2>
        <p className="text-sm opacity-75 mt-1">
          {doneCount} tanda dicatat. Setiap anak punya tempo sendiri — ini peta, bukan lomba.
        </p>
      </section>

      {milestones.length === 0 ? (
        <EmptyState title="Milestone usia ini belum tersedia" text="Konten progres sedang dibangun bertahap." />
      ) : (
        <ul className="space-y-3">
          {milestones.map((m) => {
            const rec = mastery?.find((x) => x.targetId === m.id)
            return (
              <li key={m.id} className="rounded-blob bg-white dark:bg-navy-800 p-4 shadow-sm">
                <div className="flex justify-between gap-2">
                  <div>
                    <h3 className="font-semibold text-sm">{m.title}</h3>
                    <p className="text-xs opacity-65 mt-1">{m.description}</p>
                  </div>
                  <Segmented
                    value={rec?.level ?? 'belum'}
                    onChange={async (lv) => {
                      if (!activeId) return
                      await db.mastery.put({ childId: activeId, targetId: m.id, kind: 'milestone', level: lv, updatedAt: Date.now() })
                    }}
                  />
                </div>
              </li>
            )
          })}
        </ul>
      )}
    </div>
  )
}

function Segmented({ value, onChange }: { value: 'belum' | 'mulai' | 'mahir'; onChange: (v: 'belum' | 'mulai' | 'mahir') => void }) {
  const opts = ['belum', 'mulai', 'mahir'] as const
  return (
    <div role="radiogroup" aria-label="Status" className="flex flex-col gap-1 shrink-0">
      {opts.map((o) => (
        <button
          key={o}
          role="radio"
          aria-checked={value === o}
          onClick={() => onChange(o)}
          className={`text-[11px] rounded-full px-2.5 min-h-[28px] border transition ${
            value === o ? 'bg-leaf-600 text-white border-leaf-600' : 'border-sky-200 dark:border-navy-700 opacity-70'
          }`}
        >
          {o}
        </button>
      ))}
    </div>
  )
}

