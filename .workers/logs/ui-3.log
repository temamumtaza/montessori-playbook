type TabScroll = Record<string, number>
const ScrollCtx = createContext<{ save: (tab: string, y: number) => void; get: (tab: string) => number }>({
  save: () => {},
  get: () => 0,
})
export const useTabScroll = () => useContext(ScrollCtx)

const TABS = [
  { to: '/', label: 'Hari Ini', icon: '☀️' },
  { to: '/playbook', label: 'Playbook', icon: '📖' },
  { to: '/jurnal', label: 'Jurnal', icon: '📝' },
  { to: '/progres', label: 'Progres', icon: '🌱' },
  { to: '/lainnya', label: 'Lainnya', icon: '⋯' },
]

export default function App() {
  const location = useLocation()
  const [scrollMem, setScrollMem] = useState<TabScroll>({})
  const [isDark, setIsDark] = useState(
    () => localStorage.getItem('mp-theme') === 'dark' ||
      (localStorage.getItem('mp-theme') === null && window.matchMedia('(prefers-color-scheme: dark)').matches),
  )
  const activeChild = useChildStore((s) => s.children[0])

  useEffect(() => {
    document.documentElement.classList.toggle('dark', isDark)
    localStorage.setItem('mp-theme', isDark ? 'dark' : 'light')
  }, [isDark])

  // Simpan scroll per tab & restore saat kembali
  useEffect(() => {
    const tab = TABS.find((t) => t.to === location.pathname)?.to ?? location.pathname
    const saved = scrollMem[tab]
    if (saved !== undefined) requestAnimationFrame(() => window.scrollTo(0, saved))
    const onScroll = () => {
      setScrollMem((m) => (m[tab] === window.scrollY ? m : { ...m, [tab]: window.scrollY }))
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    return () => window.removeEventListener('scroll', onScroll)
  }, [location.pathname])

  return (
    <ScrollCtx.Provider value={{ save: () => {}, get: (t) => scrollMem[t] ?? 0 }}>
      <div className="min-h-dvh bg-sky-50 dark:bg-navy-900 text-sky-900 dark:text-sky-100 transition-colors">
        {/* Header collapsing large title */}
        <Header title={titleFor(location.pathname)} />

        <main className="px-safe pb-28 pt-2">
          <AnimatePresence mode="wait" initial={false}>
            <motion.div
              key={location.pathname}
              initial={{ opacity: 0, x: 24 }}
              animate={{ opacity: 1, x: 0 }}
              exit={{ opacity: 0, x: -24 }}
              transition={{ duration: 0.22, ease: [0.32, 0.72, 0, 1] }}
            >
              <Routes location={location}>
                <Route path="/" element={<TodayPage />} />
                <Route path="/playbook" element={<PlaybookPage />} />
                <Route path="/aktivitas/:id" element={<ActivityDetailPage />} />
                <Route path="/cari" element={<SearchGlossaryPage />} />
                <Route path="/jurnal" element={<JournalPage />} />
                <Route path="/progres" element={<ProgressPage />} />
                <Route path="/lainnya" element={<MorePage isDark={isDark} onToggleDark={() => setIsDark((d) => !d)} />} />
                <Route path="/lingkungan" element={<EnvironmentPage />} />
              </Routes>
            </motion.div>
          </AnimatePresence>
        </main>

        <TabBar tabs={TABS} />
        <UpdateToast swUpdate={swUpdate} />
        {/* a11y: nama anak di judul dinamis */}
        <span className="sr-only" aria-live="polite">{activeChild ? `Profil aktif: ${activeChild.nickname}` : ''}</span>
      </div>
    </ScrollCtx.Provider>
  )
}

function titleFor(path: string): string {
  if (path === '/') return 'Hari Ini'
  if (path.startsWith('/cari')) return 'Cari'
  if (path.startsWith('/playbook')) return 'Playbook'
  if (path.startsWith('/jurnal')) return 'Jurnal'
  if (path.startsWith('/progres')) return 'Progres'
  if (path.startsWith('/lingkungan')) return 'Persiapan rumah'
  return 'Lainnya'
}

function Header({ title }: { title: string }) {
  const [compact, setCompact] = useState(false)
  useEffect(() => {
    const onScroll = () => setCompact(window.scrollY > 36)
    window.addEventListener('scroll', onScroll, { passive: true })
    return () => window.removeEventListener('scroll', onScroll)
  }, [])
  return (
    <header className="sticky top-0 z-40 bg-sky-50/85 dark:bg-navy-900/85 backdrop-blur-md pt-safe">
      <div className="px-5 pb-2 transition-all" style={{ height: compact ? 48 : 84 }}>
        <h1
          className={`font-[family-name:var(--font-display)] font-bold text-sky-700 dark:text-sky-300 transition-all ${compact ? 'text-xl leading-[48px]' : 'text-3xl leading-[84px]'}`}
        >
          {title}
        </h1>
      </div>
    </header>
  )
}

function TabBar({ tabs }: { tabs: typeof TABS }) {
  return (
    <nav
      aria-label="Navigasi utama"
      className="fixed bottom-0 inset-x-0 z-50 bg-white/90 dark:bg-navy-800/90 backdrop-blur-md border-t border-sky-100 dark:border-navy-700 pb-safe"
    >
      <div className="grid grid-cols-5 px-safe">
        {tabs.map((t) => (
          <NavLink
            key={t.to}
            to={t.to}
            end={t.to === '/'}
            className={({ isActive }) =>
              `flex flex-col items-center gap-0.5 py-2 min-h-[48px] justify-center text-[11px] font-medium transition-colors ${
                isActive ? 'text-sky-600 dark:text-sky-400' : 'text-sky-900/45 dark:text-sky-100/45'
              }`
            }
          >
            {({ isActive }) => (
              <>
                <span aria-hidden className="text-xl leading-none">{t.icon}</span>
                <span>{t.label}</span>
                {isActive && (
                  <motion.span layoutId="tabdot" className="absolute top-0 h-0.5 w-8 rounded-full bg-sky-500" />
                )}
              </>
            )}
          </NavLink>
        ))}
      </div>
    </nav>
  )
}
import { useRef, useState } from 'react'
import { useChildStore } from '../stores/children'
import { exportAllData, importAllData } from '../db'

export function MorePage({ isDark, onToggleDark }: { isDark: boolean; onToggleDark: () => void }) {
  const { children, activeId, setActive, addChild, removeChild } = useChildStore()
  const fileRef = useRef<HTMLInputElement>(null)

  async function onExport() {
    const json = await exportAllData()
    const blob = new Blob([json], { type: 'application/json' })
    const a = document.createElement('a')
    a.href = URL.createObjectURL(blob)
    a.download = `montessori-playbook-backup-${new Date().toISOString().slice(0, 10)}.json`
    a.click()
    URL.revokeObjectURL(a.href)
  }

  async function onImportFile(f: File) {
    const text = await f.text()
    try {
      await importAllData(text)
      alert('Data berhasil diimpor.')
    } catch {
      alert('File tidak dikenali. Gunakan file hasil ekspor app ini.')
    }
  }

  return (
    <div className="px-5 space-y-4">
      {/* Profil anak */}
      <section className="rounded-blob bg-white dark:bg-navy-800 p-4 shadow-sm">
        <h2 className="font-[family-name:var(--font-display)] font-bold text-lg">Profil anak</h2>
        {children.length === 0 ? (
          <p className="text-sm opacity-70 mt-1">Belum ada profil.</p>
        ) : (
          <ul className="mt-2 space-y-2">
            {children.map((c) => (
              <li key={c.id} className="flex items-center gap-2">
                <button
                  onClick={() => setActive(c.id)}
                  aria-pressed={activeId === c.id}
                  className={`flex-1 text-left rounded-2xl px-4 min-h-[48px] border transition ${
                    activeId === c.id ? 'bg-sky-600 text-white border-sky-600' : 'border-sky-200 dark:border-navy-700'
                  }`}
                >
                  <span className="font-semibold">{c.nickname}</span>
                  <span className="block text-xs opacity-70">Lahir {c.birthDate}</span>
                </button>
                <button
                  onClick={() => { if (confirm(`Hapus profil ${c.nickname}? Data jurnalnya tetap tersimpan.`)) removeChild(c.id) }}
                  aria-label={`Hapus profil ${c.nickname}`}
                  className="rounded-full border border-apple-400 text-apple-600 min-w-[48px] min-h-[48px]"
                >
                  ✕
                </button>
              </li>
            ))}
          </ul>
        )}
        <AddChildForm onAdd={addChild} />
      </section>

      {/* Tampilan */}
      <section className="rounded-blob bg-white dark:bg-navy-800 p-4 shadow-sm">
        <h2 className="font-[family-name:var(--font-display)] font-bold text-lg">Persiapan rumah</h2>
        <p className="text-sm opacity-70 mt-1">Atur ruangan agar si kecil lebih mudah bergerak dan mandiri.</p>
        <a href="#/lingkungan" className="mt-3 flex items-center justify-between rounded-2xl bg-sky-50 dark:bg-navy-700 px-4 min-h-[48px] font-semibold text-sky-700 dark:text-sky-300">
          Lihat planner per ruangan <span aria-hidden>→</span>
        </a>
      </section>

      {/* Tampilan */}
      <section className="rounded-blob bg-white dark:bg-navy-800 p-4 shadow-sm flex items-center justify-between">
        <div>
          <h2 className="font-semibold">Mode gelap</h2>
          <p className="text-xs opacity-65">Sky navy, nyaman untuk sesi malam.</p>
        </div>
        <button
          role="switch"
          aria-checked={isDark}
          onClick={onToggleDark}
          className={`w-14 h-8 rounded-full transition relative ${isDark ? 'bg-sky-600' : 'bg-sky-200'}`}
        >
          <span className={`absolute top-1 h-6 w-6 rounded-full bg-white shadow transition-all ${isDark ? 'left-7' : 'left-1'}`} />
        </button>
      </section>

      {/* Data */}
      <section className="rounded-blob bg-white dark:bg-navy-800 p-4 shadow-sm space-y-2">
        <h2 className="font-semibold">Data kamu</h2>
        <p className="text-xs opacity-65">Semua data tersimpan di perangkat ini saja. Tidak ada server, tidak ada tracking.</p>
        <div className="flex gap-2 pt-1">
          <button onClick={onExport} className="flex-1 rounded-full border border-sky-300 dark:border-navy-600 min-h-[44px] font-medium active:scale-[0.98] transition">
            Ekspor JSON
          </button>
          <button onClick={() => fileRef.current?.click()} className="flex-1 rounded-full border border-sky-300 dark:border-navy-600 min-h-[44px] font-medium active:scale-[0.98] transition">
            Impor JSON
          </button>
          <input
            ref={fileRef}
            type="file"
            accept="application/json"
            className="hidden"
            onChange={(e) => e.target.files?.[0] && onImportFile(e.target.files[0])}
          />
        </div>
      </section>

      {/* Disclaimer */}
      <section className="rounded-blob bg-sunny-100 dark:bg-navy-800 p-4 text-sm">
        <h2 className="font-bold">⚠️ Disclaimer</h2>
        <p className="mt-1 opacity-80">
          Montessori Playbook adalah panduan edukatif untuk orang tua, bukan pengganti nasihat dokter, terapis,
          atau tenaga kesehatan. Setiap anak berkembang dengan temponya sendiri. Jika ada kekhawatiran tentang
          tumbuh kembang anak, konsultasikan ke dokter atau ahli terapi. Dalam keadaan darurat, hubungi layanan
          gawat darurat setempat.
        </p>
      </section>

      <p className="text-center text-xs opacity-50 pb-2">Montessori Playbook v0.1 · dibuat dengan ☁️ untuk orang tua Indonesia</p>
    </div>
  )
}

function AddChildForm({ onAdd }: { onAdd: (nickname: string, birthDate: string) => void }) {
  const [open, setOpen] = useState(false)
  const [nickname, setNickname] = useState('')
  const [birth, setBirth] = useState('')

  if (!open)
    return (
      <button
        onClick={() => setOpen(true)}
        className="mt-3 w-full rounded-full border-2 border-dashed border-sky-300 dark:border-navy-600 text-sky-700 dark:text-sky-300 min-h-[48px] font-medium active:scale-[0.98] transition"
      >
        + Tambah anak
      </button>
    )

  return (
    <form
      className="mt-3 space-y-2"
      onSubmit={(e) => {
        e.preventDefault()
        if (!nickname.trim() || !birth) return
        onAdd(nickname.trim(), birth)
        setNickname(''); setBirth(''); setOpen(false)
      }}
    >
      <input
        value={nickname}
        onChange={(e) => setNickname(e.target.value)}
        placeholder="Nama panggilan"
        aria-label="Nama panggilan anak"
        className="w-full rounded-2xl border border-sky-200 dark:border-navy-700 bg-sky-50/50 dark:bg-navy-700/40 px-4 min-h-[48px]"
        required
      />
      <input
        type="date"
        value={birth}
        onChange={(e) => setBirth(e.target.value)}
        aria-label="Tanggal lahir anak"
        className="w-full rounded-2xl border border-sky-200 dark:border-navy-700 bg-sky-50/50 dark:bg-navy-700/40 px-4 min-h-[48px]"
        required
      />
      <div className="flex gap-2">
        <button type="button" onClick={() => setOpen(false)} className="flex-1 rounded-full border border-sky-200 dark:border-navy-700 min-h-[44px]">
          Batal
        </button>
        <button type="submit" className="flex-1 rounded-full bg-sky-600 text-white font-semibold min-h-[44px]">
          Simpan
        </button>
      </div>
    </form>
  )
}
import Dexie, { type Table } from 'dexie'

export type JournalEntry = {
  id?: number
  childId: string
  createdAt: number
  note: string
  photoBlob?: Blob
  activityId?: string
  skillTags: string[]
  mood?: 'senang' | 'fokus' | 'frustrasi' | 'tenang'
}

export type MasteryRecord = {
  childId: string
  targetId: string // activity/skill/milestone id
  kind: 'activity' | 'skill' | 'milestone'
  level: 'belum' | 'mulai' | 'mahir'
  updatedAt: number
}

export type Bookmark = {
  childId: string
  targetId: string
  createdAt: number
}

export type ChecklistState = {
  childId: string
  checklistId: string
  itemId: number
  done: boolean
}

export type Profile = {
  key: string // 'onboarding-v1'
  reminders: boolean
  reminderHour: number
  exportedAt?: string
}

class PlaybookDB extends Dexie {
  journal!: Table<JournalEntry, number>
  mastery!: Table<MasteryRecord, [string, string]>
  bookmarks!: Table<Bookmark, [string, string]>
  checklists!: Table<ChecklistState, [string, string, number]>
  profiles!: Table<Profile, string>

  constructor() {
    super('montessori-playbook')
    this.version(1).stores({
      journal: '++id, childId, createdAt, activityId',
      mastery: '[childId+targetId], childId, level',
      bookmarks: '[childId+targetId], childId',
      checklists: '[childId+checklistId+itemId], childId',
      profiles: 'key',
    })
  }
}

export const db = new PlaybookDB()

export async function exportAllData(): Promise<string> {
  const [journal, mastery, bookmarks, checklists] = await Promise.all([
    db.journal.toArray(),
    db.mastery.toArray(),
    db.bookmarks.toArray(),
    db.checklists.toArray(),
  ])
  // foto blob -> base64
  const journalSer = await Promise.all(
    journal.map(async (j) => ({
      ...j,
      photoBlob: j.photoBlob ? await blobToBase64(j.photoBlob) : undefined,
    })),
  )
  return JSON.stringify({ v: 1, exportedAt: new Date().toISOString(), journal: journalSer, mastery, bookmarks, checklists }, null, 2)
}

export async function importAllData(json: string): Promise<void> {
  const data = JSON.parse(json)
  if (data.v !== 1) throw new Error('Format file tidak dikenal')
  await db.transaction('rw', db.journal, db.mastery, db.bookmarks, db.checklists, async () => {
    for (const j of data.journal ?? []) {
      const { photoBlob, ...rest } = j
      await db.journal.add({ ...rest, photoBlob: photoBlob ? await base64ToBlob(photoBlob) : undefined })
    }
    if (data.mastery) await db.mastery.bulkPut(data.mastery)
    if (data.bookmarks) await db.bookmarks.bulkPut(data.bookmarks)
    if (data.checklists) await db.checklists.bulkPut(data.checklists)
  })
}

function blobToBase64(blob: Blob): Promise<string> {
  return new Promise((res) => {
    const r = new FileReader()
    r.onload = () => res(String(r.result))
    r.readAsDataURL(blob)
  })
}

function base64ToBlob(dataUrl: string): Promise<Blob> {
  return fetch(dataUrl).then((r) => r.blob())
}
